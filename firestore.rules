rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper: check if user is admin
    function isAdmin() {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Helper: check if user is staff (admin or receptionist)
    function isStaff() {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'receptionist'];
    }

    // Helper: validate string field
    function isValidString(field, maxLen) {
      return field is string && field.size() > 0 && field.size() <= maxLen;
    }

    // Helper: validate member data on create/update
    function isValidMemberData() {
      let data = request.resource.data;
      return data.keys().hasAll(['name', 'phone', 'plan']) &&
             isValidString(data.name, 100) &&
             isValidString(data.phone, 15) &&
             isValidString(data.plan, 50) &&
             (!('email' in data) || data.email is string) &&
             (!('amount' in data) || data.amount is string);
    }

    // Users collection — admin can read/write all, users can read their own
    // SECURITY: Users CANNOT write their own role (prevents privilege escalation)
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      
      // Only admins can write to user documents
      // This prevents users from changing their own role
      allow write: if isAdmin();
      
      // Users can update their own document, but ONLY non-role fields
      allow update: if isAuthenticated() && 
                       request.auth.uid == userId &&
                       !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']);
    }

    // Members — all staff can read, only admin can delete
    // Data validation on create/update
    match /members/{memberId} {
      allow read: if isStaff();
      allow create: if isStaff() && isValidMemberData();
      allow update: if isStaff() && isValidMemberData();
      allow delete: if isAdmin();
    }

    // Attendance — staff can read, create with validation, limited update for checkout
    match /attendance/{attendanceId} {
      allow read: if isStaff();
      allow create: if isStaff()
        && request.resource.data.keys().hasAll(['personId', 'personType', 'name', 'date', 'checkInTime'])
        && request.resource.data.personType in ['member', 'staff', 'trainer'];
      allow update: if isStaff()
        && request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['checkOutTime', 'checkOutTimestamp', 'duration']);
      allow delete: if isAdmin();
    }

    // Staff — all staff can read, only admin can write
    match /staff/{staffId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // Trainers — all staff can read, only admin can create/update/delete
    match /trainers/{trainerId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // Reviews — staff can read/create/update, only admin can delete
    match /reviews/{reviewId} {
      allow read: if isStaff();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    // Offers — all staff can read, only admin can write
    match /offers/{offerId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // Measurements — staff can read/create/update, only admin can delete
    match /measurements/{measurementId} {
      allow read: if isStaff();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    // Settings — all staff can read, only admin can write
    match /settings/{settingId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // Removed Members — all staff can read, only admin can write
    match /removed_members/{removedId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // Staff Attendance — staff can read, only admin can create/update/delete
    match /staff_attendance/{recordId} {
      allow read: if isStaff();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Payslips — admin only for all operations, never deletable
    match /payslips/{payslipId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // Biometric Devices — staff can read, admin can manage
    match /biometric_devices/{deviceId} {
      allow read: if isStaff();
      allow create, update, delete: if isAdmin();
    }

    // Daily Init Tracker — staff can read, admin can create, immutable
    match /daily_init/{date} {
      allow read: if isStaff();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // Security Audit Logs — authenticated users can write (for logging),
    // only admins can read (for audit trail)
    match /security_logs/{logId} {
      allow create: if isAuthenticated();
      allow read: if isAdmin();
      allow update, delete: if false; // Logs are immutable
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
