        replacement_content: "               </div>\n             </div>\n           )}\n\n           {activeSettingsTab === \'users\' && (\n             <div className=\"space-y-6\">\n               <div className=\"flex justify-between items-center mb-4\">\n                 <h3 className=\"text-lg font-bold text-white\">Staff Login Accounts</h3>\n                 <button className=\"bg-primary hover:bg-primary/90 text-[#0D0D0D] px-3 py-1.5 rounded text-sm font-bold flex items-center gap-1\">+ Create Account</button>\n               </div>\n               \n               <div className=\"p-4 bg-[#0D0D0D] border border-border-color rounded-lg text-text-secondary text-sm\">\n                 <p className=\"mb-2 text-white font-medium\">To create a new staff account:</p>\n                 <ul className=\"list-disc pl-5 space-y-1 mb-4\">\n                   <li>Accounts must be created by Admin via Cloud Functions (Admin SDK).</li>\n                   <li>Firebase Auth user will be created securely.</li>\n                   <li>A corresponding document in <code className=\"text-primary px-1 bg-primary/10 rounded\">users</code> collection will store their role.</li>\n                 </ul>\n                 <form className=\"max-w-md space-y-4 border border-border-color p-4 rounded-md\">\n                   <div className=\"space-y-1\">\n                     <label className=\"text-xs uppercase font-semibold\">Name</label>\n                     <input type=\"text\" className=\"w-full bg-surface border border-border-color rounded px-3 py-2 text-white\" placeholder=\"Staff Name\" />\n                   </div>\n                   <div className=\"space-y-1\">\n                     <label className=\"text-xs uppercase font-semibold\">Email</label>\n                     <input type=\"email\" className=\"w-full bg-surface border border-border-color rounded px-3 py-2 text-white\" placeholder=\"staff@corenix.com\" />\n                   </div>\n                   <div className=\"space-y-1\">\n                     <label className=\"text-xs uppercase font-semibold\">Temporary Password</label>\n                     <input type=\"password\" className=\"w-full bg-surface border border-border-color rounded px-3 py-2 text-white\" placeholder=\"Password\" />\n                   </div>\n                   <div className=\"space-y-1\">\n                     <label className=\"text-xs uppercase font-semibold\">Role</label>\n                     <select className=\"w-full bg-surface border border-border-color rounded px-3 py-2 text-white\">\n                        <option value=\"receptionist\">Receptionist</option>\n                        <option value=\"trainer\">Trainer</option>\n                        <option value=\"admin\">Admin</option>\n                     </select>\n                   </div>\n                   <button type=\"button\" className=\"bg-white hover:bg-gray-200 text-black font-bold px-4 py-2 rounded text-sm w-full transition-colors\">Create Account (Placeholder)</button>\n                 </form>\n               </div>\n\n               {/* Mock table for staff list */}\n               <div className=\"overflow-x-auto border border-border-color rounded-lg mt-6\">\n                 <table className=\"w-full text-left text-sm whitespace-nowrap\">\n                   <thead className=\"bg-[#0D0D0D] text-text-secondary text-[11px] uppercase tracking-wider\">\n                     <tr>\n                       <th className=\"px-4 py-3 font-medium\">Name</th>\n                       <th className=\"px-4 py-3 font-medium\">Email</th>\n                       <th className=\"px-4 py-3 font-medium\">Role</th>\n                       <th className=\"px-4 py-3 font-medium text-right\">Actions</th>\n                     </tr>\n                   </thead>\n                   <tbody className=\"divide-y divide-border-color bg-surface\">\n                     <tr>\n                        <td className=\"px-4 py-3 font-medium text-white\"