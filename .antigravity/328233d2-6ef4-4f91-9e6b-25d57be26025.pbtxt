    }
    replacement_chunks {
      target_content: "export default function CorenixApp() {\n  const [activeTab, setActiveTab] = useState(\'Dashboard\');\n  const [sidebarOpen, setSidebarOpen] = useState(true);\n  const [mounted, setMounted] = useState(false);\n  const [showNotifications, setShowNotifications] = useState(false);\n  const [globalSearch, setGlobalSearch] = useState(\'\');\n  const [isLightMode, setIsLightMode] = useState(false);\n\n  useEffect(() => {\n    setTimeout(() => setMounted(true), 0);\n  }, []);\n\n  const today = new Date();\n  const options: Intl.DateTimeFormatOptions = { weekday: \'long\', year: \'numeric\', month: \'long\', day: \'numeric\' };\n  const dateStr = mounted ? today.toLocaleDateString(\'en-US\', options) : \'\';\n\n  const toggleSidebar = () => setSidebarOpen(!sidebarOpen);\n\n  return ("
      replacement_content: "export default function CorenixApp() {\n  const [user, setUser] = useState<User | null>(null);\n  const [role, setRole] = useState<\'admin\' | \'receptionist\' | \'trainer\' | null>(null);\n  const [userData, setUserData] = useState<any>(null);\n  const [loading, setLoading] = useState(true);\n\n  const [email, setEmail] = useState(\'\');\n  const [password, setPassword] = useState(\'\');\n  const [loginError, setLoginError] = useState(\'\');\n  const [isLoggingIn, setIsLoggingIn] = useState(false);\n\n  const [activeTab, setActiveTab] = useState(\'Dashboard\');\n  const [sidebarOpen, setSidebarOpen] = useState(true);\n  const [mounted, setMounted] = useState(false);\n  const [showNotifications, setShowNotifications] = useState(false);\n  const [globalSearch, setGlobalSearch] = useState(\'\');\n  const [isLightMode, setIsLightMode] = useState(false);\n\n  useEffect(() => {\n    setTimeout(() => setMounted(true), 0);\n    const unsubscribe = onAuthStateChanged(auth, async (u) => {\n      if (u) {\n        setUser(u);\n        try {\n          const docRef = doc(db, \'users\', u.uid);\n          const docSnap = await getDoc(docRef);\n          if (docSnap.exists()) {\n             setRole(docSnap.data().role);\n             setUserData({ ...docSnap.data(), uid: u.uid, email: u.email });\n             // Change tab based on role if default is not allowed\n             if (docSnap.data().role === \'receptionist\') setActiveTab(\'Members\');\n             else if (docSnap.data().role === \'trainer\') setActiveTab(\'Members\');\n          } else {\n             // Fallback for development if user doesn\'t exist in firestore\n             setRole(\'admin\');\n             setUserData({ name: \'Admin\', email: u.email, role: \'admin\' });\n          }\n        } catch (e) {\n           console.error(\"Error fetching user data\", e);\n           setRole(\'admin\'); // Fallback\n           setUserData({ name: \'Admin\', email: u.email, role: \'admin\' });\n        }\n      } else {\n        setUser(null);\n        setRole(null);\n        setUserData(null);\n      }\n      setLoading(false);\n    });\n    return () => unsubscribe();\n  }, []);\n\n  const handleLogin = async (e: React.FormEvent) => {\n    e.preventDefault();\n    setIsLoggingIn(true);\n    setLoginError(\'\');\n    try {\n      await signInWithEmailAndPassword(auth, email, password);\n    } catch (err) {\n      setLoginError(\"Invalid email or password. Contact your admin.\");\n    } finally {\n      setIsLoggingIn(false);\n    }\n  };\n\n  const today = new Date();\n  const options: Intl.DateTimeFormatOptions = { weekday: \'long\', year: \'numeric\', month: \'long\', day: \'numeric\' };\n  const dateStr = mounted ? today.toLocaleDateString(\'en-US\', options) : \'\';\n\n  const toggleSidebar = () => setSidebarOpen(!sidebarOpen);\n\n  if (loading) {\n    return <div className=\"h-screen bg-[#0D0D0D] flex items-center justify-center\"><div className=\"animate-spin rounded-full h-8 w-8 border-b-2 border-primary\"></div></div>;\n  }\n\n  if (!user) {\n    return (\n      <div className=\"h-screen w-full bg-[#0D0D0D] flex flex-col items-center justify-center p-4\">\n        <div className=\"text-center mb-8\">\n           <div className=\"flex items-center justify-center gap-2 mb-2\">\n             <Dumbbell size={40} className=\"text-primary\" />\n             <span className=\"font-heading font-black text-3xl uppercase tracking-wider text-white\">Corenix</span>\n           </div>\n           <h2 className=\"text-text-secondary font-semibold uppercase tracking-widest text-sm\">Club Software</h2>\n        </div>\n\n        <div className=\"w-full max-w-md bg-surface border border-border-color rounded-xl p-8 shadow-2xl\">\n           <form onSubmit={handleLogin} className=\"space-y-6\">\n              <div className=\"space-y-2\">\n                <label className=\"text-xs text-text-secondary font-semibold uppercase\">Email Address</label>\n                <input \n                  type=\"email\" \n                  required\n                  value={email}\n                  onChange={(e) => setEmail(e.target.value)}\n                  className=\"w-full bg-[#0D0D0D] border border-border-color rounded-md px-4 py-3 text-sm text-white focus:outline-none focus:border-primary transition-colors\" \n                  placeholder=\"Enter your email\" \n                />\n              </div>\n              <div className=\"space-y-2\">\n                <div className=\"flex justify-between\">\n                  <label className=\"text-xs text-text-secondary font-semibold uppercase\">Password</label>\n                  <a href=\"#\" className=\"text-xs text-primary hover:underline\">Forgot password?</a>\n                </div>\n                <input \n                  type=\"password\" \n                  required\n                  value={password}\n                  onChange={(e) => setPassword(e.target.value)}\n                  className=\"w-full bg-[#0D0D0D] border border-border-color rounded-md px-4 py-3 text-sm text-white focus:outline-none focus:border-primary transition-colors\" \n                  placeholder=\"Enter your password\" \n                />\n              </div>\n\n              {loginError && (\n                 <div className=\"text-xs text-red-500 font-medium bg-red-500/10 p-3 rounded border border-red-500/20 text-center\">\n                    {loginError}\n                 </div>\n              )}\n\n              <button \n                disabled={isLoggingIn}\n                type=\"submit\" \n                className=\"w-full bg-primary hover:bg-primary/90 text-[#0D0D0D] font-bold py-3 rounded-md transition-colors disabled:opacity-50\"\n              >\n                {isLoggingIn ? \'Logging in...\' : \'Login\'}\n              </button>\n           </form>\n        </div>\n      </div>\n    );\n  }\n\n  const allowedNavItems = navItems.filter(item => {\n    if (role === \'admin\') return true;\n    if (role === \'receptionist\') return [\'Members\', \'Attendance\', \'Offers\'].includes(item.name);\n    if (role === \'trainer\') return [\'Members\', \'Measurements\'].includes(item.name);\n    return false;\n  });\n\n  return ("
    }
