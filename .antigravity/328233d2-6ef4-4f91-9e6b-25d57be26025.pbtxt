          text: "                 <input type=\"text\" className=\"w-full bg-[#0D0D0D] border border-border-color rounded-md px-3 py-2.5 text-sm text-white focus:border-primary/50 focus:outline-none\" placeholder=\"e.g. 06:00 AM - 02:00 PM\" />"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "              </div>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "              <div className=\"space-y-1.5 md:col-span-2\">"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                 <label className=\"text-xs font-semibold text-text-secondary uppercase\">Short Bio / Expertise Profile</label>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                 <textarea className=\"w-full bg-[#0D0D0D] border border-border-color rounded-md px-3 py-3 text-sm text-white focus:border-primary/50 focus:outline-none resize-none\" rows={3} placeholder=\"Describe the trainer\'s background, certifications, and approach...\" />"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "              </div>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "           </div>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        </div>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        <div className=\"px-6 py-4 border-t border-border-color bg-[#0D0D0D]/50 flex justify-end gap-3\">"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          <button onClick={onClose} className=\"px-4 py-2 rounded-md text-sm font-semibold text-text-secondary hover:text-white hover:bg-surface transition-colors\">Cancel</button>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          <button className=\"px-6 py-2 rounded-md text-sm font-semibold text-white bg-primary hover:bg-primary/90 transition-colors\">Register Trainer</button>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        </div>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      </div>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    </div>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  );"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
      }
    }
    instruction: "Append Staff and Trainer sections"
    replacement_infos {
      original_chunk {
        target_content: "      )}\n    </div>\n  );\n}"
        replacement_content: "      )}\n    </div>\n  );\n}\n\nconst MOCK_STAFF = [\n  { id: \'1\', name: \'Ramesh Kumar\', role: \'Security\', phone: \'919876543110\', shiftStart: \'08:00 AM\', shiftEnd: \'08:00 PM\', salary: \'\342\202\27115,000\', joinDate: \'2023-01-10\', status: \'Present\', type: \'Support\' },\n  { id: \'2\', name: \'Sanjay Dutt\', role: \'Security\', phone: \'919876543111\', shiftStart: \'08:00 PM\', shiftEnd: \'08:00 AM\', salary: \'\342\202\27115,000\', joinDate: \'2023-01-10\', status: \'Present\', type: \'Support\' },\n  { id: \'3\', name: \'Priya Verma\', role: \'Receptionist\', phone: \'919876543112\', shiftStart: \'06:00 AM\', shiftEnd: \'02:00 PM\', salary: \'\342\202\27118,000\', joinDate: \'2023-05-15\', status: \'Present\', type: \'Admin\' },\n  { id: \'4\', name: \'Neha Gupta\', role: \'Manager\', phone: \'919876543113\', shiftStart: \'10:00 AM\', shiftEnd: \'07:00 PM\', salary: \'\342\202\27135,000\', joinDate: \'2022-11-01\', status: \'Present\', type: \'Admin\' },\n  { id: \'5\', name: \'Amit Singh\', role: \'Cleaning\', phone: \'919876543114\', shiftStart: \'05:00 AM\', shiftEnd: \'01:00 PM\', salary: \'\342\202\27112,000\', joinDate: \'2024-02-20\', status: \'Absent\', type: \'Support\' },\n];\n\nconst MOCK_TRAINERS = [\n  { id: \'1\', name: \'Rajat Kumar\', specialization: \'Weight Training\', phone: \'919123456780\', experience: \'5 Years\', membersCount: 24, status: \'Active\', bio: \'Expert in bodybuilding and strength conditioning.\', salary: \'\342\202\27140,000\', timing: \'06:00 AM - 02:00 PM\' },\n  { id: \'2\', name: \'Divya Singh\', specialization: \'Yoga & Pilates\', phone: \'919123456781\', experience: \'3 Years\', membersCount: 18, status: \'Active\', bio: \'Certified yoga instructor focusing on flexibility and core strength.\', salary: \'\342\202\27135,000\', timing: \'07:00 AM - 11:00 AM\' },\n  { id: \'3\', name: \'Vikas Sharma\', specialization: \'CrossFit\', phone: \'919123456782\', experience: \'7 Years\', membersCount: 30, status: \'Active\', bio: \'High-intensity interval training specialist.\', salary: \'\342\202\27150,000\', timing: \'04:00 PM - 10:00 PM\' },\n  { id: \'4\', name: \'Ankita Rao\', specialization: \'Cardio\', phone: \'919123456783\', experience: \'4 Years\', membersCount: 15, status: \'Inactive\', bio: \'Weight loss and endurance expert.\', salary: \'\342\202\27130,000\', timing: \'05:00 PM - 09:00 PM\' },\n];\n\nfunction StaffView() {\n  const [isAddOpen, setIsAddOpen] = useState(false);\n\n  return (\n    <div className=\"w-full flex flex-col min-h-full pb-8\">\n      <header className=\"mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n        <h1 className=\"font-heading text-2xl font-bold text-white\">\n          Staff Management <span className=\"text-[12px] text-text-secondary ml-2 font-normal font-sans\">(\340\244\270\340\245\215\340\244\237\340\244\276\340\244\253)</span>\n        </h1>\n        <div className=\"flex gap-3\">\n          <button onClick={() => setIsAddOpen(true)} className=\"bg-primary hover:bg-primary/90 text-white px-4 py-2 rounded-md text-sm font-semibold flex items-center justify-center gap-2 transition-colors shrink-0\">\n            <Plus size={16} /> Add Staff\n          </button>\n        </div>\n      </header>\n\n      {/* Staff Grid */}\n      <h2 className=\"text-white font-semibold mb-4 text-[15px] uppercase tracking-wider font-heading\">Current Staff</h2>\n      <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 mb-8\">\n        {MOCK_STAFF.map(staff => (\n          <div key={staff.id} className=\"bg-surface border border-border-color rounded-xl overflow-hidden hover:border-primary/30 transition-colors group p-5\">\n            <div className=\"flex items-start gap-4 mb-4\">\n               <div className=\"w-14 h-14 rounded-full bg-[#0D0D0D] border border-border-color flex items-center justify-center font-heading font-bold text-xl text-primary shrink-0\">\n                 {staff.name.split(\' \').map((n: string) => n[0]).join(\'\')}\n               </div>\n               <div>\n                 <h3 className=\"font-semibold text-white text-base\">{staff.name}</h3>\n                 <span className=\"text-xs text-text-secondary bg-[#0D0D0D] px-2 py-0.5 rounded border border-border-color mt-1 inline-block\">{staff.role}</span>\n               </div>\n            </div>\n            \n            <div className=\"space-y-2 mb-4 text-sm text-text-secondary\">\n               <div className=\"flex items-center justify-between\">\n                 <span className=\"flex items-center gap-1.5\"><Contact size={14}/> Phone:</span>\n                 <span className=\"text-white\">{staff.phone}</span>\n               </div>\n               <div className=\"flex items-center justify-between\">\n                 <span className=\"flex items-center gap-1.5\"><Clock size={14}/> Shift:</span>\n                 <span className=\"text-white\">{staff.shiftStart} - {staff.shiftEnd}</span>\n               </div>\n            </div>\n\n            <div className=\"pt-4 border-t border-border-color/50 flex items-center justify-between\">\n               <span className=\"text-xs uppercase font-semibold text-text-secondary\">Today\'s Status</span>\n               {staff.status === \'Present\' ? (\n                 <span className=\"flex items-center gap-1 text-green-500 bg-green-500/10 px-2 py-1 rounded text-[10px] uppercase font-bold tracking-wider\">\n                   <CheckCircle2 size={12} /> Present\n                 </span>\n               ) : (\n                 <span className=\"flex items-center gap-1 text-red-500 bg-red-500/10 px-2 py-1 rounded text-[10px] uppercase font-bold tracking-wider\">\n                   <XCircle size={12} /> Absent\n                 </span>\n               )}\n            </div>\n          </div>\n        ))}\n      </div>\n\n      {/* Attendance & Payroll Details section */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-6\">\n        {/* Today\'s Staff Attendance */}\n        <div className=\"bg-surface border border-border-color rounded-xl\">\n           <div className=\"px-5 py-4 border-b border-border-color flex justify-between items-center bg-[#0D0D0D]/30\">\n              <h3 className=\"font-heading font-semibold text-[14px] text-text-secondary uppercase tracking-tight\">Today\'s Staff Check-ins</h3>\n           </div>\n           <div className=\"p-0 overflow-x-auto\">\n             <table className=\"w-full text-left text-sm whitespace-nowrap\">\n                <thead className=\"bg-[#0D0D0D] border-b border-border-color text-text-secondary text-[11px] uppercase tracking-wider\">\n                  <tr>\n                    <th className=\"px-5 py-3 font-medium\">Name</th>\n                    <th className=\"px-5 py-3 font-medium\">Role</th>\n                    <th className=\"px-5 py-3 font-medium\">In Time</th>\n                    <th className=\"px-5 py-3 font-medium\">Expected</th>\n                  </tr>\n                </thead>\n                <tbody className=\"divide-y divide-border-color\">\n                  {MOCK_STAFF.filter(s => s.status === \'Present\').map(staff => (\n                    <tr key={staff.id} className=\"hover:bg-[#0D0D0D]/50 transition-colors\">\n                      <td className=\"px-5 py-3 text-white font-medium\">{staff.name}</td>\n                      <td className=\"px-5 py-3 text-text-secondary\">{staff.role}</td>\n                      <td className=\"px-5 py-3 text-green-500 font-medium\">\n                        {staff.shiftStart.replace(\'00 \', \'15 \')} {/* Fake check-in time variant */}\n                      </td>\n                      <td className=\"px-5 py-3 text-text-secondary\">{staff.shiftStart}</td>\n                    </tr>\n                  ))}\n                </tbody>\n             </table>\n           </div>\n        </div>\n\n        {/* Monthly Summary Overview */}\n        <div className=\"bg-surface border border-border-color rounded-xl\">\n           <div className=\"px-5 py-4 border-b border-border-color flex justify-between items-center bg-[#0D0D0D]/30\">\n              <h3 className=\"font-heading font-semibold text-[14px] text-text-secondary uppercase tracking-tight\">Monthly Summary</h3>\n           </div>\n           <div className=\"p-0 overflow-x-auto\">\n             <table className=\"w-full text-left text-sm whitespace-nowrap\">\n                <thead className=\"bg-[#0D0D0D] border-b border-border-color text-text-secondary text-[11px] uppercase tracking-wider\">\n                  <tr>\n                    <th className=\"px-5 py-3 font-medium\">Name</th>\n                    <th className=\"px-5 py-3 font-medium\">Days Present</th>\n                    <th className=\"px-5 py-3 font-medium\">Days Absent</th>\n                    <th className=\"px-5 py-3 font-medium\">Calculated Pay</th>\n                  </tr>\n                </thead>\n                <tbody className=\"divide-y divide-border-color\">\n                  {MOCK_STAFF.map((staff, i) => {\n                    const daysPresent = 24 - (i * 2);\n                    const daysAbsent = i * 2;\n                    return (\n                    <tr key={staff.id} className=\"hover:bg-[#0D0D0D]/50 transition-colors\">\n                      <td className=\"px-5 py-3 text-white font-medium\">{staff.name}</td>\n                      <td className=\"px-5 py-3 text-green-500\">{daysPresent} / 28</td>\n                      <td className=\"px-5 py-3 text-red-500\">{daysAbsent}</td>\n                      <td className=\"px-5 py-3 text-white font-mono\">{staff.salary}</td>\n                    </tr>\n                  )})}\n                </tbody>\n             </table>\n           </div>\n        </div>\n      </div>\n\n      <AddStaffModal isOpen={isAddOpen} onClose={() => setIsAddOpen(false)} />\n    </div>\n  );\n}\n\nfunction AddStaffModal({ isOpen, onClose }: any) {\n  if (!isOpen) return null;\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm\">\n      <div className=\"bg-surface border border-border-color rounded-xl w-full max-w-2xl flex flex-col max-h-[90vh] overflow-hidden shadow-2xl\">\n        <div className=\"px-6 py-4 border-b border-border-color flex justify-between items-center bg-[#0D0D0D]/30\">\n          <h2 className=\"font-heading text-lg font-bold text-white flex items-center gap-2\">\n            <Plus size={20} className=\"text-primary\"/> Add New Staff\n          </h2>\n          <button onClick={onClose} className=\"text-text-secondary hover:text-white transition-colors\">\n            <X size={20} />\n          </button>\n        </div>\n\n        <div className=\"p-6 overflow-y-auto no-scrollbar flex-1 space-y-4\">\n           <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n              <div className=\"space-y-1.5\">\n                 <label className=\"text-xs font-semibold text-text-secondary uppercase\">Full Name</label>\n                 <input type=\"text\" className=\"w-full bg-[#0D0D0D] border border-border-color rounded-md px-3 py-2 text-sm text-white focus:border-primary/50 focus:outline-none\" placeholder=\"Enter full name\" />\n              </div>\n              <div className=\"space-y-1.5\">\n                 <label className=\"text-xs font-semibold text-text-secondary uppercase\">Phone Number</label>\n                 <input type=\"tel\" className=\"w-full bg-[#0D0D0D] border border-border-color rounded-md px-3 py-2 text-sm text-white focus:border-primary/50 focus:outline-none\" placeholder=\"Enter phone\" />\n              </div>\n              <div className=\"space-y-1.5\">\n                 <label className=\"text-xs font-semibold text-text-secondary uppercase\">Job Role</label>\n                 <select className=\"w-full bg-[#0D0D0D] border border-border-color rounded-md px-3 py-2 text-sm text-text-secondary focus:border-primary/50 focus:outline-none\">\n                   <option>Receptionist</option>\n                   <option>Manager</option>\n                   <option>Cleaning</option>\n                   <option>Security</option>\n                   <option>Maintenance</option>\n                 </select>\n              </div>\n              <div className=\"space-y-1.5\">\n                 <label className=\"text-xs font-semibold text-text-secondary uppercase\">Joining Date</label>\n                 <input type=\"date\" className=\"w-full bg-[#0D0D0D] border border-border-color rounded-md px-3 py-2 text-sm text-white focus:border-primary/50 focus:outline-none [color-scheme:dark]\" />\n              </div>\n              <div className=\"space-y-1.5\">\n                 <label className=\"text-xs font-semibold text-text-secondary uppercase\">Shift Start Time</label>\n                 <input type=\"time\" className=\"w-full bg-[#0D0D0D] border border-border-color rounded-md px-3 py-2 text-sm text-white focus:border-primary/50 focus:outline-none [color-scheme:dark]\" />\n              </div>\n              <div className=\"space-y-1.5\">\n                 <label className=\"text-xs font-semibold text-text-secondary uppercase\">Shift End Time</label>\n                 <input type=\"time\" className=\"w-full bg-[#0D0D0D] border border-border-color rounded-md px-3 py-2 text-sm text-white focus:border-primary/50 focus:outline-none [color-scheme:dark]\" />\n              </div>\n              <div className=\"space-y-1.5 sm:col-span-2\">\n                 <label className=\"text-xs font-semibold text-text-secondary uppercase\">Salary Per Month</label>\n                 <div className=\"relative\">\n                   <span className=\"absolute left-3 top-1/2 -translate-y-1/2 text-text-secondary text-sm\">\342\202\271</span>\n                   <input type=\"number\" className=\"w-full bg-[#0D0D0D] border border-border-color rounded-md pl-7 pr-3 py-2 text-sm text-white focus:border-primary/50 focus:outline-none\" placeholder=\"0\" />\n                 </div>\n              </div>\n           </div>\n        </div>\n\n        <div className=\"px-6 py-4 border-t border-border-color bg-[#0D0D0D]/50 flex justify-end gap-3\">\n          <button onClick={onClose} className=\"px-4 py-2 rounded-md text-sm font-semibold text-text-secondary hover:text-white hover:bg-surface transition-colors\">Cancel</button>\n          <button className=\"px-6 py-2 rounded-md text-sm font-semibold text-white bg-primary hover:bg-primary/90 transition-colors\">Save Staff Data</button>\n        </div>\n      </div>\n    </div>\n  );\n}\n\nfunction TrainersView() {\n  const [selectedTrainer, setSelectedTrainer] = useState<any>(null);\n  const [isAddOpen, setIsAddOpen] = useState(false);\n\n  if (selectedTrainer) {\n    return <TrainerProfile trainer={selectedTrainer} onBack={() => setSelectedTrainer(null)} />;\n  }\n\n  return (\n    <div className=\"w-full flex flex-col min-h-full pb-8\">\n      <header className=\"mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n        <h1 className=\"font-heading text-2xl font-bold text-white\">\n          Trainers Dashboard\n        </h1>\n        <div className=\"flex gap-3\">\n          <button onClick={() => setIsAddOpen(true)} className=\"bg-primary hover:bg-primary/90 text-white px-4 py-2 rounded-md text-sm font-semibold flex items-center justify-center gap-2 transition-colors shrink-0\">\n            <Plus size={16} /> Add Trainer\n          </button>\n        </div>\n      </header>\n\n      {/* Overview Stats */}\n      <div className=\"grid grid-cols-1 md:grid-cols-3 gap-6 mb-8\">\n        <div className=\"bg-surface border border-border-color rounded-xl p-5 shadow-sm\">\n           <div className=\"flex items-center gap-3 mb-2\">\n             <div className=\"p-2 bg-primary/10 text-primary rounded-lg shrink-0\"><CheckCircle size={20} /></div>\n             <h3 className=\"text-sm font-semibold text-text-secondary uppercase tracking-wider\">Active Trainers</h3>\n           </div>\n           <div className=\"text-3xl font-heading font-black text-white pl-12 tracking-tight\">12</div>\n        </div>\n        <div className=\"bg-surface border border-border-color rounded-xl p-5 shadow-sm\">\n           <div className=\"flex items-center gap-3 mb-2\">\n             <div className=\"p-2 bg-primary/10 text-primary rounded-lg shrink-0\"><Activity size={20} /></div>\n             <h3 className=\"text-sm font-semibold text-text-secondary uppercase tracking-wider\">PT Sessions (Month)</h3>\n           </div>\n           <div className=\"text-3xl font-heading font-black text-white pl-12 tracking-tight\">458</div>\n        </div>\n        <div className=\"bg-surface border border-border-color rounded-xl p-5 shadow-sm\">\n           <div className=\"flex items-center gap-3 mb-2\">\n             <div className=\"p-2 bg-primary/10 text-primary rounded-lg shrink-0\"><IndianRupee size={20} /></div>\n             <h3 className=\"text-sm font-semibold text-text-secondary uppercase tracking-wider\">PT Revenue Generated</h3>\n           </div>\n           <div className=\"text-3xl font-heading font-black text-white pl-12 tracking-tight\">\342\202\271 1.2L</div>\n        </div>\n      </div>\n\n      <h2 className=\"text-white font-semibold mb-4 text-[15px] uppercase tracking-wider font-heading\">Our Trainers</h2>\n      <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\">\n         {MOCK_TRAINERS.map(trainer => (\n           <div \n             key={trainer.id} \n             onClick={() => setSelectedTrainer(trainer)}\n             className={`bg-[#0D0D0D] border-x border-b border-t-2 rounded-xl overflow-hidden hover:bg-surface/50 transition-all cursor-pointer relative ${\n               trainer.status === \'Active\' ? \'border-primary/50 border-t-primary shadow-[0_0_15px_rgba(255,51,51,0.05)]\' : \'border-border-color border-t-text-secondary/50\'\n             }`}\n           >\n             <div className=\"absolute top-4 right-4 flex items-center justify-center\">\n                 <span className={`px-2 py-0.5 rounded-[4px] text-[10px] font-bold uppercase tracking-wider ${\n                     trainer.status === \'Active\' ? \'bg-green-500/10 text-green-500\' : \'bg-[#fff] text-[#000]\'\n                   }`}>\n                     {trainer.status}\n                 </span>\n             </div>\n             <div className=\"p-6\">\n                <div className=\"flex items-center gap-4 mb-5 pb-5 border-b border-border-color/50\">\n                  <div className={`w-16 h-16 rounded-full bg-surface border-2 flex items-center justify-center font-heading font-bold text-2xl shrink-0 ${\n                    trainer.status === \'Active\' ? \'border-primary text-white\' : \'border-border-color text-text-secondary\'\n                  }`}>\n                    {trainer.name.split(\' \').map((n: string) => n[0]).join(\'\')}\n                  </div>\n                  <div>\n                    <h3 className=\"font-heading font-bold text-white text-lg\">{trainer.name}</h3>\n                    <div className=\"text-primary text-sm font-medium mt-0.5\">{trainer.specialization}</div>\n                  </div>\n                </div>\n                \n                <div className=\"space-y-3 text-[13px] text-text-secondary\">\n                  <div className=\"flex items-center justify-between\">\n                    <span className=\"flex items-center gap-2\"><Award size={15}/> Experience:</span>\n                    <span className=\"text-white font-medium\">{trainer.experience}</span>\n                  </div>\n                  <div className=\"flex items-center justify-between\">\n                    <span className=\"flex items-center gap-2\"><Users size={15}/> Members Assigned:</span>\n                    <span className=\"text-white font-medium\">{trainer.membersCount}</span>\n                  </div>\n                  <div className=\"flex items-center justify-between\">\n                    <span className=\"flex items-center gap-2\"><Clock size={15}/> Timings:</span>\n                    <span className=\"text-white font-medium\">{trainer.timing}</span>\n                  </div>\n                </div>\n             </div>\n           </div>\n         ))}\n      </div>\n\n      <AddTrainerModal isOpen={isAddOpen} onClose={() => setIsAddOpen(false)} />\n    </div>\n  );\n}\n\nfunction TrainerProfile({ trainer, onBack }: any) {\n  return (\n    <div className=\"w-full pb-8\">\n      <button onClick={onBack} className=\"flex items-center gap-2 text-text-secondary hover:text-white transition-colors text-sm mb-6 font-semibold\">\n        <ArrowLeft size={16} /> Back to Trainers\n      </button>\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n        <div className=\"space-y-6\">\n            {/* Header Profile Card */}\n            <div className=\"bg-surface border border-border-color rounded-xl overflow-hidden relative shadow-md\">\n              <div className=\"h-20 bg-primary/20 w-full relative\">\n                 <div className=\"absolute inset-0 bg-gradient-to-b from-transparent to-surface\"></div>\n              </div>\n              <div className=\"px-6 pb-6 relative pt-12\">\n                 <div className=\"absolute -top-12 left-6 w-24 h-24 rounded-full bg-[#0D0D0D] border-4 border-surface flex items-center justify-center font-heading text-3xl font-bold text-primary shadow-lg\">\n                   {trainer.name.split(\' \').map((n: string) => n[0]).join(\'\')}\n                 </div>\n                 \n                 <div className=\"flex justify-end absolute top-3 right-6\">\n                    <span className={`px-2 py-0.5 rounded-[4px] text-[11px] font-bold uppercase tracking-wider ${\n                        trainer.status === \'Active\' ? \'bg-green-500/10 text-green-500\' : \'bg-text-secondary/20 text-text-secondary\'\n                      }`}>\n                        {trainer.status}\n                    </span>\n                 </div>\n\n                 <h1 className=\"font-heading text-2xl font-bold text-white mt-2\">{trainer.name}</h1>\n                 <div className=\"text-sm text-primary font-semibold mb-4\">{trainer.specialization}</div>\n\n                 <p className=\"text-text-secondary text-sm leading-relaxed mb-6\">{trainer.bio}</p>\n\n                 <div className=\"space-y-3 pt-4 border-t border-border-color/50 text-sm\">\n                   <div className=\"flex items-center justify-between text-text-secondary\">\n                     <span>Contact</span>\n                     <span className=\"text-white font-mono\">{trainer.phone}</span>\n                   </div>\n                   <div className=\"flex items-center justify-between text-text-secondary\">\n                     <span>Experience</span>\n                     <span className=\"text-white font-medium\">{trainer.experience}</span>\n                   </div>\n                   <div className=\"flex items-center justify-between text-text-secondary\">\n                     <span>Salary Base</span>\n                     <span className=\"text-white font-medium\">{trainer.salary}</span>\n                   </div>\n                 </div>\n              </div>\n            </div>\n\n            {/* Performance Stats */}\n            <div className=\"bg-surface border border-border-color rounded-xl p-5 mb-6\">\n               <h3 className=\"font-heading font-semibold text-[14px] text-text-secondary uppercase tracking-tight mb-4\">Performance Insights</h3>\n               <div className=\"space-y-4\">\n                 <div>\n                    <div className=\"flex justify-between text-sm mb-1\">\n                      <span className=\"text-text-secondary\">Member Retention Rate</span>\n                      <span className=\"text-green-500 font-bold\">85%</span>\n                    </div>\n                    <div className=\"w-full bg-[#0D0D0D] h-1.5 rounded-full overflow-hidden\">\n                      <div className=\"bg-green-500 h-full rounded-full\" style={{ width: \'85%\' }}></div>\n                    </div>\n                 </div>\n                 <div>\n                    <div className=\"flex justify-between text-sm mb-1\">\n                      <span className=\"text-text-secondary\">Sessions Target (Month)</span>\n                      <span className=\"text-primary font-bold\">45 / 60</span>\n                    </div>\n                    <div className=\"w-full bg-[#0D0D0D] h-1.5 rounded-full overflow-hidden\">\n                      <div className=\"bg-primary h-full rounded-full\" style={{ width: \'75%\' }}></div>\n                    </div>\n                 </div>\n               </div>\n            </div>\n        </div>\n\n        <div className=\"lg:col-span-2 space-y-6\">\n           <div className=\"grid grid-cols-2 gap-4\">\n             <div className=\"bg-[#0D0D0D] border border-border-color rounded-xl p-5\">\n               <div className=\"text-text-secondary uppercase text-[10px] font-bold tracking-wider mb-1\">Current Active Members</div>\n               <div className=\"text-2xl font-heading font-black text-white\">{trainer.membersCount}</div>\n             </div>\n             <div className=\"bg-[#0D0D0D] border border-border-color rounded-xl p-5\">\n               <div className=\"text-text-secondary uppercase text-[10px] font-bold tracking-wider mb-1\">Total PT Commission</div>\n               <div className=\"text-2xl font-heading font-black text-green-500\">\342\202\271 14,500</div>\n             </div>\n           </div>\n\n           {/* Assigned Members List */}\n           <div className=\"bg-surface border border-border-color rounded-xl overflow-hidden\">\n             <div className=\"px-5 py-4 border-b border-border-color flex justify-between items-center bg-[#0D0D0D]/30\">\n                <h3 className=\"font-heading font-semibold text-[14px] text-text-secondary uppercase tracking-tight\">Assigned Members</h3>\n                <button className=\"text-xs text-primary font-semibold hover:underline\">View All</button>\n             </div>\n             <table className=\"w-full text-left text-sm whitespace-nowrap\">\n                <thead className=\"bg-[#0D0D0D] border-b border-border-color text-text-secondary text-[11px] uppercase tracking-wider\">\n                  <tr>\n                    <th className=\"px-5 py-3 font-medium\">Member Name</th>\n                    <th className=\"px-5 py-3 font-medium\">Goal</th>\n                    <th className=\"px-5 py-3 font-medium\">PT Status</th>\n                    <th className=\"px-5 py-3 font-medium\">Next Session</th>\n                  </tr>\n                </thead>\n                <tbody className=\"divide-y divide-border-color\">\n                  {[1,2,3,4,5].map(i => (\n                    <tr key={i} className=\"hover:bg-[#0D0D0D]/50 transition-colors\">\n                      <td className=\"px-5 py-3 text-white flex items-center gap-3\">\n                         <div className=\"w-6 h-6 rounded-full bg-surface border border-border-color text-primary flex items-center justify-center font-heading font-bold text-[10px] uppercase\">\n                           M{i}\n                         </div>\n                         Member {i}\n                      </td>\n                      <td className=\"px-5 py-3 text-text-secondary\">Weight Loss</td>\n                      <td className=\"px-5 py-3 text-green-500 text-xs font-semibold uppercase\">Active PT</td>\n                      <td className=\"px-5 py-3 text-text-secondary\">Today, 05:00 PM</td>\n                    </tr>\n                  ))}\n                </tbody>\n              </table>\n           </div>\n        </div>\n      </div>\n    </div>\n  );\n}\n\nfunction AddTrainerModal({ isOpen, onClose }: any) {\n  if (!isOpen) return null;\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm\">\n      <div className=\"bg-surface border border-border-color rounded-xl w-full max-w-3xl flex flex-col max-h-[90vh] overflow-hidden shadow-2xl\">\n        <div className=\"px-6 py-4 border-b border-border-color flex justify-between items-center bg-[#0D0D0D]/30\">\n          <h2 className=\"font-heading text-lg font-bold text-white flex items-center gap-2\">\n            <Plus size={20} className=\"text-primary\"/> Add New Trainer\n          </h2>\n          <button onClick={onClose} className=\"text-text-secondary hover:text-white transition-colors\">\n            <X size={20} />\n          </button>\n        </div>\n\n        <div className=\"p-6 overflow-y-auto no-scrollbar flex-1 space-y-6\">\n           <div className=\"grid grid-cols-1 md:grid-cols-2 gap-5\">\n              <div className=\"space-y-1.5 md:col-span-2 text-center flex flex-col items-center gap-3 mb-2\">\n                  <div className=\"w-20 h-20 rounded-full border-2 border-dashed border-border-color bg-[#0D0D0D] flex flex-col items-center justify-center text-text-secondary cursor-pointer hover:text-primary hover:border-primary/50 transition-all\">\n                     <Camera size={24} className=\"mb-1\" />\n                     <span className=\"text-[10px] uppercase font-bold tracking-wider\">Photo</span>\n                  </div>\n              </div>\n\n              <div className=\"space-y-1.5\">\n                 <label className=\"text-xs font-semibold text-text-secondary uppercase\">Full Name</label>\n                 <input type=\"text\" className=\"w-full bg-[#0D0D0D] border border-border-color rounded-md px-3 py-2.5 text-sm text-white focus:border-primary/50 focus:outline-none\" placeholder=\"Enter trainer name\" />\n              </div>\n              <div className=\"space-y-1.5\">\n                 <label className=\"text-xs font-semibold text-text-secondary uppercase\">Phone Number</label>\n                 <input type=\"tel\" className=\"w-full bg-[#0D0D0D] border border-border-color rounded-md px-3 py-2.5 text-sm text-white focus:border-primary/50 focus:outline-none\" placeholder=\"Enter phone\" />\n              </div>\n\n              <div className=\"space-y-1.5\">\n                 <label className=\"text-xs font-semibold text-text-secondary uppercase\">Specialization</label>\n                 <select className=\"w-full bg-[#0D0D0D] border border-border-color rounded-md px-3 py-2.5 text-sm text-text-secondary focus:border-primary/50 focus:outline-none\">\n                   <option>Weight Training</option>\n                   <option>Yoga & Pilates</option>\n                   <option>CrossFit</option>\n                   <option>Cardio</option>\n                   <option>General Fitness</option>\n                 </select>\n              </div>\n              <div className=\"space-y-1.5\">\n                 <label className=\"text-xs font-semibold text-text-secondary uppercase\">Experience (Years)</label>\n                 <input type=\"number\" className=\"w-full bg-[#0D0D0D] border border-border-color rounded-md px-3 py-2.5 text-sm text-white focus:border-primary/50 focus:outline-none\" placeholder=\"e.g. 5\" />\n              </div>\n\n              <div className=\"space-y-1.5\">\n                 <label className=\"text-xs font-semibold text-text-secondary uppercase\">Monthly Base Salary</label>\n                 <div className=\"relative\">\n                   <span className=\"absolute left-3 top-1/2 -translate-y-1/2 text-text-secondary text-sm\">\342\202\271</span>\n                   <input type=\"number\" className=\"w-full bg-[#0D0D0D] border border-border-color rounded-md pl-7 pr-3 py-2.5 text-sm text-white focus:border-primary/50 focus:outline-none\" placeholder=\"0\" />\n                 </div>\n              </div>\n              <div className=\"space-y-1.5\">\n                 <label className=\"text-xs font-semibold text-text-secondary uppercase\">Availability Timing</label>\n                 <input type=\"text\" className=\"w-full bg-[#0D0D0D] border border-border-color rounded-md px-3 py-2.5 text-sm text-white focus:border-primary/50 focus:outline-none\" placeholder=\"e.g. 06:00 AM - 02:00 PM\" />\n              </div>\n\n              <div className=\"space-y-1.5 md:col-span-2\">\n                 <label className=\"text-xs font-semibold text-text-secondary uppercase\">Short Bio / Expertise Profile</label>\n                 <textarea className=\"w-full bg-[#0D0D0D] border border-border-color rounded-md px-3 py-3 text-sm text-white focus:border-primary/50 focus:outline-none resize-none\" rows={3} placeholder=\"Describe the trainer\'s background, certifications, and approach...\" />\n              </div>\n           </div>\n        </div>\n\n        <div className=\"px-6 py-4 border-t border-border-color bg-[#0D0D0D]/50 flex justify-end gap-3\">\n          <button onClick={onClose} className=\"px-4 py-2 rounded-md text-sm font-semibold text-text-secondary hover:text-white hover:bg-surface transition-colors\">Cancel</button>\n          <button className=\"px-6 py-2 rounded-md text-sm font-semibold text-white bg-primary hover:bg-primary/90 transition-colors\">Register Trainer</button>\n        </div>\n      </div>\n    </div>\n  );\n}"
