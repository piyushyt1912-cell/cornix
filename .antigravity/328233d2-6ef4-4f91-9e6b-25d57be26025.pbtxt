          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    const colors = [\'bg-[#0D0D0D]\', \'bg-primary/20\', \'bg-primary/40\', \'bg-primary/70\', \'bg-primary\'];"
