    replacement_chunks {
      target_content: "      {/* Main Content */}\n      <main className=\"flex-1 flex flex-col h-screen overflow-hidden\">\n        \n        {/* Topbar */}\n        <header className=\"h-[64px] border-b border-border-color bg-surface z-30 flex items-center justify-between px-6 shrink-0\">\n          <div className=\"flex items-center gap-4\">\n            <button \n              onClick={toggleSidebar}\n              className=\"p-2 -ml-2 rounded-md hover:bg-[#0D0D0D] text-text-secondary hover:text-white transition-colors lg:hidden\"\n            >\n              <Menu size={20} />\n            </button>\n            <div className=\"relative hidden sm:flex items-center w-[300px] bg-[#0D0D0D] border border-border-color rounded-md px-3 py-2\">\n              <Search className=\"text-text-secondary shrink-0\" size={16} />\n              <input \n                type=\"text\" \n                placeholder=\"Search members by name or ID...\" \n                className=\"bg-transparent border-none text-[13px] text-white focus:outline-none w-full ml-2 placeholder:text-text-secondary\"\n              />\n            </div>\n          </div>\n\n          <div className=\"flex items-center gap-5\">\n            <div className=\"hidden md:block text-[12px] text-text-secondary uppercase tracking-[0.5px]\">\n              {dateStr}\n            </div>\n            \n            <button className=\"relative text-text-secondary hover:text-white transition-colors cursor-pointer\">\n              <Bell size={24} strokeWidth={2} />\n              <div className=\"absolute -top-1 -right-1 w-2 h-2 bg-primary rounded-full\"></div>\n            </button>\n            \n            <div className=\"flex items-center gap-2\">\n              <div className=\"w-8 h-8 rounded-full bg-[#333] border border-border-color flex items-center justify-center overflow-hidden font-heading font-bold text-sm\">\n                A\n              </div>\n              <span className=\"text-xs font-semibold text-white\">Admin</span>\n            </div>\n          </div>\n        </header>\n\n        {/* Dynamic Content Area */}\n        <div className=\"flex-1 overflow-auto bg-[#0D0D0D] p-6 no-scrollbar\">\n          {activeTab === \'Dashboard\' && <DashboardView />}\n          {activeTab === \'Members\' && <MembersView />}\n          {activeTab === \'Attendance\' && <AttendanceView />}\n          {activeTab === \'Staff\' && <StaffView />}\n          {activeTab === \'Trainers\' && <TrainersView />}\n          {activeTab === \'Reports\' && <ReportsView />}\n          {activeTab === \'Offers\' && <OffersView />}\n          {activeTab === \'Measurements\' && <MeasurementsView />}\n          {activeTab === \'Reviews\' && <ReviewsView />}\n          {activeTab !== \'Dashboard\' && activeTab !== \'Members\' && activeTab !== \'Attendance\' && activeTab !== \'Staff\' && activeTab !== \'Trainers\' && activeTab !== \'Reports\' && activeTab !== \'Offers\' && activeTab !== \'Measurements\' && activeTab !== \'Reviews\' && (\n            <div className=\"h-full flex items-center justify-center flex-col gap-4 text-text-secondary\">\n              <div className=\"p-4 bg-surface rounded-full border border-border-color\">\n                <Search size={32} className=\"text-text-secondary border-border-color\" />\n              </div>\n              <p className=\"font-heading text-lg\">Module <span className=\"text-white\">&quot;{activeTab}&quot;</span> is under construction.</p>\n            </div>\n          )}\n        </div>\n\n        {/* Footer */}\n        <footer className=\"h-10 text-center flex items-center justify-center bg-surface border-t border-border-color text-[11px] text-text-secondary tracking-[1px] uppercase shrink-0\">\n          Corenix Club Software | Powered by Fit United\n        </footer>\n\n      </main>\n    </div>\n  );\n}"
      replacement_content: "      {/* Main Content */}\n      <main className=\"flex-1 flex flex-col h-screen overflow-hidden relative\">\n        \n        {/* Topbar */}\n        <header className={`h-[64px] border-b ${isLightMode ? \'bg-white border-gray-200\' : \'bg-surface border-border-color\'} z-30 flex items-center justify-between px-6 shrink-0`}>\n          <div className=\"flex items-center gap-4 relative\">\n            <button \n              onClick={toggleSidebar}\n              className={`p-2 -ml-2 rounded-md ${isLightMode ? \'hover:bg-gray-100 text-gray-500 hover:text-black\' : \'hover:bg-[#0D0D0D] text-text-secondary hover:text-white\'} transition-colors lg:hidden`}\n            >\n              <Menu size={20} />\n            </button>\n            <div className={`relative hidden sm:flex items-center w-[300px] ${isLightMode ? \'bg-gray-100 border-gray-200\' : \'bg-[#0D0D0D] border-border-color\'} border rounded-md px-3 py-2 transition-all focus-within:ring-1 focus-within:ring-primary`}>\n              <Search className={isLightMode ? \'text-gray-400 shrink-0\' : \'text-text-secondary shrink-0\'} size={16} />\n              <input \n                type=\"text\" \n                value={globalSearch}\n                onChange={(e) => setGlobalSearch(e.target.value)}\n                placeholder=\"Search across Corenix...\" \n                className={`bg-transparent border-none text-[13px] ${isLightMode ? \'text-black placeholder:text-gray-400\' : \'text-white placeholder:text-text-secondary\'} focus:outline-none w-full ml-2`}\n              />\n            </div>\n\n            {/* Global Search Results Dropdown */}\n            {globalSearch.length > 1 && (\n              <div className={`absolute top-12 left-0 sm:left-10 w-[320px] rounded-lg shadow-xl shadow-black/50 border ${isLightMode ? \'bg-white border-gray-200\' : \'bg-surface border-border-color\'} z-50 overflow-hidden`}>\n                <div className={`px-4 py-2 border-b ${isLightMode ? \'border-gray-200 bg-gray-50 text-gray-500\' : \'border-border-color bg-[#0D0D0D] text-text-secondary\'} text-xs font-bold uppercase`}>Members</div>\n                <div className={`px-4 py-3 hover:${isLightMode ? \'bg-gray-50 cursor-pointer\' : \'bg-[#0D0D0D]/80 cursor-pointer\'} flex items-center justify-between`}>\n                  <div className=\"flex items-center gap-3\">\n                    <div className=\"w-8 h-8 rounded-full bg-primary/20 flex items-center justify-center text-primary font-bold\">R</div>\n                    <div>\n                      <div className={`text-sm ${isLightMode ? \'text-black font-semibold\' : \'text-white\'}`}>Rahul Sharma</div>\n                      <div className=\"text-xs text-text-secondary\">ID: 1042 \342\200\242 Pro Yearly</div>\n                    </div>\n                  </div>\n                  <ChevronUp className=\"rotate-90 text-text-secondary\" size={16} />\n                </div>\n                <div className={`px-4 py-2 border-b border-t ${isLightMode ? \'border-gray-200 bg-gray-50 text-gray-500\' : \'border-border-color bg-[#0D0D0D] text-text-secondary\'} text-xs font-bold uppercase`}>Transactions</div>\n                <div className={`px-4 py-3 hover:${isLightMode ? \'bg-gray-50 cursor-pointer\' : \'bg-[#0D0D0D]/80 cursor-pointer\'} flex items-center justify-between`}>\n                  <div className=\"flex items-center gap-3\">\n                    <div className=\"w-8 h-8 rounded-md bg-green-500/20 flex items-center justify-center text-green-500\"><Banknote size={16}/></div>\n                    <div>\n                      <div className={`text-sm ${isLightMode ? \'text-black font-semibold\' : \'text-white\'}`}>TXN-9948</div>\n                      <div className=\"text-xs text-text-secondary\">\342\202\27114,500 \342\200\242 Amit Kumar</div>\n                    </div>\n                  </div>\n                  <ChevronUp className=\"rotate-90 text-text-secondary\" size={16} />\n                </div>\n              </div>\n            )}\n          </div>\n\n          <div className=\"flex items-center gap-5\">\n            <div className={`hidden md:block text-[12px] ${isLightMode ? \'text-gray-500\' : \'text-text-secondary\'} uppercase tracking-[0.5px]`}>\n              {dateStr}\n            </div>\n            \n            <button \n              onClick={() => setIsLightMode(!isLightMode)}\n              className={`relative ${isLightMode ? \'text-gray-500 hover:text-black\' : \'text-text-secondary hover:text-white\'} transition-colors cursor-pointer`}\n              title=\"Toggle Theme\"\n            >\n              {isLightMode ? <Moon size={20} strokeWidth={2} /> : <Sun size={20} strokeWidth={2} />}\n            </button>\n\n            <button \n              onClick={() => setShowNotifications(!showNotifications)}\n              className={`relative ${isLightMode ? \'text-gray-500 hover:text-black\' : \'text-text-secondary hover:text-white\'} transition-colors cursor-pointer`}\n            >\n              <Bell size={24} strokeWidth={2} />\n              <div className=\"absolute top-0 right-0 w-2 h-2 bg-primary rounded-full animate-pulse ring-2 ring-[#0D0D0D]\"></div>\n            </button>\n\n            {/* Notifications Dropdown */}\n            {showNotifications && (\n              <div className={`absolute top-[60px] right-6 w-[340px] rounded-xl shadow-2xl shadow-black/80 border ${isLightMode ? \'bg-white border-gray-200\' : \'bg-surface border-border-color\'} z-50 overflow-hidden transform origin-top-right transition-all`}>\n                <div className={`px-4 py-3 border-b ${isLightMode ? \'border-gray-200 bg-gray-50\' : \'border-border-color bg-[#0D0D0D]/50\'} flex justify-between items-center`}>\n                  <h3 className={`font-bold ${isLightMode ? \'text-black\' : \'text-white\'}`}>Notifications (4)</h3>\n                  <button className=\"text-xs text-primary hover:underline\">Mark all read</button>\n                </div>\n                <div className=\"max-h-[350px] overflow-y-auto no-scrollbar\">\n                  <div className={`p-4 border-b ${isLightMode ? \'border-gray-100 hover:bg-red-50/50\' : \'border-border-color hover:bg-red-500/5\'} cursor-pointer transition-colors relative`}>\n                    <div className=\"w-2 h-2 bg-red-500 rounded-full absolute top-5 left-2\"></div>\n                    <div className=\"ml-2\">\n                       <p className={`text-sm ${isLightMode ? \'text-black\' : \'text-white\'} font-semibold`}>5 Memberships Expiring Today</p>\n                       <p className={`text-xs ${isLightMode ? \'text-gray-500\' : \'text-text-secondary\'} mt-1`}>Including Karan Johar & Neha Sharma</p>\n                       <button className=\"mt-2 text-xs bg-red-500 hover:bg-red-600 text-white px-2 py-1 rounded inline-flex items-center gap-1\"><MessageCircle size={12}/> Send Reminders</button>\n                    </div>\n                  </div>\n                  <div className={`p-4 border-b ${isLightMode ? \'border-gray-100 hover:bg-blue-50/50\' : \'border-border-color hover:bg-blue-500/5\'} cursor-pointer transition-colors relative`}>\n                    <div className=\"w-2 h-2 bg-blue-500 rounded-full absolute top-5 left-2\"></div>\n                    <div className=\"ml-2\">\n                       <p className={`text-sm ${isLightMode ? \'text-black\' : \'text-white\'} font-semibold`}>Birthdays Today \360\237\216\202</p>\n                       <p className={`text-xs ${isLightMode ? \'text-gray-500\' : \'text-text-secondary\'} mt-1`}>Rahul Sharma and Sneha Gupta</p>\n                       <button className=\"mt-2 text-xs bg-blue-500 hover:bg-blue-600 text-white px-2 py-1 rounded inline-flex items-center gap-1\"><Gift size={12}/> Send Offers</button>\n                    </div>\n                  </div>\n                  <div className={`p-4 border-b ${isLightMode ? \'border-gray-100 hover:bg-gray-50\' : \'border-border-color hover:bg-[#0D0D0D]/50\'} cursor-pointer transition-colors relative`}>\n                    <div className=\"w-2 h-2 bg-orange-500 rounded-full absolute top-5 left-2\"></div>\n                    <div className=\"ml-2\">\n                       <p className={`text-sm ${isLightMode ? \'text-black\' : \'text-white\'} font-semibold`}>Members Absent &gt; 7 Days</p>\n                       <p className={`text-xs ${isLightMode ? \'text-gray-500\' : \'text-text-secondary\'} mt-1`}>14 active members haven\'t visited.</p>\n                       <button className=\"mt-2 text-xs border border-border-color hover:border-primary text-text-secondary hover:text-white px-2 py-1 rounded\">View List</button>\n                    </div>\n                  </div>\n                  <div className={`p-4 ${isLightMode ? \'hover:bg-gray-50\' : \'hover:bg-[#0D0D0D]/50\'} cursor-pointer transition-colors relative`}>\n                    <div className=\"w-2 h-2 bg-text-secondary rounded-full absolute top-5 left-2\"></div>\n                    <div className=\"ml-2\">\n                       <p className={`text-sm ${isLightMode ? \'text-black\' : \'text-white\'} font-semibold`}>Staff Absent</p>\n                       <p className={`text-xs ${isLightMode ? \'text-gray-500\' : \'text-text-secondary\'} mt-1`}>Trainer \'Vikas Singh\' marked absent today.</p>\n                    </div>\n                  </div>\n                </div>\n              </div>\n            )}\n            \n            <div className=\"flex items-center gap-2 pl-2 border-l border-border-color\">\n              <div className=\"w-8 h-8 rounded-full bg-[#333] border border-border-color flex items-center justify-center overflow-hidden font-heading font-bold text-sm\">\n                A\n              </div>\n              <span className={`text-xs font-semibold ${isLightMode ? \'text-black\' : \'text-white\'}`}>Admin</span>\n            </div>\n          </div>\n        </header>\n\n        {/* Dynamic Content Area */}\n        <div className={`flex-1 overflow-auto ${isLightMode ? \'bg-[#f0f2f5]\' : \'bg-[#0D0D0D]\'} p-6 no-scrollbar relative`}>\n          {activeTab === \'Dashboard\' && <div className=\"absolute top-0 left-0 right-0 h-[300px] bg-gradient-to-b from-primary/10 to-transparent pointer-events-none opacity-50\"></div>}\n          <motion.div \n            key={activeTab}\n            initial={{ opacity: 0, y: 10 }}\n            animate={{ opacity: 1, y: 0 }}\n            exit={{ opacity: 0, y: -10 }}\n            transition={{ duration: 0.3 }}\n            className=\"h-full relative z-10\"\n          >\n            {activeTab === \'Dashboard\' && <DashboardView />}\n            {activeTab === \'Members\' && <MembersView />}\n            {activeTab === \'Attendance\' && <AttendanceView />}\n            {activeTab === \'Staff\' && <StaffView />}\n            {activeTab === \'Trainers\' && <TrainersView />}\n            {activeTab === \'Reports\' && <ReportsView />}\n            {activeTab === \'Offers\' && <OffersView />}\n            {activeTab === \'Measurements\' && <MeasurementsView />}\n            {activeTab === \'Reviews\' && <ReviewsView />}\n            {activeTab === \'Settings\' && <SettingsView />}\n            {activeTab !== \'Dashboard\' && activeTab !== \'Members\' && activeTab !== \'Attendance\' && activeTab !== \'Staff\' && activeTab !== \'Trainers\' && activeTab !== \'Reports\' && activeTab !== \'Offers\' && activeTab !== \'Measurements\' && activeTab !== \'Reviews\' && activeTab !== \'Settings\' && (\n              <div className=\"h-full flex items-center justify-center flex-col gap-4 text-text-secondary\">\n                <div className=\"p-4 bg-surface rounded-full border border-border-color\">\n                  <Search size={32} className=\"text-text-secondary border-border-color\" />\n                </div>\n                <p className=\"font-heading text-lg\">Module <span className={`${isLightMode ? \'text-black\' : \'text-white\'}`}>&quot;{activeTab}&quot;</span> is under construction.</p>\n              </div>\n            )}\n          </motion.div>\n        </div>\n\n        {/* Footer */}\n        <footer className={`h-10 text-center flex items-center justify-center ${isLightMode ? \'bg-white border-gray-200\' : \'bg-surface border-border-color\'} border-t text-[11px] text-text-secondary tracking-[1px] uppercase shrink-0`}>\n          Corenix Club Software | Powered by Fit United\n        </footer>\n\n      </main>\n    </div>\n  );\n}"
