    instruction: "Add Reports section with Chart.js and correct tabs"
    replacement_infos {
      original_chunk {
        target_content: "  Check, AlertTriangle, Download, Usb, CheckCircle2, Clock, Activity, Award, CheckCircle, XCircle\n} from \'lucide-react\';\nimport { motion } from \'motion/react\';"
        replacement_content: "  Check, AlertTriangle, Download, Usb, CheckCircle2, Clock, Activity, Award, CheckCircle, XCircle, Printer, FileSpreadsheet\n} from \'lucide-react\';\nimport { motion } from \'motion/react\';\nimport {\n  Chart as ChartJS,\n  CategoryScale,\n  LinearScale,\n  BarElement,\n  Title,\n  Tooltip,\n  Legend,\n  ArcElement\n} from \'chart.js\';\nimport { Bar, Pie } from \'react-chartjs-2\';\n\nChartJS.register(\n  CategoryScale,\n  LinearScale,\n  BarElement,\n  Title,\n  Tooltip,\n  Legend,\n  ArcElement\n);"
      }
      num_matches: 1
    }
    replacement_infos {
      original_chunk {
        target_content: "          {activeTab === \'Staff\' && <StaffView />}\n          {activeTab === \'Trainers\' && <TrainersView />}\n          {activeTab !== \'Dashboard\' && activeTab !== \'Members\' && activeTab !== \'Attendance\' && activeTab !== \'Staff\' && activeTab !== \'Trainers\' && ("
        replacement_content: "          {activeTab === \'Staff\' && <StaffView />}\n          {activeTab === \'Trainers\' && <TrainersView />}\n          {activeTab === \'Reports\' && <ReportsView />}\n          {activeTab !== \'Dashboard\' && activeTab !== \'Members\' && activeTab !== \'Attendance\' && activeTab !== \'Staff\' && activeTab !== \'Trainers\' && activeTab !== \'Reports\' && ("
      }
      num_matches: 1
    }
    replacement_infos {
      original_chunk {
        target_content: "      </div>\n    </div>\n  );\n}\n"
        replacement_content: "      </div>\n    </div>\n  );\n}\n\nfunction ReportsView() {\n  const [tab, setTab] = useState(\'monthly\');\n  return (\n    <div className=\"w-full flex flex-col min-h-full pb-8\">\n      <header className=\"mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n        <h1 className=\"font-heading text-2xl font-bold text-white\">\n          Reports <span className=\"text-[12px] text-text-secondary ml-2 font-normal font-sans\">(\340\244\260\340\244\277\340\244\252\340\245\213\340\244\260\340\245\215\340\244\237)</span>\n        </h1>\n        <div className=\"flex bg-[#0D0D0D] border border-border-color rounded-md overflow-hidden shrink-0\">\n           <button onClick={() => setTab(\'monthly\')} className={`px-4 py-2 text-sm font-semibold transition-colors ${tab === \'monthly\' ? \'bg-primary/10 text-primary\' : \'text-text-secondary hover:text-white\'}`}>Monthly Report</button>\n           <button onClick={() => setTab(\'daily\')} className={`px-4 py-2 text-sm font-semibold transition-colors ${tab === \'daily\' ? \'bg-primary/10 text-primary\' : \'text-text-secondary hover:text-white\'}`}>Daily Report</button>\n           <button onClick={() => setTab(\'member\')} className={`px-4 py-2 text-sm font-semibold transition-colors ${tab === \'member\' ? \'bg-primary/10 text-primary\' : \'text-text-secondary hover:text-white\'}`}>Member Report</button>\n        </div>\n      </header>\n\n      {/* Export Top bar */}\n      <div className=\"flex flex-col sm:flex-row gap-4 justify-between items-center bg-surface border border-border-color p-4 rounded-xl mb-6 shadow-sm\">\n         <div className=\"flex items-center gap-3\">\n           {tab === \'monthly\' && <input type=\"month\" className=\"bg-[#0D0D0D] border border-border-color rounded-md px-3 py-2 text-sm text-white focus:border-primary/50 focus:outline-none [color-scheme:dark]\" defaultValue=\"2026-05\" />}\n           {tab === \'daily\' && <input type=\"date\" className=\"bg-[#0D0D0D] border border-border-color rounded-md px-3 py-2 text-sm text-white focus:border-primary/50 focus:outline-none [color-scheme:dark]\" />}\n         </div>\n         <div className=\"flex gap-2\">\n            <button className=\"flex items-center justify-center gap-2 bg-[#0D0D0D] hover:bg-[#1a1a1a] border border-border-color text-text-secondary hover:text-white px-3 py-2 rounded-md text-sm font-semibold transition-colors\">\n              <Printer size={16} /> Print\n            </button>\n            <button className=\"flex items-center justify-center gap-2 bg-[#0D0D0D] hover:bg-[#1a1a1a] border border-border-color text-red-400 hover:text-red-300 px-3 py-2 rounded-md text-sm font-semibold transition-colors\">\n              <FileText size={16} /> Export PDF\n            </button>\n            <button className=\"flex items-center justify-center gap-2 bg-[#0D0D0D] hover:bg-[#1a1a1a] border border-border-color text-emerald-400 hover:text-emerald-300 px-3 py-2 rounded-md text-sm font-semibold transition-colors\">\n              <FileSpreadsheet size={16} /> Export Excel\n            </button>\n         </div>\n      </div>\n\n      {tab === \'monthly\' && <MonthlyReportTab />}\n      {tab === \'daily\' && <DailyReportTab />}\n      {tab === \'member\' && <MemberReportTab />}\n    </div>\n  );\n}\n\nfunction MonthlyReportTab() {\n  const barData = {\n    labels: Array.from({ length: 30 }, (_, i) => `${i + 1} May`),\n    datasets: [\n      {\n        label: \'Revenue (\342\202\271)\',\n        data: Array.from({ length: 30 }, () => Math.floor(Math.random() * 20000) + 2000),\n        backgroundColor: \'rgba(255, 51, 51, 0.8)\',\n        borderRadius: 4,\n      }\n    ]\n  };\n\n  const barOptions = {\n    responsive: true,\n    maintainAspectRatio: false,\n    plugins: {\n      legend: { display: false },\n    },\n    scales: {\n      y: { grid: { color: \'#333\' } },\n      x: { grid: { display: false } },\n    }\n  };\n\n  const pieData = {\n    labels: [\'Monthly\', \'Quarterly\', \'Half-Yearly\', \'Annual\'],\n    datasets: [\n      {\n        data: [45, 25, 15, 15],\n        backgroundColor: [\n          \'rgba(255, 51, 51, 0.8)\',\n          \'rgba(59, 130, 246, 0.8)\',\n          \'rgba(16, 185, 129, 0.8)\',\n          \'rgba(245, 158, 11, 0.8)\'\n        ],\n        borderColor: \'#0D0D0D\',\n        borderWidth: 2,\n      }\n    ]\n  };\n\n  const pieOptions = {\n    plugins: {\n       legend: { position: \'bottom\' as const, labels: { color: \'#bbb\' } },\n    }\n  };\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Summary Cards */}\n      <div className=\"grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4\">\n        <div className=\"bg-surface border border-border-color p-4 rounded-xl\">\n          <div className=\"text-[11px] text-text-secondary uppercase font-semibold mb-1\">Total Revenue</div>\n          <div className=\"font-heading text-xl font-bold text-white tracking-tight\">\342\202\271 3.4L</div>\n        </div>\n        <div className=\"bg-surface border border-border-color p-4 rounded-xl\">\n          <div className=\"text-[11px] text-text-secondary uppercase font-semibold mb-1\">Cash Revenue</div>\n          <div className=\"font-heading text-xl font-bold text-green-500 tracking-tight\">\342\202\271 85K</div>\n        </div>\n        <div className=\"bg-surface border border-border-color p-4 rounded-xl\">\n          <div className=\"text-[11px] text-text-secondary uppercase font-semibold mb-1\">Online Revenue</div>\n          <div className=\"font-heading text-xl font-bold text-blue-500 tracking-tight\">\342\202\271 2.5L</div>\n        </div>\n        <div className=\"bg-surface border border-border-color p-4 rounded-xl\">\n          <div className=\"text-[11px] text-text-secondary uppercase font-semibold mb-1\">New Members</div>\n          <div className=\"font-heading text-xl font-bold text-white tracking-tight\">42</div>\n        </div>\n        <div className=\"bg-surface border border-border-color p-4 rounded-xl\">\n          <div className=\"text-[11px] text-text-secondary uppercase font-semibold mb-1\">Renewals</div>\n          <div className=\"font-heading text-xl font-bold text-white tracking-tight\">86</div>\n        </div>\n        <div className=\"bg-surface border border-border-color p-4 rounded-xl\">\n          <div className=\"text-[11px] text-text-secondary uppercase font-semibold mb-1\">Total Active</div>\n          <div className=\"font-heading text-xl font-bold text-white tracking-tight\">1,284</div>\n        </div>\n      </div>\n\n      {/* Charts */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n        <div className=\"lg:col-span-2 bg-surface border border-border-color p-5 rounded-xl\">\n          <h3 className=\"font-heading font-semibold text-[14px] text-text-secondary uppercase tracking-tight mb-4\">Revenue Breakdown</h3>\n          <div className=\"h-[250px] w-full\">\n            <Bar data={barData} options={barOptions} />\n          </div>\n        </div>\n        <div className=\"bg-surface border border-border-color p-5 rounded-xl flex flex-col\">\n          <h3 className=\"font-heading font-semibold text-[14px] text-text-secondary uppercase tracking-tight mb-4\">Membership Types</h3>\n          <div className=\"flex-1 flex items-center justify-center min-h-[200px]\">\n             <div className=\"w-[80%] max-w-[250px]\">\n               <Pie data={pieData} options={pieOptions} />\n             </div>\n          </div>\n        </div>\n      </div>\n\n      {/* Table */}\n      <div className=\"bg-surface border border-border-color rounded-xl overflow-hidden\">\n        <div className=\"px-5 py-4 border-b border-border-color flex justify-between items-center bg-[#0D0D0D]/30\">\n          <h3 className=\"font-heading font-semibold text-[14px] text-text-secondary uppercase tracking-tight\">All Transactions</h3>\n        </div>\n        <div className=\"overflow-x-auto\">\n          <table className=\"w-full text-left text-sm whitespace-nowrap\">\n            <thead className=\"bg-[#0D0D0D] border-b border-border-color text-text-secondary text-[11px] uppercase tracking-wider\">\n              <tr>\n                <th className=\"px-5 py-3 font-medium\">Date</th>\n                <th className=\"px-5 py-3 font-medium\">Member Name</th>\n                <th className=\"px-5 py-3 font-medium\">Amount</th>\n                <th className=\"px-5 py-3 font-medium\">Type</th>\n                <th className=\"px-5 py-3 font-medium\">Mode</th>\n                <th className=\"px-5 py-3 font-medium text-right\">Receipt No</th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-border-color\">\n              {[1, 2, 3, 4, 5].map((i) => (\n                <tr key={i} className=\"hover:bg-[#0D0D0D]/50 transition-colors\">\n                  <td className=\"px-5 py-3 text-text-secondary\">04 May 2026</td>\n                  <td className=\"px-5 py-3 font-medium text-white\">Aditi Singh</td>\n                  <td className=\"px-5 py-3 font-mono text-green-500\">\342\202\2712,499</td>\n                  <td className=\"px-5 py-3 text-text-secondary\">{i % 2 === 0 ? \'Renewal\' : \'New\'}</td>\n                  <td className=\"px-5 py-3 text-text-secondary\">{i % 3 === 0 ? \'Cash\' : \'UPI\'}</td>\n                  <td className=\"px-5 py-3 text-right font-mono text-text-secondary\">#INV-0{i}84</td>\n                </tr>\n              ))}\n            </tbody>\n          </table>\n        </div>\n      </div>\n    </div>\n  )\n}\n\nfunction DailyReportTab() {\n  return (\n    <div className=\"space-y-6\">\n      <div className=\"grid grid-cols-2 md:grid-cols-4 gap-4\">\n        <div className=\"bg-surface border border-border-color p-4 rounded-xl relative overflow-hidden group\">\n          <div className=\"absolute -right-4 -bottom-4 opacity-5 group-hover:scale-110 transition-transform\"><IndianRupee size={80} /></div>\n          <div className=\"text-[11px] text-text-secondary uppercase font-semibold mb-1 relative\">Collection Today</div>\n          <div className=\"font-heading text-2xl font-bold text-white tracking-tight relative\">\342\202\271 24,500</div>\n        </div>\n        <div className=\"bg-surface border border-border-color p-4 rounded-xl relative overflow-hidden group\">\n          <div className=\"absolute -right-4 -bottom-4 opacity-5 group-hover:scale-110 transition-transform\"><UserCheck size={80} /></div>\n          <div className=\"text-[11px] text-text-secondary uppercase font-semibold mb-1 relative\">Check-ins</div>\n          <div className=\"font-heading text-2xl font-bold text-white tracking-tight relative\">142</div>\n        </div>\n        <div className=\"bg-surface border border-border-color p-4 rounded-xl relative overflow-hidden group\">\n           <div className=\"absolute -right-4 -bottom-4 opacity-5 group-hover:scale-110 transition-transform\"><UserPlus size={80} /></div>\n          <div className=\"text-[11px] text-text-secondary uppercase font-semibold mb-1 relative\">New Members</div>\n          <div className=\"font-heading text-2xl font-bold text-white tracking-tight relative\">4</div>\n        </div>\n        <div className=\"bg-surface border border-border-color p-4 rounded-xl relative overflow-hidden group\">\n           <div className=\"absolute -right-4 -bottom-4 opacity-5 group-hover:scale-110 transition-transform\"><RefreshCw size={80} /></div>\n          <div className=\"text-[11px] text-text-secondary uppercase font-semibold mb-1 relative\">Renewals</div>\n          <div className=\"font-heading text-2xl font-bold text-white tracking-tight relative\">12</div>\n        </div>\n      </div>\n\n      <div className=\"bg-surface border border-border-color rounded-xl overflow-hidden\">\n        <div className=\"px-5 py-4 border-b border-border-color flex justify-between items-center bg-[#0D0D0D]/30\">\n          <h3 className=\"font-heading font-semibold text-[14px] text-text-secondary uppercase tracking-tight\">Today\'s Transactions</h3>\n        </div>\n        <div className=\"overflow-x-auto\">\n          <table className=\"w-full text-left text-sm whitespace-nowrap\">\n            <thead className=\"bg-[#0D0D0D] border-b border-border-color text-text-secondary text-[11px] uppercase tracking-wider\">\n              <tr>\n                <th className=\"px-5 py-3 font-medium\">Time</th>\n                <th className=\"px-5 py-3 font-medium\">Member Name</th>\n                <th className=\"px-5 py-3 font-medium\">Amount</th>\n                <th className=\"px-5 py-3 font-medium\">Type</th>\n                <th className=\"px-5 py-3 font-medium\">Mode</th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-border-color\">\n              {[\n                { time: \'11:45 AM\', name: \'Rohan Mehra\', amount: \'\342\202\2717,999\', type: \'Renewal\', mode: \'UPI\' },\n                { time: \'10:30 AM\', name: \'Neha Sharma\', amount: \'\342\202\271999\', type: \'New\', mode: \'Cash\' },\n                { time: \'09:15 AM\', name: \'Vikram Mehta\', amount: \'\342\202\2712,499\', type: \'Renewal\', mode: \'Card\' },\n                { time: \'07:05 AM\', name: \'Rahul Verma\', amount: \'\342\202\2714,499\', type: \'Renewal\', mode: \'UPI\' },\n              ].map((t, i) => (\n                <tr key={i} className=\"hover:bg-[#0D0D0D]/50 transition-colors\">\n                  <td className=\"px-5 py-3 text-text-secondary\">{t.time}</td>\n                  <td className=\"px-5 py-3 font-medium text-white\">{t.name}</td>\n                  <td className=\"px-5 py-3 font-mono text-green-500\">{t.amount}</td>\n                  <td className=\"px-5 py-3 text-text-secondary\">{t.type}</td>\n                  <td className=\"px-5 py-3 text-text-secondary\">{t.mode}</td>\n                </tr>\n              ))}\n            </tbody>\n          </table>\n        </div>\n      </div>\n    </div>\n  )\n}\n\nfunction MemberReportTab() {\n  return (\n    <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-6\">\n       <div className=\"space-y-6\">\n         {/* Expiring Soon */}\n         <div className=\"bg-surface border border-orange-500/30 rounded-xl overflow-hidden shadow-[0_0_15px_rgba(249,115,22,0.05)]\">\n            <div className=\"px-5 py-4 border-b border-border-color flex justify-between items-center bg-[#0D0D0D]/30\">\n              <h3 className=\"font-heading font-semibold text-[14px] text-orange-500 uppercase tracking-tight flex items-center gap-2\">\n                <AlertTriangle size={16} /> Expiring This Week\n              </h3>\n              <span className=\"text-xs bg-orange-500/20 text-orange-500 px-2 py-0.5 rounded font-bold\">12 Members</span>\n            </div>\n            <div className=\"p-0\">\n               <table className=\"w-full text-left text-sm whitespace-nowrap\">\n                  <tbody className=\"divide-y divide-border-color\">\n                    {[\'Karan Johar\', \'Sneha Gupta\', \'Manish Pandey\'].map((n, i) => (\n                      <tr key={i} className=\"hover:bg-[#0D0D0D]/50 transition-colors\">\n                        <td className=\"px-5 py-3 text-white font-medium\">{n}</td>\n                        <td className=\"px-5 py-3 text-text-secondary hidden sm:table-cell\">919876543{i}10</td>\n                        <td className=\"px-5 py-3 text-orange-400 font-medium text-right\">in {i+2} days</td>\n                      </tr>\n                    ))}\n                  </tbody>\n               </table>\n            </div>\n         </div>\n\n         {/* Expired */}\n         <div className=\"bg-surface border border-red-500/30 rounded-xl overflow-hidden shadow-[0_0_15px_rgba(255,51,51,0.05)]\">\n            <div className=\"px-5 py-4 border-b border-border-color flex justify-between items-center bg-[#0D0D0D]/30\">\n              <h3 className=\"font-heading font-semibold text-[14px] text-primary uppercase tracking-tight flex items-center gap-2\">\n                <XCircle size={16} /> Already Expired\n              </h3>\n              <span className=\"text-xs bg-primary/20 text-primary px-2 py-0.5 rounded font-bold\">8 Members</span>\n            </div>\n            <div className=\"p-0\">\n               <table className=\"w-full text-left text-sm whitespace-nowrap\">\n                  <tbody className=\"divide-y divide-border-color\">\n                    {[\'Vikram Mehta\', \'Neha Sharma\', \'Raj Kumar\'].map((n, i) => (\n                      <tr key={i} className=\"hover:bg-[#0D0D0D]/50 transition-colors\">\n                        <td className=\"px-5 py-3 text-white font-medium\">{n}</td>\n                        <td className=\"px-5 py-3 text-text-secondary hidden sm:table-cell\">919876543{i}99</td>\n                        <td className=\"px-5 py-3 text-primary font-medium text-right\">yesterday</td>\n                      </tr>\n                    ))}\n                  </tbody>\n               </table>\n            </div>\n         </div>\n       </div>\n\n       <div className=\"space-y-6\">\n         {/* Top Paying */}\n         <div className=\"bg-surface border border-border-color rounded-xl overflow-hidden\">\n            <div className=\"px-5 py-4 border-b border-border-color flex justify-between items-center bg-[#0D0D0D]/30\">\n              <h3 className=\"font-heading font-semibold text-[14px] text-text-secondary uppercase tracking-tight flex items-center gap-2\">\n                <Award size={16} className=\"text-green-500\"/> Top Paying Members\n              </h3>\n            </div>\n            <div className=\"p-0\">\n               <table className=\"w-full text-left text-sm whitespace-nowrap\">\n                  <tbody className=\"divide-y divide-border-color\">\n                    {[{n: \'Deepa Singh\', a: \'\342\202\27142,000\'}, {n: \'Rahul Sharma\', a: \'\342\202\27135,500\'}, {n: \'Arjun Sharma\', a: \'\342\202\27132,000\'}].map((m, i) => (\n                      <tr key={i} className=\"hover:bg-[#0D0D0D]/50 transition-colors\">\n                        <td className=\"px-5 py-3 text-white font-medium\">{i+1}. {m.n}</td>\n                        <td className=\"px-5 py-3 text-text-secondary text-right font-mono text-green-500\">{m.a} (LTV)</td>\n                      </tr>\n                    ))}\n                  </tbody>\n               </table>\n            </div>\n         </div>\n\n         {/* Inactive Members */}\n         <div className=\"bg-surface border border-border-color rounded-xl overflow-hidden\">\n            <div className=\"px-5 py-4 border-b border-border-color flex justify-between items-center bg-[#0D0D0D]/30\">\n              <h3 className=\"font-heading font-semibold text-[14px] text-text-secondary uppercase tracking-tight flex items-center gap-2\">\n                <Clock size={16} /> Inactive &gt; 30 Days\n              </h3>\n            </div>\n            <div className=\"p-0\">\n               <table className=\"w-full text-left text-sm whitespace-nowrap\">\n                  <tbody className=\"divide-y divide-border-color\">\n                    {[\'Sanjay Dutt\', \'Amit Kumar\'].map((n, i) => (\n                      <tr key={i} className=\"hover:bg-[#0D0D0D]/50 transition-colors\">\n                        <td className=\"px-5 py-3 text-white font-medium\">{n}</td>\n                        <td className=\"px-5 py-3 text-text-secondary text-right\">45 days ago</td>\n                      </tr>\n                    ))}\n                  </tbody>\n               </table>\n            </div>\n         </div>\n       </div>\n    </div>\n  )\n}\n"
      }
      num_matches: 6
      error: true
      error_str: "target content not unique in the specified range"
      repair_fixable: true
    }
  }
