  file_change {
    absolute_path_uri: "file:///app/page.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "\'use client\';\n\nimport { useState, useEffect } from \'react\';\nimport { \n  LayoutDashboard, Users, UserCheck, Contact, Dumbbell, \n  LineChart, TicketPercent, Ruler, Star, Settings,\n  Search, Bell, Menu, X, ArrowUpRight, TrendingUp,\n  MoreVertical\n} from \'lucide-react\';\n\nconst navItems = [\n  { name: \'Dashboard\', icon: LayoutDashboard },\n  { name: \'Members\', icon: Users },\n  { name: \'Attendance\', icon: UserCheck },\n  { name: \'Staff\', icon: Contact },\n  { name: \'Trainers\', icon: Dumbbell },\n  { name: \'Reports\', icon: LineChart },\n  { name: \'Offers\', icon: TicketPercent },\n  { name: \'Measurements\', icon: Ruler },\n  { name: \'Reviews\', icon: Star },\n  { name: \'Settings\', icon: Settings },\n];\n\nexport default function CorenixApp() {\n  const [activeTab, setActiveTab] = useState(\'Dashboard\');\n  const [sidebarOpen, setSidebarOpen] = useState(true);\n  const [dateStr, setDateStr] = useState(\'\');\n\n  useEffect(() => {\n    const today = new Date();\n    const options: Intl.DateTimeFormatOptions = { weekday: \'long\', year: \'numeric\', month: \'long\', day: \'numeric\' };\n    setDateStr(today.toLocaleDateString(\'en-US\', options));\n  }, []);\n\n  const toggleSidebar = () => setSidebarOpen(!sidebarOpen);\n\n  return (\n    <div className=\"flex bg-[#0D0D0D] min-h-screen overflow-hidden text-sm\">\n      \n      {/* Sidebar Overlay (Mobile) */}\n      {!sidebarOpen && (\n        <div \n          className=\"lg:hidden fixed inset-0 bg-black/60 z-40 transition-opacity\"\n          onClick={() => setSidebarOpen(true)}\n        ></div>\n      )}\n\n      {/* Sidebar */}\n      <aside \n        className={`fixed lg:relative z-50 h-screen bg-[#0D0D0D] border-r border-border-color transition-all duration-300 flex flex-col ${\n          sidebarOpen ? \'w-64 translate-x-0\' : \'w-64 -translate-x-full lg:w-[80px] lg:translate-x-0\'\n        }`}\n      >\n        <div className=\"flex h-16 items-center px-4 md:px-6 justify-between lg:justify-center border-b border-border-color\">\n          {sidebarOpen ? (\n            <h1 className=\"font-heading font-bold text-2xl tracking-wide text-white uppercase flex items-center gap-2\">\n              Core<span className=\"text-primary\">nix</span>\n            </h1>\n          ) : (\n            <h1 className=\"font-heading font-bold text-2xl text-primary uppercase\">C</h1>\n          )}\n          \n          <button className=\"lg:hidden text-text-secondary hover:text-white\" onClick={toggleSidebar}>\n            <X size={24} />\n          </button>\n        </div>\n\n        <nav className=\"flex-1 overflow-y-auto py-6 px-3 flex flex-col gap-1 no-scrollbar\">\n          {navItems.map((item) => {\n            const Icon = item.icon;\n            const isActive = activeTab === item.name;\n            return (\n              <button\n                key={item.name}\n                onClick={() => setActiveTab(item.name)}\n                className={`flex items-center gap-4 px-3 py-3 rounded-md transition-all duration-200 group ${\n                  isActive \n                    ? \'bg-primary/10 text-white\' \n                    : \'text-text-secondary hover:bg-surface hover:text-white\'\n                }`}\n                title={!sidebarOpen ? item.name : undefined}\n              >\n                <div className={`relative flex items-center justify-center ${isActive ? \'text-primary\' : \'text-text-secondary group-hover:text-white\'}`}>\n                  {isActive && sidebarOpen && (\n                    <div className=\"absolute -left-3 w-1 h-8 rounded-r-md bg-primary\"></div>\n                  )}\n                  {isActive && !sidebarOpen && (\n                    <div className=\"absolute -left-3 w-1 h-8 rounded-r-md bg-primary\"></div>\n                  )}\n                  <Icon size={22} strokeWidth={isActive ? 2.5 : 2} />\n                </div>\n                {sidebarOpen && <span className={`font-medium ${isActive ? \'font-semibold\' : \'\'}`}>{item.name}</span>}\n              </button>\n            );\n          })}\n        </nav>\n      </aside>\n\n      {/* Main Content */}\n      <main className=\"flex-1 flex flex-col h-screen overflow-hidden\">\n        \n        {/* Topbar */}\n        <header className=\"h-16 border-b border-border-color bg-[#0D0D0D]/95 backdrop-blur z-30 flex items-center justify-between px-4 lg:px-8\">\n          <div className=\"flex items-center gap-4\">\n            <button \n              onClick={toggleSidebar}\n              className=\"p-2 rounded-md hover:bg-surface text-text-secondary hover:text-white transition-colors\"\n            >\n              <Menu size={20} />\n            </button>\n            <div className=\"hidden md:flex flex-col\">\n              <span className=\"font-heading font-semibold text-white/90 tracking-wide text-lg\">{activeTab}</span>\n              <span className=\"text-xs text-text-secondary font-medium\">{dateStr}</span>\n            </div>\n          </div>\n\n          <div className=\"flex items-center gap-4 lg:gap-6\">\n            <div className=\"relative hidden sm:block\">\n              <Search className=\"absolute left-3 top-1/2 -translate-y-1/2 text-text-secondary\" size={16} />\n              <input \n                type=\"text\" \n                placeholder=\"Search resources, users...\" \n                className=\"w-64 lg:w-80 bg-surface border border-border-color rounded-full py-2 pl-9 pr-4 text-sm text-white focus:outline-none focus:border-primary/50 focus:ring-1 focus:ring-primary/50 transition-all placeholder:text-text-secondary\"\n              />\n            </div>\n            \n            <button className=\"relative p-2 rounded-full hover:bg-surface text-text-secondary hover:text-white transition-colors\">\n              <Bell size={20} />\n              <span className=\"absolute top-1 right-2 w-2 h-2 bg-primary rounded-full\"></span>\n            </button>\n            \n            <div className=\"flex items-center gap-3 pl-2 lg:pl-4 border-l border-border-color\">\n              <div className=\"w-8 h-8 rounded-full bg-surface border border-border-color flex items-center justify-center overflow-hidden\">\n                <img src={`https://api.dicebear.com/7.x/avataaars/svg?seed=Admin`} alt=\"Admin\" className=\"w-full h-full object-cover\" />\n              </div>\n              <div className=\"hidden md:block\">\n                <p className=\"text-sm font-medium text-white\">Staff Admin</p>\n                <p className=\"text-xs text-text-secondary\">Manager</p>\n              </div>\n            </div>\n          </div>\n        </header>\n\n        {/* Dynamic Content Area */}\n        <div className=\"flex-1 overflow-auto bg-[#0D0D0D] p-4 lg:p-8 no-scrollbar\">\n          {activeTab === \'Dashboard\' && <DashboardView />}\n          {activeTab !== \'Dashboard\' && (\n            <div className=\"h-full flex items-center justify-center flex-col gap-4 text-text-secondary\">\n              <div className=\"p-4 bg-surface rounded-full border border-border-color\">\n                {<Search size={32} className=\"text-border-color\" />}\n              </div>\n              <p className=\"font-heading text-lg\">Module <span className=\"text-white\">\"{activeTab}\"</span> is under construction.</p>\n            </div>\n          )}\n        </div>\n\n        {/* Footer */}\n        <footer className=\"text-center py-4 border-t border-border-color text-xs text-text-secondary tracking-wide\">\n          <span className=\"font-heading text-white/50\">Corenix Club Software</span> | Powered by <span className=\"text-primary/80\">Fit United</span>\n        </footer>\n\n      </main>\n    </div>\n  );\n}\n\nfunction DashboardView() {\n  return (\n    <div className=\"max-w-7xl mx-auto space-y-6\">\n      \n      {/* Stat Cards */}\n      <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4\">\n        <StatCard title=\"Total Members\" value=\"1,248\" trend=\"+12\" icon={Users} trendUp />\n        <StatCard title=\"Active Members\" value=\"892\" trend=\"+4\" icon={UserCheck} trendUp />\n        <StatCard title=\"Total Revenue\" value=\"\342\202\271 4,52,000\" trend=\"+15%\" icon={TrendingUp} trendUp />\n        <StatCard title=\"Expiring Soon\" value=\"45\" trend=\"-2\" icon={TicketPercent} trendUp={false} isAlert />\n      </div>\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n        \n        {/* Main Chart Area Placeholder */}\n        <div className=\"lg:col-span-2 bg-surface border border-border-color rounded-xl p-5 shadow-sm\">\n          <div className=\"flex justify-between items-center mb-6\">\n            <h3 className=\"font-heading font-semibold text-lg text-white\">Revenue Overview</h3>\n            <select className=\"bg-[#0D0D0D] border border-border-color text-xs text-text-secondary rounded-md px-3 py-1.5 outline-none focus:border-primary/50\">\n              <option>This Month</option>\n              <option>Last Month</option>\n              <option>This Year</option>\n            </select>\n          </div>\n          <div className=\"h-64 flex items-end justify-between gap-2 lg:gap-4 mt-8 pb-4\">\n            {/* Mock bar chart */}\n            {[40, 70, 45, 90, 65, 80, 110, 85, 120, 100, 130, 95].map((h, i) => (\n              <div key={i} className=\"flex-1 flex flex-col items-center gap-2 group\">\n                <div className=\"w-full bg-border-color rounded-sm relative overflow-hidden h-[200px]\">\n                  <div \n                    className=\"absolute bottom-0 w-full bg-primary/20 group-hover:bg-primary transition-all duration-500 rounded-sm\"\n                    style={{ height: `${(h / 150) * 100}%` }}\n                  ></div>\n                </div>\n                <span className=\"text-[10px] text-text-secondary uppercase select-none\">\n                  {[\'Jan\', \'Feb\', \'Mar\', \'Apr\', \'May\', \'Jun\', \'Jul\', \'Aug\', \'Sep\', \'Oct\', \'Nov\', \'Dec\'][i]}\n                </span>\n              </div>\n            ))}\n          </div>\n        </div>\n\n        {/* Right Sidebar - Recent Activity */}\n        <div className=\"bg-surface border border-border-color rounded-xl p-5 shadow-sm flex flex-col\">\n          <div className=\"flex justify-between items-center mb-6\">\n            <h3 className=\"font-heading font-semibold text-lg text-white\">Recent Attendance</h3>\n            <button className=\"text-text-secondary hover:text-white\"><MoreVertical size={18} /></button>\n          </div>\n          \n          <div className=\"flex-1 space-y-4\">\n            {[\n              { name: \'Rahul Sharma\', time: \'10:45 AM\', plan: \'Pro Yearly\' },\n              { name: \'Aditi Singh\', time: \'10:30 AM\', plan: \'Basic Monthly\' },\n              { name: \'Vikram Mehta\', time: \'10:12 AM\', plan: \'Pro Monthly\' },\n              { name: \'Priya Patel\', time: \'09:55 AM\', plan: \'Quarterly\' },\n              { name: \'Rohan Gupta\', time: \'09:40 AM\', plan: \'Trial\' },\n            ].map((user, i) => (\n              <div key={i} className=\"flex items-center gap-4 py-2 border-b border-border-color/50 last:border-0 hover:bg-[#0D0D0D]/50 px-2 rounded-md transition-colors -mx-2\">\n                <div className=\"w-10 h-10 rounded-full bg-[#0D0D0D] border border-border-color flex items-center justify-center shrink-0\">\n                  <div className=\"font-heading font-bold text-sm text-primary\">{user.name.charAt(0)}</div>\n                </div>\n                <div className=\"flex-1 min-w-0\">\n                  <p className=\"text-sm font-medium text-white truncate\">{user.name}</p>\n                  <p className=\"text-xs text-text-secondary truncate\">{user.plan}</p>\n                </div>\n                <div className=\"text-xs text-text-secondary whitespace-nowrap text-right\">\n                  {user.time}\n                </div>\n              </div>\n            ))}\n          </div>\n\n          <button className=\"w-full mt-4 py-2 text-xs font-semibold text-primary/90 hover:text-primary hover:bg-primary/10 rounded-md transition-colors flex items-center justify-center gap-1\">\n            View All Register <ArrowUpRight size={14} />\n          </button>\n        </div>\n\n      </div>\n    </div>\n  );\n}\n\nfunction StatCard({ title, value, trend, icon: Icon, trendUp, isAlert = false }: any) {\n  return (\n    <div className=\"bg-surface border border-border-color rounded-xl p-5 shadow-sm hover:border-border-color/80 transition-colors\">\n      <div className=\"flex justify-between items-start mb-4\">\n        <div className={`p-2.5 rounded-lg ${isAlert ? \'bg-primary/10 text-primary\' : \'bg-[#0D0D0D] text-white border border-border-color\'}`}>\n          <Icon size={20} />\n        </div>\n        <div className={`text-xs font-medium px-2 py-1 rounded-full flex items-center gap-1 ${\n          isAlert ? \'bg-red-500/10 text-red-500\' : \'bg-green-500/10 text-green-500\'\n        }`}>\n          {trendUp ? <TrendingUp size={12} /> : <div className=\"rotate-180\"><TrendingUp size={12} /></div>}\n          {trend}\n        </div>\n      </div>\n      <div>\n        <p className=\"text-text-secondary text-sm mb-1\">{title}</p>\n        <h4 className=\"font-heading text-2xl font-bold text-white tracking-tight\">{value}</h4>\n      </div>\n    </div>\n  );\n}\n"
    }
