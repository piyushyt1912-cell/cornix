        lines {
          text: "                  {[\'S\',\'M\',\'T\',\'W\',\'T\',\'F\',\'S\'].map((d,i) => <div key={i} className=\"text-center text-[10px] text-text-secondary font-bold uppercase pb-1\">{d}</div>)}"
