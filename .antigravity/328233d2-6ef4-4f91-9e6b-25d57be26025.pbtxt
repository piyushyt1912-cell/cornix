                 <div \n                    className=\"absolute bottom-0 w-full bg-primary/20 group-hover:bg-primary transition-all duration-500 rounded-[3px]\"\n                    style={{ height: `${(h / 150) * 100}%` }}\n                  ></div>\n                </div>\n                <span className=\"text-[10px] text-text-secondary uppercase select-none\">\n                  {[\'Jan\', \'Feb\', \'Mar\', \'Apr\', \'May\', \'Jun\', \'Jul\', \'Aug\', \'Sep\', \'Oct\', \'Nov\', \'Dec\'][i]}\n                </span>\n              </div>\n            ))}\n          </div>\n        </div>\n\n        {/* Right Sidebar - Recent Activity */}\n        <div className=\"lg:col-span-2 bg-surface border border-border-color rounded-xl flex flex-col h-[360px] overflow-hidden\">\n          <div className=\"px-5 py-4 border-b border-border-color flex justify-between items-center shrink-0\">\n            <h3 className=\"font-heading font-semibold text-[14px] text-text-secondary uppercase tracking-tight\">Recent Check-ins (\340\244\211\340\244\252\340\244\270\340\245\215\340\244\245\340\244\277\340\244\244\340\244\277)</h3>\n            <button className=\"text-[10px] text-primary cursor-pointer hover:underline\">View All</button>\n          </div>\n          \n          <div className=\"flex-1 overflow-y-auto no-scrollbar\">\n            {[\n              { name: \'Arjun Sharma\', info: \'ID: #9822 \342\200\242 Gold Plan\', time: \'06:42 PM\', status: \'Checked In\', statusClass: \'bg-green-500/10 text-green-500\' },\n              { name: \'Priya Patel\', info: \'ID: #9102 \342\200\242 Cardio Special\', time: \'06:38 PM\', status: \'Checked In\', statusClass: \'bg-green-500/10 text-green-500\' },\n              { name: \'Rahul Verma\', info: \'ID: #8721 \342\200\242 PT Session\', time: \'06:15 PM\', status: \'Checked In\', statusClass: \'bg-green-500/10 text-green-500\' },\n              { name: \'Sneha Gupta\', info: \'ID: #1029 \342\200\242 Monthly\', time: \'05:55 PM\', status: \'Checked In\', statusClass: \'bg-green-500/10 text-green-500\' },\n            ].map((user, i) => (\n              <div key={i} className=\"flex justify-between items-center px-5 py-3 border-b border-border-color last:border-0 text-[13px] hover:bg-[#0D0D0D]/30 transition-colors\">\n                <div>\n                  <strong className=\"text-white font-semibold\">{user.name}</strong>\n                  <div className=\"text-[10px] text-text-secondary mt-0.5\">{user.info}</div>\n                </div>\n                <div className=\"text-right flex flex-col items-end gap-1\">\n                  <div className=\"text-text-secondary\">{user.time}</div>\n                  <span className={`px-2 py-0.5 rounded-[4px] text-[11px] font-semibold ${user.statusClass}`}>{user.status}</span>\n                </div>\n              </div>\n            ))}\n          </div>\n        </div>\n\n      </div>\n    </div>\n  );\n}\n\nfunction StatCard({ title, value, trendLabel, trendColor, icon: Icon }: any) {\n  return (\n    <div className=\"bg-surface p-5 rounded-xl border border-border-color\">\n      <div className=\"text-[12px] text-text-secondary uppercase mb-2 flex justify-between items-center\">\n        <span>{title}</span>\n        <Icon size={16} className=\"text-text-secondary opacity-50\" />\n      </div>\n      <div className=\"font-heading text-2xl font-bold text-white leading-tight\">{value}</div>\n      <div className={`text-[10px] mt-2 ${trendColor}`}>\n        {trendLabel}\n      </div>\n    </div>\n  );\n}"
