ry\"></div>\n                  )}\n                  {isActive && !sidebarOpen && (\n                    <div className=\"absolute -left-3 w-1 h-8 rounded-r-md bg-primary\"></div>\n                  )}\n                  <Icon size={22} strokeWidth={isActive ? 2.5 : 2} />\n                </div>\n                {sidebarOpen && <span className={`font-medium ${isActive ? \'font-semibold\' : \'\'}`}>{item.name}</span>}\n              </button>\n            );\n          })}\n        </nav>\n      </aside>"
