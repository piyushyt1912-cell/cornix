      target_content: "function DashboardView() {\n  return (\n    <div className=\"w-full\">\n      <header className=\"mb-6\">\n        <h1 className=\"font-heading text-2xl font-bold text-white\">\n          Dashboard <span className=\"text-[12px] text-text-secondary ml-2 font-normal font-sans\">(\340\244\241\340\245\210\340\244\266\340\244\254\340\245\213\340\244\260\340\245\215\340\244\241)</span>\n        </h1>\n      </header>\n      \n      {/* Stat Cards */}\n      <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-6\">\n        <StatCard title=\"Total Members\" value=\"1,284\" trendLabel=\"+12 this month\" trendColor=\"text-green-500\" icon={Users} />\n        <StatCard title=\"Active Check-ins\" value=\"42\" trendLabel=\"Current live count\" trendColor=\"text-text-secondary\" icon={UserCheck} />\n        <StatCard title=\"Revenue (M)\" value=\"\342\202\271 4,82,500\" trendLabel=\"Target: \342\202\271 5,50,000\" trendColor=\"text-primary\" icon={TrendingUp} />\n        <StatCard title=\"Pending Dues\" value=\"\342\202\271 12,450\" trendLabel=\"8 Members\" trendColor=\"text-primary\" icon={TicketPercent} />\n      </div>\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-5 gap-5\">\n        \n        {/* Main Chart Area Placeholder */}\n        <div className=\"lg:col-span-3 bg-surface border border-border-color rounded-xl flex flex-col h-[360px]\">\n          <div className=\"px-5 py-4 border-b border-border-color flex justify-between items-center\">\n            <h3 className=\"font-heading font-semibold text-[14px] text-text-secondary uppercase tracking-tight\">Revenue Overview</h3>\n            <select className=\"bg-[#0D0D0D] border border-border-color text-xs text-text-secondary rounded-md px-3 py-1.5 outline-none focus:border-primary/50\">\n              <option>This Month</option>\n              <option>Last Month</option>\n              <option>This Year</option>\n            </select>\n          </div>\n          <div className=\"flex-1 flex items-end justify-between gap-2 lg:gap-4 px-5 pt-8 pb-5\">\n            {/* Mock bar chart */}\n            {[40, 70, 45, 90, 65, 80, 110, 85, 120, 100, 130, 95].map((h, i) => (\n              <div key={i} className=\"flex-1 flex flex-col items-center gap-2 group h-full justify-end\">\n                <div className=\"w-full bg-border-color rounded-[3px] relative overflow-hidden h-[80%]\">\n                  <div \n                    className=\"absolute bottom-0 w-full bg-primary/20 group-hover:bg-primary transition-all duration-500 rounded-[3px]\"\n                    style={{ height: `${(h / 150) * 100}%` }}\n                  ></div>\n                </div>\n                <span className=\"text-[10px] text-text-secondary uppercase select-none\">\n                  {[\'Jan\', \'Feb\', \'Mar\', \'Apr\', \'May\', \'Jun\', \'Jul\', \'Aug\', \'Sep\', \'Oct\', \'Nov\', \'Dec\'][i]}\n                </span>\n              </div>\n            ))}\n          </div>\n        </div>\n\n        {/* Right Sidebar - Recent Activity */}\n        <div className=\"lg:col-span-2 bg-surface border border-border-color rounded-xl flex flex-col h-[360px] overflow-hidden\">\n          <div className=\"px-5 py-4 border-b border-border-color flex justify-between items-center shrink-0\">\n            <h3 className=\"font-heading font-semibold text-[14px] text-text-secondary uppercase tracking-tight\">Recent Check-ins (\340\244\211\340\244\252\340\244\270\340\245\215\340\244\245\340\244\277\340\244\244\340\244\277)</h3>\n            <button className=\"text-[10px] text-primary cursor-pointer hover:underline\">View All</button>\n          </div>\n          \n          <div className=\"flex-1 overflow-y-auto no-scrollbar\">\n            {[\n              { name: \'Arjun Sharma\', info: \'ID: #9822 \342\200\242 Gold Plan\', time: \'06:42 PM\', status: \'Checked In\', statusClass: \'bg-green-500/10 text-green-500\' },\n              { name: \'Priya Patel\', info: \'ID: #9102 \342\200\242 Cardio Special\', time: \'06:38 PM\', status: \'Checked In\', statusClass: \'bg-green-500/10 text-green-500\' },\n              { name: \'Rahul Verma\', info: \'ID: #8721 \342\200\242 PT Session\', time: \'06:15 PM\', status: \'Checked In\', statusClass: \'bg-green-500/10 text-green-500\' },\n              { name: \'Sneha Gupta\', info: \'ID: #1029 \342\200\242 Monthly\', time: \'05:55 PM\', status: \'Checked In\', statusClass: \'bg-green-500/10 text-green-500\' },\n            ].map((user, i) => (\n              <div key={i} className=\"flex justify-between items-center px-5 py-3 border-b border-border-color last:border-0 text-[13px] hover:bg-[#0D0D0D]/30 transition-colors\">\n                <div>\n                  <strong className=\"text-white font-semibold\">{user.name}</strong>\n                  <div className=\"text-[10px] text-text-secondary mt-0.5\">{user.info}</div>\n                </div>\n                <div className=\"text-right flex flex-col items-end gap-1\">\n                  <div className=\"text-text-secondary\">{user.time}</div>\n                  <span className={`px-2 py-0.5 rounded-[4px] text-[11px] font-semibold ${user.statusClass}`}>{user.status}</span>\n                </div>\n              </div>\n            ))}\n          </div>\n        </div>\n\n      </div>\n    </div>\n  );\n}\n\nfunction StatCard({ title, value, trendLabel, trendColor, icon: Icon }: any) {\n  return (\n    <div className=\"bg-surface p-5 rounded-xl border border-border-color\">\n      <div className=\"text-[12px] text-text-secondary uppercase mb-2 flex justify-between items-center\">\n        <span>{title}</span>\n        <Icon size={16} className=\"text-text-secondary opacity-50\" />\n      </div>\n      <div className=\"font-heading text-2xl font-bold text-white leading-tight\">{value}</div>\n      <div className={`text-[10px] mt-2 ${trendColor}`}>\n        {trendLabel}\n      </div>\n    </div>\n  );\n}"
      replacement_content: "function DashboardView() {\n  const container = {\n    hidden: { opacity: 0 },\n    show: {\n      opacity: 1,\n      transition: { staggerChildren: 0.1 }\n    }\n  };\n\n  const item = {\n    hidden: { opacity: 0, y: 20 },\n    show: { opacity: 1, y: 0, transition: { type: \"spring\", stiffness: 300, damping: 24 } }\n  };\n\n  const birthdays = [\n    { name: \'Rahul Sharma\', phone: \'919876543210\', plan: \'Pro Yearly\' },\n    { name: \'Sneha Gupta\', phone: \'919876543211\', plan: \'Cardio Special\' },\n  ];\n\n  const recentVisits = [\n    { name: \'Arjun Sharma\', time: \'06:42 PM\', plan: \'Gold Plan\', status: \'Active\' },\n    { name: \'Priya Patel\', time: \'06:38 PM\', plan: \'Cardio Special\', status: \'Active\' },\n    { name: \'Rahul Verma\', time: \'06:15 PM\', plan: \'PT Session\', status: \'Active\' },\n    { name: \'Karan Johar\', time: \'05:55 PM\', plan: \'Monthly\', status: \'Expired\' },\n    { name: \'Aditi Singh\', time: \'05:30 PM\', plan: \'Quarterly\', status: \'Active\' },\n    { name: \'Vikram Mehta\', time: \'05:12 PM\', plan: \'Pro Monthly\', status: \'Active\' },\n    { name: \'Neha Sharma\', time: \'04:55 PM\', plan: \'Trial\', status: \'Expired\' },\n    { name: \'Rohan Mehra\', time: \'04:40 PM\', plan: \'Gold Yearly\', status: \'Active\' },\n    { name: \'Ananya Roy\', time: \'04:15 PM\', plan: \'Pro Monthly\', status: \'Active\' },\n    { name: \'Amit Kumar\', time: \'04:00 PM\', plan: \'Monthly\', status: \'Active\' },\n  ];\n\n  return (\n    <div className=\"w-full pb-8\">\n      <header className=\"mb-6\">\n        <h1 className=\"font-heading text-2xl font-bold text-white\">\n          Dashboard <span className=\"text-[12px] text-text-secondary ml-2 font-normal font-sans\">(\340\244\241\340\245\210\340\244\266\340\244\254\340\245\213\340\244\260\340\245\215\340\244\241)</span>\n        </h1>\n      </header>\n      \n      <motion.div \n        variants={container}\n        initial=\"hidden\"\n        animate=\"show\"\n        className=\"space-y-6\"\n      >\n        {/* ROW 1 - 4 Stat Cards */}\n        <motion.div variants={item} className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5\">\n          <StatCard \n            title=\"Today\'s Total Sales\" \n            value=\"\342\202\271 24,500\" \n            valueColor=\"text-primary\"\n            trendLabel=\"+12% vs yesterday\" \n            trendColor=\"text-green-500\" \n            icon={IndianRupee} \n          />\n          <StatCard \n            title=\"Cash Collected\" \n            value=\"\342\202\271 8,500\" \n            valueColor=\"text-green-500\"\n            trendLabel=\"Across 3 transactions\" \n            trendColor=\"text-text-secondary\" \n            icon={Banknote} \n          />\n          <StatCard \n            title=\"Online Collected\" \n            value=\"\342\202\271 16,000\" \n            valueColor=\"text-blue-500\"\n            trendLabel=\"UPI & Cards\" \n            trendColor=\"text-text-secondary\" \n            icon={CreditCard} \n          />\n          <StatCard \n            title=\"Active Members Today\" \n            value=\"142\" \n            trendLabel=\"Checked in so far\" \n            trendColor=\"text-text-secondary\" \n            icon={Users} \n          />\n        </motion.div>\n\n        {/* ROW 2 - 3 Stat Cards */}\n        <motion.div variants={item} className=\"grid grid-cols-1 sm:grid-cols-3 gap-5\">\n          <StatCard title=\"Total Members\" value=\"1,284\" trendLabel=\"+12 this month\" trendColor=\"text-green-500\" icon={Users} />\n          <StatCard title=\"New Today\" value=\"4\" trendLabel=\"Fresh enrollments\" trendColor=\"text-primary\" icon={UserPlus} />\n          <StatCard title=\"Renewals Today\" value=\"12\" trendLabel=\"Expiring soon saved\" trendColor=\"text-green-500\" icon={RefreshCw} />\n        </motion.div>\n\n        <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n          \n          {/* Birthdays Section */}\n          <motion.div variants={item} className=\"bg-surface border border-border-color rounded-xl flex flex-col overflow-hidden\">\n            <div className=\"px-5 py-4 border-b border-border-color flex justify-between items-center bg-primary/5\">\n              <h3 className=\"font-heading font-semibold text-[15px] text-primary uppercase tracking-tight flex items-center gap-2\">\n                <Gift size={18} /> Birthdays Today\n              </h3>\n              <span className=\"text-xs bg-primary/20 text-primary px-2 py-1 rounded-md font-bold\">{birthdays.length}</span>\n            </div>\n            \n            <div className=\"flex-1 overflow-y-auto no-scrollbar p-3 space-y-3\">\n              {birthdays.map((user, i) => {\n                const message = encodeURIComponent(`Happy Birthday ${user.name}! \360\237\216\211 Wishing you great health and gains! - Corenix Team`);\n                const whatsappUrl = `https://wa.me/${user.phone}?text=${message}`;\n                return (\n                  <div key={i} className=\"bg-[#0D0D0D] border border-border-color p-4 rounded-lg flex flex-col gap-3\">\n                    <div>\n                      <strong className=\"text-white text-sm block\">{user.name}</strong>\n                      <span className=\"text-[11px] text-text-secondary mt-1\">{user.plan}</span>\n                    </div>\n                    <a \n                      href={whatsappUrl}\n                      target=\"_blank\"\n                      rel=\"noopener noreferrer\"\n                      className=\"w-full flex items-center justify-center gap-2 bg-green-600 hover:bg-green-500 text-white text-xs font-semibold py-2 rounded-md transition-colors\"\n                    >\n                      <MessageCircle size={14} /> Send Wish\n                    </a>\n                  </div>\n                );\n              })}\n              {birthdays.length === 0 && (\n                <div className=\"text-center text-text-secondary text-sm py-8\">\n                  No birthdays today.\n                </div>\n              )}\n            </div>\n          </motion.div>\n\n          {/* Visit Log Table */}\n          <motion.div variants={item} className=\"lg:col-span-2 bg-surface border border-border-color rounded-xl flex flex-col overflow-hidden\">\n            <div className=\"px-5 py-4 border-b border-border-color flex justify-between items-center bg-[#0D0D0D]/30\">\n              <h3 className=\"font-heading font-semibold text-[14px] text-text-secondary uppercase tracking-tight\">Today\'s Visit Log</h3>\n              <span className=\"text-[10px] bg-surface border border-border-color px-2 py-1 rounded text-text-secondary\">Last 10 Check-ins</span>\n            </div>\n            \n            <div className=\"overflow-x-auto\">\n              <table className=\"w-full text-left text-sm whitespace-nowrap\">\n                <thead className=\"bg-[#0D0D0D] border-b border-border-color text-text-secondary text-[11px] uppercase tracking-wider\">\n                  <tr>\n                    <th className=\"px-5 py-3 font-medium\">Member Name</th>\n                    <th className=\"px-5 py-3 font-medium\">Time In</th>\n                    <th className=\"px-5 py-3 font-medium\">Membership Type</th>\n                    <th className=\"px-5 py-3 font-medium text-right\">Status</th>\n                  </tr>\n                </thead>\n                <tbody className=\"divide-y divide-border-color\">\n                  {recentVisits.map((visit, i) => (\n                    <tr key={i} className=\"hover:bg-[#0D0D0D]/50 transition-colors\">\n                      <td className=\"px-5 py-3 font-medium text-white\">{visit.name}</td>\n                      <td className=\"px-5 py-3 text-text-secondary\">{visit.time}</td>\n                      <td className=\"px-5 py-3 text-text-secondary text-[12px]\">{visit.plan}</td>\n                      <td className=\"px-5 py-3 text-right\">\n                        <span className={`inline-flex items-center px-2 py-1 rounded-[4px] text-[10px] font-bold uppercase tracking-wider ${\n                          visit.status === \'Active\' \n                            ? \'bg-green-500/10 text-green-500\' \n                            : \'bg-red-500/10 text-primary\'\n                        }`}>\n                          {visit.status}\n                        </span>\n                      </td>\n                    </tr>\n                  ))}\n                </tbody>\n              </table>\n            </div>\n          </motion.div>\n\n        </div>\n      </motion.div>\n    </div>\n  );\n}\n\nfunction StatCard({ title, value, valueColor = \"text-white\", trendLabel, trendColor, icon: Icon }: any) {\n  return (\n    <div className=\"bg-surface p-5 rounded-xl border border-border-color hover:border-border-color/80 transition-colors\">\n      <div className=\"text-[12px] text-text-secondary uppercase mb-3 flex justify-between items-center\">\n        <span className=\"font-semibold tracking-wide\">{title}</span>\n        <Icon size={18} className=\"text-text-secondary opacity-50\" />\n      </div>\n      <div className={`font-heading text-3xl font-bold leading-tight ${valueColor}`}>{value}</div>\n      <div className={`text-[11px] mt-2 font-medium ${trendColor}`}>\n        {trendLabel}\n      </div>\n    </div>\n  );\n}"
