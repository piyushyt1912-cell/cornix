  file_change {
    absolute_path_uri: "file:///app/page.tsx"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "}"
      replacement_content: "}\n\nconst TODAY_VISITS = [\n  { id: \'1\', name: \'Arjun Sharma\', phone: \'919876543217\', time: \'06:42 PM\', plan: \'Annual\', status: \'Active\' },\n  { id: \'2\', name: \'Priya Patel\', phone: \'919876543213\', time: \'06:38 PM\', plan: \'Cardio Special\', status: \'Active\' },\n  { id: \'3\', name: \'Rahul Verma\', phone: \'919876543220\', time: \'06:15 PM\', plan: \'PT Session\', status: \'Active\' },\n  { id: \'4\', name: \'Sneha Gupta\', phone: \'919876543211\', time: \'05:55 PM\', plan: \'Monthly\', status: \'Expiring Soon\' },\n  { id: \'5\', name: \'Aditi Singh\', phone: \'919876543215\', time: \'05:30 PM\', plan: \'Quarterly\', status: \'Active\' },\n  { id: \'6\', name: \'Vikram Mehta\', phone: \'919876543212\', time: \'05:12 PM\', plan: \'Pro Monthly\', status: \'Active\' },\n  { id: \'7\', name: \'Neha Sharma\', phone: \'919876543216\', time: \'04:55 PM\', plan: \'Trial\', status: \'Expired\' },\n  { id: \'8\', name: \'Rohan Mehra\', phone: \'919876543223\', time: \'04:40 PM\', plan: \'Gold Yearly\', status: \'Active\' },\n  { id: \'9\', name: \'Ananya Roy\', phone: \'919876543224\', time: \'04:15 PM\', plan: \'Pro Monthly\', status: \'Active\' },\n  { id: \'10\', name: \'Amit Kumar\', phone: \'919876543225\', time: \'04:00 PM\', plan: \'Monthly\', status: \'Active\' },\n  { id: \'11\', name: \'Karan Johar\', phone: \'919876543214\', time: \'03:45 PM\', plan: \'Half-Yearly\', status: \'Expiring Soon\' },\n  { id: \'12\', name: \'Raj Kumar\', phone: \'919876543226\', time: \'03:10 PM\', plan: \'Monthly\', status: \'Expired\' },\n  { id: \'13\', name: \'Manish Pandey\', phone: \'919876543227\', time: \'02:50 PM\', plan: \'Quarterly\', status: \'Active\' },\n  { id: \'14\', name: \'Deepa Singh\', phone: \'919876543228\', time: \'02:30 PM\', plan: \'Annual\', status: \'Active\' },\n  { id: \'15\', name: \'Sanjay Dutt\', phone: \'919876543229\', time: \'02:00 PM\', plan: \'Monthly\', status: \'Active\' },\n];\n\nfunction AttendanceView() {\n  const [tab, setTab] = useState(\'today\');\n  const [search, setSearch] = useState(\'\');\n  const [checkInMember, setCheckInMember] = useState<any>(null);\n  const [checkInStatus, setCheckInStatus] = useState<\'none\' | \'success\'>(\'none\');\n\n  const handleSearchChange = (e: any) => {\n    setSearch(e.target.value);\n    setCheckInStatus(\'none\');\n    if (e.target.value.length > 2) {\n      const match = MOCK_MEMBERS.find((m: any) => m.name.toLowerCase().includes(e.target.value.toLowerCase()) || m.phone.includes(e.target.value));\n      setCheckInMember(match || null);\n    } else {\n      setCheckInMember(null);\n    }\n  }\n\n  const handleCheckIn = () => {\n     setCheckInStatus(\'success\');\n     setSearch(\'\');\n  }\n\n  const renderTable = (data: any[], title: string, totalCount: number) => (\n    <div className=\"bg-surface border border-border-color rounded-xl flex flex-col h-[760px]\">\n      <div className=\"px-5 py-4 border-b border-border-color flex justify-between items-center bg-[#0D0D0D]/30 shrink-0\">\n        <h3 className=\"font-heading font-semibold text-[14px] text-text-secondary uppercase tracking-tight\">{title}</h3>\n        <div className=\"flex items-center gap-4\">\n          <span className=\"hidden sm:inline-flex text-xs font-semibold text-primary bg-primary/10 px-3 py-1.5 rounded-md\">\n            Total visitors today: {totalCount}\n          </span>\n          <button className=\"flex items-center gap-1.5 text-xs font-semibold text-white bg-surface hover:bg-[#222] border border-border-color px-3 py-1.5 rounded-md transition-colors\">\n            <Download size={14} /> Export CSV\n          </button>\n        </div>\n      </div>\n      <div className=\"flex-1 overflow-auto no-scrollbar\">\n          <table className=\"w-full text-left text-sm whitespace-nowrap\">\n            <thead className=\"bg-[#0D0D0D] border-b border-border-color text-text-secondary text-[11px] uppercase tracking-wider sticky top-0 z-10\">\n              <tr>\n                <th className=\"px-5 py-3 font-medium\">Sr No</th>\n                <th className=\"px-5 py-3 font-medium\">Member Name</th>\n                <th className=\"px-5 py-3 font-medium\">Phone</th>\n                <th className=\"px-5 py-3 font-medium\">Check-in Time</th>\n                <th className=\"px-5 py-3 font-medium\">Membership Type</th>\n                <th className=\"px-5 py-3 font-medium text-right\">Status</th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-border-color\">\n              {data.map((visit, index) => (\n                <tr key={visit.id} className=\"hover:bg-[#0D0D0D]/50 transition-colors\">\n                  <td className=\"px-5 py-3 text-text-secondary\">{index + 1}</td>\n                  <td className=\"px-5 py-3 font-medium text-white\">{visit.name}</td>\n                  <td className=\"px-5 py-3 text-text-secondary font-mono text-xs\">{visit.phone}</td>\n                  <td className=\"px-5 py-3 text-white font-medium\">{visit.time}</td>\n                  <td className=\"px-5 py-3 text-text-secondary\">{visit.plan}</td>\n                  <td className=\"px-5 py-3 text-right\">\n                      <span className={`inline-flex items-center px-2 py-1 rounded-[4px] text-[10px] font-bold uppercase tracking-wider ${\n                        visit.status === \'Active\' ? \'bg-green-500/10 text-green-500\' :\n                        visit.status === \'Expired\' ? \'bg-red-500/10 text-primary\' :\n                        \'bg-orange-500/10 text-orange-500\'\n                      }`}>\n                        {visit.status}\n                      </span>\n                  </td>\n                </tr>\n              ))}\n            </tbody>\n          </table>\n      </div>\n    </div>\n  );\n\n  return (\n    <div className=\"w-full flex flex-col min-h-full pb-8\">\n      <header className=\"mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n        <h1 className=\"font-heading text-2xl font-bold text-white\">\n          Attendance <span className=\"text-[12px] text-text-secondary ml-2 font-normal font-sans\">(\340\244\211\340\244\252\340\244\270\340\245\215\340\244\245\340\244\277\340\244\244\340\244\277)</span>\n        </h1>\n        <div className=\"flex bg-[#0D0D0D] border border-border-color rounded-md overflow-hidden shrink-0\">\n           <button onClick={() => setTab(\'today\')} className={`px-4 py-2 text-sm font-semibold transition-colors ${tab === \'today\' ? \'bg-primary/10 text-primary\' : \'text-text-secondary hover:text-white\'}`}>Today\'s Log</button>\n           <button onClick={() => setTab(\'history\')} className={`px-4 py-2 text-sm font-semibold transition-colors ${tab === \'history\' ? \'bg-primary/10 text-primary\' : \'text-text-secondary hover:text-white\'}`}>History & Heatmap</button>\n        </div>\n      </header>\n\n      {tab === \'today\' ? (\n        <div className=\"grid grid-cols-1 xl:grid-cols-3 gap-6\">\n          <div className=\"xl:col-span-1 space-y-6\">\n            \n            {/* Quick Check-in Panel */}\n            <div className=\"bg-surface border border-border-color rounded-xl p-6 shadow-sm\">\n              <h2 className=\"font-heading font-semibold text-[15px] text-text-secondary uppercase tracking-tight mb-4\">Quick Check-in</h2>\n              <div className=\"relative mb-4\">\n                <Search className=\"absolute left-3 top-1/2 -translate-y-1/2 text-text-secondary\" size={18} />\n                <input \n                  type=\"text\" \n                  placeholder=\"Enter Member Name or Phone...\" \n                  value={search}\n                  onChange={handleSearchChange}\n                  className=\"w-full bg-[#0D0D0D] border border-border-color rounded-md py-3 pl-10 pr-4 text-sm text-white focus:outline-none focus:border-primary/50 placeholder:text-text-secondary/70\"\n                />\n              </div>\n              \n              {checkInMember && checkInStatus === \'none\' && (\n                <div className=\"mt-4 p-4 border border-border-color rounded-lg bg-[#0D0D0D]\">\n                  <div className=\"flex items-center gap-4 mb-4\">\n                    <div className=\"w-12 h-12 rounded-full bg-surface border border-border-color text-primary flex items-center justify-center font-heading font-bold text-lg uppercase shrink-0\">\n                      {checkInMember.name.split(\' \').map((n: string) => n[0]).join(\'\')}\n                    </div>\n                    <div>\n                      <strong className=\"text-white block\">{checkInMember.name}</strong>\n                      <span className=\"text-xs text-text-secondary\">{checkInMember.phone} \342\200\242 {checkInMember.plan}</span>\n                    </div>\n                  </div>\n                  \n                  {checkInMember.status === \'Expired\' ? (\n                    <div className=\"bg-primary/10 border border-primary/20 text-primary text-[11px] font-semibold leading-relaxed p-3 rounded-md flex items-start gap-2 mb-2\">\n                        <AlertTriangle size={16} className=\"shrink-0 mt-0.5\" />\n                        <span>Membership expired on {checkInMember.expiryDate}. Please renew.</span>\n                    </div>\n                  ) : (\n                    <button onClick={handleCheckIn} className=\"w-full bg-green-600 hover:bg-green-500 text-white font-semibold py-3 rounded-md flex items-center justify-center gap-2 transition-colors\">\n                        <Check size={18} strokeWidth={3} /> Mark Attendance\n                    </button>\n                  )}\n                </div>\n              )}\n\n              {checkInStatus === \'success\' && checkInMember && (\n                <div className=\"mt-4 p-5 border border-green-500/30 rounded-lg bg-green-500/10 text-center flex flex-col items-center\">\n                  <CheckCircle2 size={32} className=\"text-green-500 mb-2\" />\n                  <p className=\"text-white font-semibold mb-1\">Welcome, {checkInMember.name}!</p>\n                  <p className=\"text-green-500 text-sm\">Have a great workout \360\237\222\252</p>\n                </div>\n              )}\n            </div>\n\n            {/* Fingerprint Panel */}\n            <div className=\"bg-surface border border-border-color rounded-xl p-6 shadow-sm\">\n              <div className=\"flex items-start gap-4 mb-4\">\n                  <div className=\"p-3 bg-[#0D0D0D] border border-border-color rounded-lg text-text-secondary shrink-0\">\n                    <Fingerprint size={24} />\n                  </div>\n                  <div>\n                    <h2 className=\"font-heading font-semibold text-[15px] text-white uppercase tracking-tight\">Biometric System</h2>\n                    <div className=\"flex items-center gap-2 mt-1.5\">\n                        <div className=\"w-2 h-2 rounded-full bg-orange-500 animate-pulse\"></div>\n                        <span className=\"text-[11px] text-orange-500 font-bold uppercase tracking-wider\">Disconnected</span>\n                    </div>\n                  </div>\n              </div>\n              <p className=\"text-[13px] text-text-secondary leading-relaxed\">\n                  Fingerprint device integration ready. Connect USB fingerprint scanner to enable auto check-in.\n              </p>\n              <button className=\"mt-5 w-full bg-[#0D0D0D] border border-border-color hover:bg-[#1a1a1a] text-white text-[13px] font-semibold py-2.5 rounded-md flex items-center justify-center gap-2 transition-colors\">\n                <Usb size={16} /> Connect Device\n              </button>\n            </div>\n\n          </div>\n\n          <div className=\"xl:col-span-2\">\n             {renderTable(TODAY_VISITS, \"Today\'s Attendance Log\", 47)}\n          </div>\n        </div>\n      ) : (\n        <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n          <div className=\"lg:col-span-1 space-y-6\">\n            <div className=\"bg-surface border border-border-color rounded-xl p-6\">\n              <h3 className=\"font-heading font-semibold text-[14px] text-text-secondary uppercase tracking-tight mb-4 flex items-center gap-2\"><Calendar size={16}/> Select Date</h3>\n              <input type=\"date\" className=\"w-full bg-[#0D0D0D] border border-border-color rounded-md px-3 py-2 text-sm text-white focus:border-primary/50 focus:outline-none [color-scheme:dark]\" />\n            </div>\n            \n            <div className=\"bg-surface border border-border-color rounded-xl p-6\">\n              <h3 className=\"font-heading font-semibold text-[14px] text-text-secondary uppercase tracking-tight mb-4\">Monthly Footfall Heatmap</h3>\n              <div className=\"grid grid-cols-7 gap-1.5\">\n                  {[\'S\',\'M\',\'T\',\'W\',\'T\',\'F\',\'S\'].map((d,i) => <div key={i} className=\"text-center text-[10px] text-text-secondary font-bold uppercase pb-1\">{d}</div>)}\n                  {Array.from({length: 31}).map((_, i) => {\n                    // pseudo-random intensity 0-4 based on index\n                    const intensity = (i * 7 + 3) % 5;\n                    const colors = [\'bg-[#0D0D0D]\', \'bg-primary/20\', \'bg-primary/40\', \'bg-primary/70\', \'bg-primary\'];\n                    return (\n                      <div key={i} className={`aspect-square rounded-[3px] border border-border-color/50 ${colors[intensity]}`} title={`Day ${i+1}: ${intensity * 12} visitors`}></div>\n                    )\n                  })}\n              </div>\n              <div className=\"flex items-center justify-between text-[10px] text-text-secondary uppercase font-semibold mt-4\">\n                 <span>Less</span>\n                 <div className=\"flex gap-1\">\n                    {[\'bg-[#0D0D0D]\', \'bg-primary/20\', \'bg-primary/40\', \'bg-primary/70\', \'bg-primary\'].map((c, i) => (\n                      <div key={i} className={`w-3 h-3 rounded-[2px] ${c}`}></div>\n                    ))}\n                 </div>\n                 <span>More</span>\n              </div>\n            </div>\n          </div>\n          <div className=\"lg:col-span-2\">\n             {renderTable(TODAY_VISITS.slice(0, 5), \"Past Attendance Log\", 5)}\n          </div>\n        </div>\n      )}\n    </div>\n  );\n}"
    }
    instruction: "Add AttendanceView component"
  }
}
