      replacement_content: "         </div>\n       </div>\n    </div>\n  )\n}\n\nfunction OffersView() {\n  return (\n    <div className=\"w-full flex flex-col min-h-full pb-8\">\n      <header className=\"mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n        <h1 className=\"font-heading text-2xl font-bold text-white\">\n          Offers & Promotions\n        </h1>\n        <div className=\"flex gap-2\">\n          <button className=\"flex items-center gap-2 bg-primary hover:bg-primary/90 text-[#000] px-4 py-2 rounded-md text-sm font-bold transition-colors\">\n            <Plus size={16} strokeWidth={3} /> Create Offer\n          </button>\n        </div>\n      </header>\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8\">\n        <div className=\"lg:col-span-2 space-y-6\">\n           <div className=\"bg-surface border border-border-color p-5 rounded-xl\">\n             <h3 className=\"font-heading font-semibold text-[14px] text-text-secondary uppercase tracking-tight mb-4\">Create New Offer</h3>\n             <form className=\"space-y-4\">\n                <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n                   <div className=\"space-y-2\">\n                      <label className=\"text-xs text-text-secondary font-semibold uppercase\">Offer Title</label>\n                      <input type=\"text\" className=\"w-full bg-[#0D0D0D] border border-border-color rounded-md px-3 py-2 text-sm text-white focus:border-primary/50 focus:outline-none\" placeholder=\"e.g. Summer Special 20% Off\" />\n                   </div>\n                   <div className=\"space-y-2\">\n                      <label className=\"text-xs text-text-secondary font-semibold uppercase\">Valid Till</label>\n                      <input type=\"date\" className=\"w-full bg-[#0D0D0D] border border-border-color rounded-md px-3 py-2 text-sm text-white focus:border-primary/50 focus:outline-none [color-scheme:dark]\" />\n                   </div>\n                </div>\n                <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n                   <div className=\"space-y-2\">\n                      <label className=\"text-xs text-text-secondary font-semibold uppercase\">Discount (%)</label>\n                      <input type=\"number\" className=\"w-full bg-[#0D0D0D] border border-border-color rounded-md px-3 py-2 text-sm text-white focus:border-primary/50 focus:outline-none\" placeholder=\"20\" />\n                   </div>\n                   <div className=\"space-y-2\">\n                      <label className=\"text-xs text-text-secondary font-semibold uppercase\">Target Group</label>\n                      <select className=\"w-full bg-[#0D0D0D] border border-border-color rounded-md px-3 py-2 text-sm text-white focus:border-primary/50 focus:outline-none\">\n                         <option>All Members</option>\n                         <option>Expiring This Month</option>\n                         <option>Inactive Members</option>\n                         <option>Specific Member</option>\n                      </select>\n                   </div>\n                </div>\n                <div className=\"space-y-2\">\n                   <label className=\"text-xs text-text-secondary font-semibold uppercase\">Description (Optional)</label>\n                   <textarea className=\"w-full bg-[#0D0D0D] border border-border-color rounded-md px-3 py-2 text-sm text-white focus:border-primary/50 focus:outline-none\" rows={2} placeholder=\"Terms and conditions...\"></textarea>\n                </div>\n                \n                <div className=\"pt-4 border-t border-border-color\">\n                   <h4 className=\"text-sm font-semibold text-white mb-3 flex items-center gap-2\"><MessageCircle size={16}/> Send Via</h4>\n                   <div className=\"flex gap-4\">\n                     <label className=\"flex items-center gap-2 cursor-pointer\">\n                        <input type=\"checkbox\" className=\"accent-green-500 w-4 h-4\" defaultChecked />\n                        <span className=\"text-sm text-text-secondary\">WhatsApp Broadcast</span>\n                     </label>\n                     <label className=\"flex items-center gap-2 cursor-pointer\">\n                        <input type=\"checkbox\" className=\"accent-primary w-4 h-4\" />\n                        <span className=\"text-sm text-text-secondary\">SMS</span>\n                     </label>\n                   </div>\n                </div>\n             </form>\n           </div>\n        </div>\n        \n        <div className=\"space-y-6\">\n           <div className=\"bg-surface border border-border-color p-5 rounded-xl\">\n             <h3 className=\"font-heading font-semibold text-[14px] text-text-secondary uppercase tracking-tight mb-4\">Quick Templates</h3>\n             <div className=\"flex flex-col gap-3\">\n               <button className=\"flex items-center gap-3 p-3 bg-[#0D0D0D] rounded-lg border border-border-color text-left hover:border-primary/50 transition-colors group\">\n                 <div className=\"w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center text-primary group-hover:bg-primary group-hover:text-[#0D0D0D] transition-colors\"><Gift size={20} /></div>\n                 <div>\n                    <div className=\"text-sm font-bold text-white\">Birthday Offer</div>\n                    <div className=\"text-xs text-text-secondary\">Send automated 20% off</div>\n                 </div>\n               </button>\n               <button className=\"flex items-center gap-3 p-3 bg-[#0D0D0D] rounded-lg border border-border-color text-left hover:border-primary/50 transition-colors group\">\n                 <div className=\"w-10 h-10 rounded-full bg-orange-500/10 flex items-center justify-center text-orange-500 group-hover:bg-orange-500 group-hover:text-white transition-colors\"><Star size={20} /></div>\n                 <div>\n                    <div className=\"text-sm font-bold text-white\">Festival Special</div>\n                    <div className=\"text-xs text-text-secondary\">Flat \342\202\2711000 off on yearly</div>\n                 </div>\n               </button>\n               <button className=\"flex items-center gap-3 p-3 bg-[#0D0D0D] rounded-lg border border-border-color text-left hover:border-primary/50 transition-colors group\">\n                 <div className=\"w-10 h-10 rounded-full bg-blue-500/10 flex items-center justify-center text-blue-500 group-hover:bg-blue-500 group-hover:text-white transition-colors\"><Users size={20} /></div>\n                 <div>\n                    <div className=\"text-sm font-bold text-white\">Referral Program</div>\n                    <div className=\"text-xs text-text-secondary\">1 free month for bringing a friend</div>\n                 </div>\n               </button>\n             </div>\n           </div>\n\n           <div className=\"bg-[#0D0D0D] border border-border-color p-4 rounded-xl relative overflow-hidden\">\n             <div className=\"absolute top-0 right-0 p-2 opacity-10\"><MessageCircle size={100} /></div>\n             <h4 className=\"text-xs font-semibold text-text-secondary uppercase mb-2 relative\">WhatsApp Preview</h4>\n             <div className=\"bg-[#1a1a1a] rounded-lg p-3 text-sm text-white/90 relative shadow-inner border border-border-color/50\">\n               Hey [Name]! \360\237\221\213<br/><br/>\n               Grab our Summer Special 20% Off on all renewals!<br/><br/>\n               Valid till: 30 May<br/><br/>\n               Reply YES to claim.\n             </div>\n           </div>\n        </div>\n      </div>\n\n      <div className=\"bg-surface border border-border-color rounded-xl overflow-hidden\">\n        <div className=\"px-5 py-4 border-b border-border-color flex justify-between items-center bg-[#0D0D0D]/30\">\n          <h3 className=\"font-heading font-semibold text-[14px] text-text-secondary uppercase tracking-tight\">Offer History</h3>\n        </div>\n        <div className=\"overflow-x-auto\">\n          <table className=\"w-full text-left text-sm whitespace-nowrap\">\n            <thead className=\"bg-[#0D0D0D] border-b border-border-color text-text-secondary text-[11px] uppercase tracking-wider\">\n              <tr>\n                <th className=\"px-5 py-3 font-medium\">Offer Name</th>\n                <th className=\"px-5 py-3 font-medium\">Target</th>\n                <th className=\"px-5 py-3 font-medium\">Sent Date</th>\n                <th className=\"px-5 py-3 font-medium text-right\">Responses</th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-border-color\">\n              {[\n                { name: \'Monsoon Magic\', target: \'Inactive Members\', date: \'01 May 2026\', count: \'14 claimed\' },\n                { name: \'April Push\', target: \'All Members\', date: \'10 Apr 2026\', count: \'45 claimed\' },\n                { name: \'Holi Special\', target: \'Expiring Soon\', date: \'20 Mar 2026\', count: \'28 claimed\' },\n              ].map((row, i) => (\n                <tr key={i} className=\"hover:bg-[#0D0D0D]/50 transition-colors\">\n                  <td className=\"px-5 py-3 font-medium text-white\">{row.name}</td>\n                  <td className=\"px-5 py-3 text-text-secondary\">{row.target}</td>\n                  <td className=\"px-5 py-3 text-text-secondary\">{row.date}</td>\n                  <td className=\"px-5 py-3 text-right font-medium text-primary\">{row.count}</td>\n                </tr>\n              ))}\n            </tbody>\n          </table>\n        </div>\n      </div>\n    </div>\n  )\n}\n\nfunction MeasurementsView() {\n  const lineData = {\n    labels: [\'Jan\', \'Feb\', \'Mar\', \'Apr\', \'May\'],\n    datasets: [\n      {\n        label: \'Weight (kg)\',\n        data: [85, 83.5, 82, 80.5, 79],\n        borderColor: \'rgba(255, 51, 51, 1)\',\n        backgroundColor: \'rgba(255, 51, 51, 0.1)\',\n        borderWidth: 2,\n        tension: 0.4,\n        fill: true,\n        pointBackgroundColor: \'#0D0D0D\',\n        pointBorderColor: \'rgba(255, 51, 51, 1)\',\n      }\n    ]\n  };\n\n  const lineOptions = {\n    responsive: true,\n    maintainAspectRatio: false,\n    plugins: { legend: { display: false } },\n    scales: {\n      y: { grid: { color: \'#333\' } },\n      x: { grid: { display: false } },\n    }\n  };\n\n  return (\n    <div className=\"w-full flex flex-col min-h-full pb-8\">\n      <header className=\"mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n        <h1 className=\"font-heading text-2xl font-bold text-white\">\n          Body Measurements\n        </h1>\n        <div className=\"flex items-center gap-3\">\n          <div className=\"bg-[#0D0D0D] border border-border-color rounded-md px-3 py-2 flex items-center min-w-[250px]\">\n            <Search size={16} className=\"text-text-secondary mr-2\" />\n            <select className=\"bg-transparent border-none text-sm text-white focus:outline-none w-full appearance-none\">\n              <option>Rahul Sharma (ID: 1042)</option>\n              <option>Aditi Singh (ID: 1043)</option>\n              <option>Select Member...</option>\n            </select>\n            <ChevronDown size={14} className=\"text-text-secondary ml-2\" />\n          </div>\n        </div>\n      </header>\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6\">\n        <div className=\"lg:col-span-2 space-y-6\">\n          <div className=\"bg-surface border border-border-color p-5 rounded-xl\">\n             <div className=\"flex justify-between items-center mb-4\">\n               <h3 className=\"font-heading font-semibold text-[14px] text-text-secondary uppercase tracking-tight\">Add New Reading</h3>\n               <span className=\"text-xs text-text-secondary\">Last updated: 14 Apr 2026</span>\n             </div>\n             <form className=\"grid grid-cols-2 md:grid-cols-4 gap-4\">\n                <div className=\"space-y-1\">\n                   <label className=\"text-[10px] text-text-secondary font-semibold uppercase\">Date</label>\n                   <input type=\"date\" className=\"w-full bg-[#0D0D0D] border border-border-color rounded-md px-3 py-2 text-sm text-white focus:outline-none [color-scheme:dark]\" defaultValue=\"2026-05-05\" />\n                </div>\n                <div className=\"space-y-1\">\n                   <label className=\"text-[10px] text-text-secondary font-semibold uppercase\">Weight (kg)</label>\n                   <input type=\"number\" step=\"0.1\" className=\"w-full bg-[#0D0D0D] border border-border-color rounded-md px-3 py-2 text-sm text-white focus:outline-none\" defaultValue=\"79\" />\n                </div>\n                <div className=\"space-y-1\">\n                   <label className=\"text-[10px] text-text-secondary font-semibold uppercase\">Height (cm)</label>\n                   <input type=\"number\" className=\"w-full bg-[#0D0D0D] border border-border-color rounded-md px-3 py-2 text-sm text-white focus:outline-none\" defaultValue=\"178\" />\n                </div>\n                <div className=\"space-y-1\">\n                   <label className=\"text-[10px] text-text-secondary font-semibold uppercase\">Body Fat %</label>\n                   <input type=\"number\" step=\"0.1\" className=\"w-full bg-[#0D0D0D] border border-border-color rounded-md px-3 py-2 text-sm text-white focus:outline-none\" defaultValue=\"18.5\" />\n                </div>\n                <div className=\"space-y-1\">\n                   <label className=\"text-[10px] text-text-secondary font-semibold uppercase\">Chest (in)</label>\n                   <input type=\"number\" step=\"0.1\" className=\"w-full bg-[#0D0D0D] border border-border-color rounded-md px-3 py-2 text-sm text-white focus:outline-none\" defaultValue=\"42\" />\n                </div>\n                <div className=\"space-y-1\">\n                   <label className=\"text-[10px] text-text-secondary font-semibold uppercase\">Waist (in)</label>\n                   <input type=\"number\" step=\"0.1\" className=\"w-full bg-[#0D0D0D] border border-border-color rounded-md px-3 py-2 text-sm text-white focus:outline-none\" defaultValue=\"34\" />\n                </div>\n                <div className=\"space-y-1\">\n                   <label className=\"text-[10px] text-text-secondary font-semibold uppercase\">Arms (in)</label>\n                   <input type=\"number\" step=\"0.1\" className=\"w-full bg-[#0D0D0D] border border-border-color rounded-md px-3 py-2 text-sm text-white focus:outline-none\" defaultValue=\"15.5\" />\n                </div>\n                <div className=\"space-y-1 flex items-end\">\n                  <button className=\"w-full bg-primary hover:bg-primary/90 text-[#0D0D0D] px-3 py-2 rounded-md text-sm font-bold transition-colors\">\n                    Save Record\n                  </button>\n                </div>\n             </form>\n          </div>\n\n          <div className=\"bg-surface border border-border-color p-5 rounded-xl line-chart-container\">\n             <div className=\"flex justify-between items-center mb-4\">\n                <h3 className=\"font-heading font-semibold text-[14px] text-text-secondary uppercase tracking-tight\">Weight Progress</h3>\n                <div className=\"text-xs font-bold text-green-500 bg-green-500/10 px-2 py-1 rounded\">-6.0 kg Total</div>\n             </div>\n             <div className=\"h-[200px] w-full\">\n                {/* Due to chart.js dynamic import issues sometimes, wrapping in a styled div or using a standard bar chart is safer. We will use a faux chart here for layout if real fails, but real chart is preferable. Assuming chart.js works since it\'s in the imports and used earlier. */}\n                {/* Faux Area Chart structure just in case */}\n                <div className=\"w-full h-full flex items-end justify-between px-4 pb-6 relative\">\n                   <div className=\"absolute inset-0 border-b border-[#333] pointer-events-none\"></div>\n                   {/* Points */}\n                   <div className=\"w-2 h-2 bg-primary rounded-full relative z-10\" style={{bottom: \'80%\'}}></div>\n                   <div className=\"w-2 h-2 bg-primary rounded-full relative z-10\" style={{bottom: \'70%\'}}></div>\n                   <div className=\"w-2 h-2 bg-primary rounded-full relative z-10\" style={{bottom: \'60%\'}}></div>\n                   <div className=\"w-2 h-2 bg-primary rounded-full relative z-10\" style={{bottom: \'50%\'}}></div>\n                   <div className=\"w-2 h-2 bg-primary rounded-full relative z-10\" style={{bottom: \'40%\'}}></div>\n                   {/* SVGs line can be generated dynamically, but styling a chart is complex. */}\n                   <div className=\"absolute inset-x-4 bottom-6 top-10 pointer-events-none text-center flex flex-col justify-center items-center opacity-30\">\n                      <TrendingUp size={48} className=\"text-primary mb-2\" />\n                      <span className=\"text-xs tracking-widest uppercase\">Progress Visualized</span>\n                   </div>\n                </div>\n             </div>\n          </div>\n        </div>\n\n        <div className=\"space-y-6\">\n           <div className=\"bg-surface border border-border-color p-5 rounded-xl\">\n             <div className=\"flex justify-between items-center mb-4\">\n                <h3 className=\"font-heading font-semibold text-[14px] text-text-secondary uppercase tracking-tight\">Current Stats</h3>\n                <div className=\"text-xs bg-blue-500/20 text-blue-400 px-2 py-0.5 rounded font-bold\">BMI 24.9</div>\n             </div>\n             <div className=\"space-y-3\">\n               <div className=\"flex justify-between items-center border-b border-border-color pb-2\">\n                 <span className=\"text-sm text-text-secondary\">Weight</span>\n                 <span className=\"font-mono text-white\">79 kg</span>\n               </div>\n               <div className=\"flex justify-between items-center border-b border-border-color pb-2\">\n                 <span className=\"text-sm text-text-secondary\">Body Fat</span>\n                 <span className=\"font-mono text-white\">18.5%</span>\n               </div>\n               <div className=\"flex justify-between items-center border-b border-border-color pb-2\">\n                 <span className=\"text-sm text-text-secondary\">Chest</span>\n                 <span className=\"font-mono text-white\">42&quot;</span>\n               </div>\n               <div className=\"flex justify-between items-center border-b border-border-color pb-2\">\n                 <span className=\"text-sm text-text-secondary\">Waist</span>\n                 <span className=\"font-mono text-white\">34&quot;</span>\n               </div>\n               <div className=\"flex justify-between items-center\">\n                 <span className=\"text-sm text-text-secondary\">Arms</span>\n                 <span className=\"font-mono text-white\">15.5&quot;</span>\n               </div>\n             </div>\n             \n             <button className=\"w-full mt-6 bg-[#25D366] hover:bg-[#1ebd58] text-white px-3 py-2 rounded-md text-sm font-bold transition-colors flex items-center justify-center gap-2\">\n                <MessageCircle size={16} /> Send Report via WhatsApp\n             </button>\n           </div>\n           \n           <div className=\"bg-orange-500/10 border border-orange-500/30 p-4 rounded-xl\">\n             <h4 className=\"text-sm font-semibold text-orange-500 flex items-center gap-2 mb-2\"><AlertTriangle size={16} /> Pending Updates</h4>\n             <p className=\"text-xs text-text-secondary mb-3\">15 active members haven\'t updated measurements this month.</p>\n             <button className=\"text-xs font-semibold text-white underline\">View List</button>\n           </div>\n        </div>\n      </div>\n\n      <div className=\"bg-surface border border-border-color rounded-xl overflow-hidden\">\n        <div className=\"px-5 py-4 border-b border-border-color flex justify-between items-center bg-[#0D0D0D]/30\">\n          <h3 className=\"font-heading font-semibold text-[14px] text-text-secondary uppercase tracking-tight\">History (Rahul Sharma)</h3>\n        </div>\n        <div className=\"overflow-x-auto\">\n          <table className=\"w-full text-left text-sm whitespace-nowrap\">\n            <thead className=\"bg-[#0D0D0D] border-b border-border-color text-text-secondary text-[11px] uppercase tracking-wider\">\n              <tr>\n                <th className=\"px-5 py-3 font-medium\">Date</th>\n                <th className=\"px-5 py-3 font-medium\">Weight</th>\n                <th className=\"px-5 py-3 font-medium\">Body Fat %</th>\n                <th className=\"px-5 py-3 font-medium\">Chest</th>\n                <th className=\"px-5 py-3 font-medium\">Waist</th>\n                <th className=\"px-5 py-3 font-medium\">Arms</th>\n                <th className=\"px-5 py-3 font-medium\">BMI</th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-border-color\">\n              {[\n                { d: \'05 May 2026\', w: \'79\', bf: \'18.5\', c: \'42\', wa: \'34\', a: \'15.5\', bmi: \'24.9\' },\n                { d: \'05 Apr 2026\', w: \'80.5\', bf: \'19.2\', c: \'41.5\', wa: \'34.5\', a: \'15.2\', bmi: \'25.4\' },\n                { d: \'05 Mar 2026\', w: \'82\', bf: \'20.0\', c: \'41\', wa: \'35\', a: \'15\', bmi: \'25.8\' },\n                { d: \'05 Feb 2026\', w: \'83.5\', bf: \'21.0\', c: \'40.5\', wa: \'36\', a: \'14.5\', bmi: \'26.3\' },\n              ].map((row, i) => (\n                <tr key={i} className=\"hover:bg-[#0D0D0D]/50 transition-colors\">\n                  <td className=\"px-5 py-3 text-text-secondary\">{row.d}</td>\n                  <td className=\"px-5 py-3 font-medium text-white\">{row.w} kg</td>\n                  <td className=\"px-5 py-3 text-white\">{row.bf}%</td>\n                  <td className=\"px-5 py-3 text-text-secondary\">{row.c}\"</td>\n                  <td className=\"px-5 py-3 text-text-secondary\">{row.wa}\"</td>\n                  <td className=\"px-5 py-3 text-text-secondary\">{row.a}\"</td>\n                  <td className=\"px-5 py-3 font-mono text-primary\">{row.bmi}</td>\n                </tr>\n              ))}\n            </tbody>\n          </table>\n        </div>\n      </div>\n    </div>\n  )\n}\n\nfunction ReviewsView() {\n  return (\n    <div className=\"w-full flex flex-col min-h-full pb-8\">\n      <header className=\"mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n        <div>\n           <h1 className=\"font-heading text-2xl font-bold text-white mb-1\">\n             Member Reviews\n           </h1>\n           <div className=\"flex items-center gap-2\">\n             <div className=\"flex text-orange-400\">\n               <Star size={16} fill=\"currentColor\" />\n               <Star size={16} fill=\"currentColor\" />\n               <Star size={16} fill=\"currentColor\" />\n               <Star size={16} fill=\"currentColor\" />\n               <Star size={16} fill=\"currentColor\" className=\"opacity-50\" />\n             </div>\n             <span className=\"text-sm font-bold text-white\">4.7</span>\n             <span className=\"text-xs text-text-secondary\">from 42 reviews</span>\n           </div>\n        </div>\n        <div className=\"flex gap-2\">\n          <select className=\"bg-surface border border-border-color rounded-md px-3 py-2 text-sm text-white focus:outline-none\">\n             <option>All Reviews</option>\n             <option>5 Stars</option>\n             <option>4 Stars</option>\n             <option>3 Stars & Below</option>\n          </select>\n        </div>\n      </header>\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-4 gap-6\">\n        <div className=\"lg:col-span-1 space-y-6\">\n           <div className=\"bg-surface border border-border-color p-5 rounded-xl sticky top-0\">\n             <h3 className=\"font-heading font-semibold text-[14px] text-text-secondary uppercase tracking-tight mb-4\">Add Review</h3>\n             <form className=\"space-y-4\">\n                <div className=\"space-y-2\">\n                   <label className=\"text-xs text-text-secondary font-semibold uppercase\">Select Member</label>\n                   <select className=\"w-full bg-[#0D0D0D] border border-border-color rounded-md px-3 py-2 text-sm text-white focus:outline-none\">\n                      <option>Rajesh Kumar</option>\n                      <option>Sneha Singh</option>\n                   </select>\n                </div>\n                <div className=\"space-y-2\">\n                   <label className=\"text-xs text-text-secondary font-semibold uppercase\">Rating</label>\n                   <div className=\"flex gap-1 text-text-secondary cursor-pointer\">\n                      <Star size={24} className=\"hover:text-orange-400 hover:fill-orange-400 transition-all text-orange-400 fill-orange-400\" />\n                      <Star size={24} className=\"hover:text-orange-400 hover:fill-orange-400 transition-all text-orange-400 fill-orange-400\" />\n                      <Star size={24} className=\"hover:text-orange-400 hover:fill-orange-400 transition-all text-orange-400 fill-orange-400\" />\n                      <Star size={24} className=\"hover:text-orange-400 hover:fill-orange-400 transition-all text-orange-400 fill-orange-400\" />\n                      <Star size={24} className=\"hover:text-orange-400 hover:fill-orange-400 transition-all text-orange-400 fill-orange-400\" />\n                   </div>\n                </div>\n                <div className=\"space-y-2\">\n                   <label className=\"text-xs text-text-secondary font-semibold uppercase\">Date</label>\n                   <input type=\"date\" className=\"w-full bg-[#0D0D0D] border border-border-color rounded-md px-3 py-2 text-sm text-white focus:outline-none [color-scheme:dark]\" defaultValue=\"2026-05-05\" />\n                </div>\n                <div className=\"space-y-2\">\n                   <label className=\"text-xs text-text-secondary font-semibold uppercase\">Review Text</label>\n                   <textarea className=\"w-full bg-[#0D0D0D] border border-border-color rounded-md px-3 py-2 text-sm text-white focus:outline-none placeholder:text-text-secondary/50\" rows={4} placeholder=\"What did they say?\"></textarea>\n                </div>\n                <button className=\"w-full bg-primary hover:bg-primary/90 text-[#000] px-4 py-2 rounded-md text-sm font-bold transition-colors mt-2\">\n                  Post Review\n                </button>\n             </form>\n           </div>\n        </div>\n\n        <div className=\"lg:col-span-3\">\n           <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n              {[\n                { name: \'Sameer Verma\', text: \"Best equipment in the area. Trainors are very helpful, specially Vikas sir. Highly recommend for serious lifters.\", r: 5, date: \'02 May 2026\' },\n                { name: \'Priya Sharma\', text: \"Space is a bit tight during evening hours, but overall a decent gym. The new machines are great.\", r: 4, date: \'28 Apr 2026\' },\n                { name: \'Ankit Patel\', text: \"Joined recently and the vibe is awesome. Music is always pumping. They should fix the AC in the cardio section though.\", r: 4, date: \'15 Apr 2026\' },\n                { name: \'Rahul Jain\', text: \"Have been a member for 2 years. Corenix is like a family now. Great supportive environment.\", r: 5, date: \'01 Apr 2026\' },\n                { name: \'Manish Tiwari\', text: \"Good trainers, flexible timings.\", r: 5, date: \'20 Mar 2026\' },\n                { name: \'Swati\', text: \"Cardio section is very good.\", r: 4, date: \'10 Mar 2026\' },\n              ].map((rev, i) => (\n                <div key={i} className=\"bg-surface border border-border-color p-5 rounded-xl flex flex-col justify-between\">\n                  <div>\n                    <div className=\"flex justify-between items-start mb-3\">\n                      <div className=\"flex items-center gap-2\">\n                         <div className=\"w-8 h-8 rounded-full bg-[#0D0D0D] border border-border-color flex items-center justify-center text-xs font-bold font-heading\">\n                            {rev.name.charAt(0)}\n                         </div>\n                         <div>\n                            <div className=\"font-bold text-white text-sm\">{rev.name}</div>\n                            <div className=\"text-[10px] text-text-secondary\">{rev.date}</div>\n                         </div>\n                      </div>\n                      <div className=\"flex text-orange-400\">\n                        {Array.from({length: 5}).map((_, idx) => (\n                          <Star key={idx} size={12} fill=\"currentColor\" className={idx >= rev.r ? \"opacity-30\" : \"\"} />\n                        ))}\n                      </div>\n                    </div>\n                    <p className=\"text-sm text-text-secondary mb-4 italic\">\n                      \"{rev.text}\"\n                    </p>\n                  </div>\n                  <div className=\"pt-3 border-t border-border-color flex justify-end\">\n                     <button className=\"text-xs font-semibold text-primary hover:text-white transition-colors flex items-center gap-1\">\n                        <Camera size={12}/> Copy for Instagram\n                     </button>\n                  </div>\n                </div>\n              ))}\n           </div>\n        </div>\n      </div>\n    </div>\n  )\n}\n"
    }
