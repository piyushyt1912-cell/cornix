    instruction: "Add Demo mode check, handle offline error silently, and add Demo Login bypass logic."
    replacement_infos {
      original_chunk {
        target_content: "  useEffect(() => {\n    setTimeout(() => setMounted(true), 0);\n    const unsubscribe = onAuthStateChanged(auth, async (u) => {\n      if (u) {\n        setUser(u);\n        try {\n          const docRef = doc(db, \'users\', u.uid);\n          const docSnap = await getDoc(docRef);\n          if (docSnap.exists()) {\n             setRole(docSnap.data().role);\n             setUserData({ ...docSnap.data(), uid: u.uid, email: u.email });\n             // Change tab based on role if default is not allowed\n             if (docSnap.data().role === \'receptionist\') setActiveTab(\'Members\');\n             else if (docSnap.data().role === \'trainer\') setActiveTab(\'Members\');\n          } else {\n             // Fallback for development if user doesn\'t exist in firestore\n             setRole(\'admin\');\n             setUserData({ name: \'Admin\', email: u.email, role: \'admin\' });\n          }\n        } catch (e) {\n           console.error(\"Error fetching user data\", e);\n           setRole(\'admin\'); // Fallback\n           setUserData({ name: \'Admin\', email: u.email, role: \'admin\' });\n        }\n      } else {\n        setUser(null);\n        setRole(null);\n        setUserData(null);\n      }\n      setLoading(false);\n    });\n    return () => unsubscribe();\n  }, []);\n\n  const handleLogin = async (e: React.FormEvent) => {\n    e.preventDefault();\n    setIsLoggingIn(true);\n    setLoginError(\'\');\n    try {\n      await signInWithEmailAndPassword(auth, email, password);\n    } catch (err) {\n      setLoginError(\"Invalid email or password. Contact your admin.\");\n    } finally {\n      setIsLoggingIn(false);\n    }\n  };"
        replacement_content: "  useEffect(() => {\n    setTimeout(() => setMounted(true), 0);\n    \n    // Check if we are running in quick-demo mode\n    const demoRole = typeof window !== \'undefined\' ? sessionStorage.getItem(\'demo_role\') : null;\n    if (demoRole) {\n       setUser({ uid: \'demo-\' + demoRole, email: \'demo@corenix.test\' } as User);\n       setRole(demoRole as any);\n       setUserData({ name: \'Demo \' + demoRole.charAt(0).toUpperCase() + demoRole.slice(1), email: \'demo@corenix.test\', role: demoRole });\n       setLoading(false);\n       return;\n    }\n\n    const unsubscribe = onAuthStateChanged(auth, async (u) => {\n      if (u) {\n        setUser(u);\n        try {\n          const docRef = doc(db, \'users\', u.uid);\n          const docSnap = await getDoc(docRef);\n          if (docSnap.exists()) {\n             setRole(docSnap.data().role);\n             setUserData({ ...docSnap.data(), uid: u.uid, email: u.email });\n             // Change tab based on role if default is not allowed\n             if (docSnap.data().role === \'receptionist\') setActiveTab(\'Members\');\n             else if (docSnap.data().role === \'trainer\') setActiveTab(\'Members\');\n          } else {\n             // Fallback for development if user doesn\'t exist in firestore\n             setRole(\'admin\');\n             setUserData({ name: \'Admin\', email: u.email, role: \'admin\' });\n          }\n        } catch (e: any) {\n           if (e.message && e.message.includes(\'offline\')) {\n               console.warn(\"Firestore is offline (likely missing config). Using local admin fallback.\");\n           } else {\n               console.error(\"Error fetching user data\", e.message || e);\n           }\n           setRole(\'admin\'); // Fallback\n           setUserData({ name: \'Admin\', email: u.email, role: \'admin\' });\n        }\n      } else {\n        setUser(null);\n        setRole(null);\n        setUserData(null);\n      }\n      setLoading(false);\n    });\n    return () => unsubscribe();\n  }, []);\n\n  const handleLogin = async (e: React.FormEvent) => {\n    e.preventDefault();\n    setIsLoggingIn(true);\n    setLoginError(\'\');\n    try {\n      await signInWithEmailAndPassword(auth, email, password);\n    } catch (err) {\n      setLoginError(\"Invalid email or password. Contact your admin.\");\n    } finally {\n      setIsLoggingIn(false);\n    }\n  };\n\n  const handleDemoBypass = () => {\n    sessionStorage.setItem(\'demo_role\', \'admin\');\n    window.location.reload();\n  };"
      }
      num_matches: 1
    }
  }
