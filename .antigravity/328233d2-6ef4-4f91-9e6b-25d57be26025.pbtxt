       <span className=\"text-[10px] text-text-secondary uppercase select-none\">\n                  {[\'Jan\', \'Feb\', \'Mar\', \'Apr\', \'May\', \'Jun\', \'Jul\', \'Aug\', \'Sep\', \'Oct\', \'Nov\', \'Dec\'][i]}\n                </span>\n              </div>\n            ))}\n          </div>\n        </div>\n\n        {/* Right Sidebar - Recent Activity */}\n        <div className=\"bg-surface border border-border-color rounded-xl p-5 shadow-sm flex flex-col\">\n          <div className=\"flex justify-between items-center mb-6\">\n            <h3 className=\"font-heading font-semibold text-lg text-white\">Recent Attendance</h3>\n            <button className=\"text-text-secondary hover:text-white\"><MoreVertical size={18} /></button>\n          </div>\n          \n          <div className=\"flex-1 space-y-4\">\n            {[\n              { name: \'Rahul Sharma\', time: \'10:45 AM\', plan: \'Pro Yearly\' },\n              { name: \'Aditi Singh\', time: \'10:30 AM\', plan: \'Basic Monthly\' },\n              { name: \'Vikram Mehta\', time: \'10:12 AM\', plan: \'Pro Monthly\' },\n              { name: \'Priya Patel\', time: \'09:55 AM\', plan: \'Quarterly\' },\n              { name: \'Rohan Gupta\', time: \'09:40 AM\', plan: \'Trial\' },\n            ].map((user, i) => (\n              <div key={i} className=\"flex items-center gap-4 py-2 border-b border-border-color/50 last:border-0 hover:bg-[#0D0D0D]/50 px-2 rounded-md transition-colors -mx-2\">\n                <div className=\"w-10 h-10 rounded-full bg-[#0D0D0D] border border-border-color flex items-center justify-center shrink-0\">\n                  <div className=\"font-heading font-bold text-sm text-primary\">{user.name.charAt(0)}</div>\n                </div>\n                <div className=\"flex-1 min-w-0\">\n                  <p className=\"text-sm font-medium text-white truncate\">{user.name}</p>\n                  <p className=\"text-xs text-text-secondary truncate\">{user.plan}</p>\n                </div>\n                <div className=\"text-xs text-text-secondary whitespace-nowrap text-right\">\n                  {user.time}\n                </div>\n              </div>\n            ))}\n          </div>\n\n          <button className=\"w-full mt-4 py-2 text-xs font-semibold text-primary/90 hover:text-primary hover:bg-primary/10 rounded-md transition-colors flex items-center justify-center gap-1\">\n            View All Register <ArrowUpRight size={14} />\n          </button>\n        </div>\n\n      </div>\n    </div>\n  );\n}\n\nfunction StatCard({ title, value, trend, icon: Icon, trendUp, isAlert = false }: any) {\n  return (\n    <div className=\"bg-surface border border-border-color rounded-xl p-5 shadow-sm hover:border-border-color/80 transition-colors\">\n      <div className=\"flex justify-between items-start mb-4\">\n        <div className={`p-2.5 rounded-lg ${isAlert ? \'bg-primary/10 text-primary\' : \'bg-[#0D0D0D] text-white border border-border-color\'}`}>\n          <Icon size={20} />\n        </div>\n        <div className={`text-xs font-medium px-2 py-1 rounded-full flex items-center gap-1 ${\n          isAlert ? \'bg-red-500/10 text-red-500\' : \'bg-green-500/10 text-green-500\'\n        }`}>\n          {trendUp ? <TrendingUp size={12} /> : <div className=\"rotate-180\"><TrendingUp size={12} /></div>}\n          {trend}\n        </div>\n      </div>\n      <div>\n        <p className=\"text-text-secondary text-sm mb-1\">{title}</p>\n        <h4 className=\"font-heading text-2xl font-bold text-white tracking-tight\">{value}</h4>\n      </div>\n    </div>\n  );\n}"
      replacement_content: "      {/* Stat Cards */}\n      <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-6\">\n        <StatCard title=\"Total Members\" value=\"1,284\" trendLabel=\"+12 this month\" trendColor=\"text-green-500\" icon={Users} />\n        <StatCard title=\"Active Check-ins\" value=\"42\" trendLabel=\"Current live count\" trendColor=\"text-text-secondary\" icon={UserCheck} />\n        <StatCard title=\"Revenue (M)\" value=\"\342\202\271 4,82,500\" trendLabel=\"Target: \342\202\271 5,50,000\" trendColor=\"text-primary\" icon={TrendingUp} />\n        <StatCard title=\"Pending Dues\" value=\"\342\202\271 12,450\" trendLabel=\"8 Members\" trendColor=\"text-primary\" icon={TicketPercent} />\n      </div>\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-5 gap-5\">\n        \n        {/* Main Chart Area Placeholder */}\n        <div className=\"lg:col-span-3 bg-surface border border-border-color rounded-xl flex flex-col h-[360px]\">\n          <div className=\"px-5 py-4 border-b border-border-color flex justify-between items-center\">\n            <h3 className=\"font-heading font-semibold text-[14px] text-text-secondary uppercase tracking-tight\">Revenue Overview</h3>\n            <select className=\"bg-[#0D0D0D] border border-border-color text-xs text-text-secondary rounded-md px-3 py-1.5 outline-none focus:border-primary/50\">\n              <option>This Month</option>\n              <option>Last Month</option>\n              <option>This Year</option>\n            </select>\n          </div>\n          <div className=\"flex-1 flex items-end justify-between gap-2 lg:gap-4 px-5 pt-8 pb-5\">\n            {/* Mock bar chart */}\n            {[40, 70, 45, 90, 65, 80, 110, 85, 120, 100, 130, 95].map((h, i) => (\n              <div key={i} className=\"flex-1 flex flex-col items-center gap-2 group h-full justify-end\">\n                <div className=\"w-full bg-border-color rounded-[3px] relative overflow-hidden h-[80%]\">\n                  <div \n                    className=\"absolute bottom-0 w-full bg-primary/20 group-hover:bg-primary transition-all duration-500 rounded-[3px]\"\n                    style={{ height: `${(h / 150) * 100}%` }}\n                  ></div>\n                </div>\n                <span className=\"text-[10px] text-text-secondary uppercase select-none\">\n                  {[\'Jan\', \'Feb\', \'Mar\', \'Apr\', \'May\', \'Jun\', \'Jul\', \'Aug\', \'Sep\', \'Oct\', \'Nov\', \'Dec\'][i]}\n                </span>\n              </div>\n            ))}\n          </div>\n        </div>\n\n        {/* Right Sidebar - Recent Activity */}\n        <div className=\"lg:col-span-2 bg-surface border border-border-color rounded-xl flex flex-col h-[360px] overflow-hidden\">\n          <div className=\"px-5 py-4 border-b border-border-color flex justify-between items-center shrink-0\">\n            <h3 className=\"font-heading font-semibold text-[14px] text-text-secondary uppercase tracking-tight\">Recent Check-ins (\340\244\211\340\244\252\340\244\270\340\245\215\340\244\245\340\244\277\340\244\244\340\244\277)</h3>\n            <button className=\"text-[10px] text-primary cursor-pointer hover:underline\">View All</button>\n          </div>\n          \n          <div className=\"flex-1 overflow-y-auto no-scrollbar\">\n            {[\n              { name: \'Arjun Sharma\', info: \'ID: #9822 \342\200\242 Gold Plan\', time: \'06:42 PM\', status: \'Checked In\', statusClass: \'bg-green-500/10 text-green-500\' },\n              { name: \'Priya Patel\', info: \'ID: #9102 \342\200\242 Cardio Special\', time: \'06:38 PM\', status: \'Checked In\', statusClass: \'bg-green-500/10 text-green-500\' },\n              { name: \'Rahul Verma\', info: \'ID: #8721 \342\200\242 PT Session\', time: \'06:15 PM\', status: \'Checked In\', statusClass: \'bg-green-500/10 text-green-500\' },\n              { name: \'Sneha Gupta\', info: \'ID: #1029 \342\200\242 Monthly\', time: \'05:55 PM\', status: \'Checked In\', statusClass: \'bg-green-500/10 text-green-500\' },\n            ].map((user, i) => (\n              <div key={i} className=\"flex justify-between items-center px-5 py-3 border-b border-border-color last:border-0 text-[13px] hover:bg-[#0D0D0D]/30 transition-colors\">\n                <div>\n                  <strong className=\"text-white font-semibold\">{user.name}</strong>\n                  <div className=\"text-[10px] text-text-secondary mt-0.5\">{user.info}</div>\n                </div>\n                <div className=\"text-right flex flex-col items-end gap-1\">\n                  <div className=\"text-text-secondary\">{user.time}</div>\n                  <span className={`px-2 py-0.5 rounded-[4px] text-[11px] font-semibold ${user.statusClass}`}>{user.status}</span>\n                </div>\n              </div>\n            ))}\n          </div>\n        </div>\n\n      </div>\n    </div>\n  );\n}\n\nfunction StatCard({ title, value, trendLabel, trendColor, icon: Icon }: any) {\n  return (\n    <div className=\"bg-surface p-5 rounded-xl border border-border-color\">\n      <div className=\"text-[12px] text-text-secondary uppercase mb-2 flex justify-between items-center\">\n        <span>{title}</span>\n        <Icon size={16} className=\"text-text-secondary opacity-50\" />\n      </div>\n      <div className=\"font-heading text-2xl font-bold text-white leading-tight\">{value}</div>\n      <div className={`text-[10px] mt-2 ${trendColor}`}>\n        {trendLabel}\n      </div>\n    </div>\n  );\n}"
