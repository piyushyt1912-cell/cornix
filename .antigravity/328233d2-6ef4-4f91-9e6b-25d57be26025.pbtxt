      replacement_content: "  );\n}\n\nconst MOCK_MEMBERS = [\n  { id: \'1\', name: \'Rahul Sharma\', phone: \'919876543210\', plan: \'Annual\', amount: \'\342\202\2717999\', startDate: \'2023-11-15\', expiryDate: \'2024-11-14\', status: \'Active\' },\n  { id: \'2\', name: \'Sneha Gupta\', phone: \'919876543211\', plan: \'Monthly\', amount: \'\342\202\271999\', startDate: \'2024-05-01\', expiryDate: \'2024-05-31\', status: \'Expiring Soon\' },\n  { id: \'3\', name: \'Vikram Mehta\', phone: \'919876543212\', plan: \'Quarterly\', amount: \'\342\202\2712499\', startDate: \'2024-01-10\', expiryDate: \'2024-04-10\', status: \'Expired\' },\n  { id: \'4\', name: \'Priya Patel\', phone: \'919876543213\', plan: \'Annual\', amount: \'\342\202\2717999\', startDate: \'2024-02-01\', expiryDate: \'2025-01-31\', status: \'Active\' },\n  { id: \'5\', name: \'Karan Johar\', phone: \'919876543214\', plan: \'Half-Yearly\', amount: \'\342\202\2714499\', startDate: \'2023-12-05\', expiryDate: \'2024-06-05\', status: \'Expiring Soon\' },\n  { id: \'6\', name: \'Aditi Singh\', phone: \'919876543215\', plan: \'Monthly\', amount: \'\342\202\271999\', startDate: \'2024-04-15\', expiryDate: \'2024-05-15\', status: \'Active\' },\n  { id: \'7\', name: \'Neha Sharma\', phone: \'919876543216\', plan: \'Quarterly\', amount: \'\342\202\2712499\', startDate: \'2023-10-01\', expiryDate: \'2024-01-01\', status: \'Expired\' },\n  { id: \'8\', name: \'Arjun Sharma\', phone: \'919876543217\', plan: \'Annual\', amount: \'\342\202\2717999\', startDate: \'2024-03-20\', expiryDate: \'2025-03-19\', status: \'Active\' },\n];\n\nfunction MembersView() {\n  const [search, setSearch] = useState(\'\');\n  const [filter, setFilter] = useState(\'All\');\n  const [sort, setSort] = useState({ key: \'name\', direction: \'asc\' });\n  const [isAddOpen, setIsAddOpen] = useState(false);\n  const [selectedMember, setSelectedMember] = useState<any>(null);\n\n  if (selectedMember) {\n    return <MemberProfile member={selectedMember} onBack={() => setSelectedMember(null)} />;\n  }\n\n  const handleSort = (key: string) => {\n    let direction = \'asc\';\n    if (sort.key === key && sort.direction === \'asc\') direction = \'desc\';\n    setSort({ key, direction });\n  };\n\n  const filteredMembers = MOCK_MEMBERS.filter(m => {\n    const matchSearch = m.name.toLowerCase().includes(search.toLowerCase()) || m.phone.includes(search);\n    const matchFilter = filter === \'All\' || m.status === filter;\n    return matchSearch && matchFilter;\n  }).sort((a: any, b: any) => {\n    let aVal = a[sort.key];\n    let bVal = b[sort.key];\n    if (sort.key === \'expiryDate\') {\n      aVal = new Date(aVal).getTime();\n      bVal = new Date(bVal).getTime();\n    }\n    if (aVal < bVal) return sort.direction === \'asc\' ? -1 : 1;\n    if (aVal > bVal) return sort.direction === \'asc\' ? 1 : -1;\n    return 0;\n  });\n\n  return (\n    <div className=\"w-full flex flex-col min-h-full pb-8\">\n      <header className=\"mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n        <h1 className=\"font-heading text-2xl font-bold text-white\">\n          Members <span className=\"text-[12px] text-text-secondary ml-2 font-normal font-sans\">(\340\244\270\340\244\246\340\244\270\340\245\215\340\244\257)</span>\n        </h1>\n        <div className=\"flex flex-wrap items-center gap-3\">\n          <div className=\"relative\">\n            <Search className=\"absolute left-3 top-1/2 -translate-y-1/2 text-text-secondary\" size={16} />\n            <input \n              type=\"text\" \n              placeholder=\"Search name or phone...\" \n              value={search}\n              onChange={e => setSearch(e.target.value)}\n              className=\"bg-surface border border-border-color rounded-md py-2 pl-9 pr-4 text-sm text-white focus:outline-none focus:border-primary/50 w-[200px] lg:w-[250px]\"\n            />\n          </div>\n          <select \n            value={filter} \n            onChange={e => setFilter(e.target.value)}\n            className=\"bg-surface border border-border-color rounded-md py-2 px-3 text-sm text-text-secondary focus:outline-none focus:border-primary/50\"\n          >\n            <option value=\"All\">All Status</option>\n            <option value=\"Active\">Active</option>\n            <option value=\"Expiring Soon\">Expiring Soon</option>\n            <option value=\"Expired\">Expired</option>\n            <option value=\"Paused\">Paused</option>\n          </select>\n          <button \n            onClick={() => setIsAddOpen(true)}\n            className=\"bg-primary hover:bg-primary/90 text-white px-4 py-2 rounded-md text-sm font-semibold flex items-center justify-center gap-2 transition-colors shrink-0\"\n          >\n            <Plus size={16} /> Add Member\n          </button>\n        </div>\n      </header>\n\n      {/* Table */}\n      <div className=\"flex-1 bg-surface border border-border-color rounded-xl overflow-hidden flex flex-col\">\n        <div className=\"overflow-x-auto\">\n          <table className=\"w-full text-left text-sm whitespace-nowrap\">\n            <thead className=\"bg-[#0D0D0D]/50 border-b border-border-color text-text-secondary text-[11px] uppercase tracking-wider\">\n              <tr>\n                <th className=\"px-5 py-4 font-medium\" onClick={() => handleSort(\'name\')}>\n                  <div className=\"flex items-center gap-1 cursor-pointer hover:text-white transition-colors\">\n                    Member {sort.key === \'name\' && (sort.direction === \'asc\' ? <ChevronUp size={12}/> : <ChevronDown size={12}/>)}\n                  </div>\n                </th>\n                <th className=\"px-5 py-4 font-medium\">Contact</th>\n                <th className=\"px-5 py-4 font-medium\">Plan</th>\n                <th className=\"px-5 py-4 font-medium\">Joined</th>\n                <th className=\"px-5 py-4 font-medium\" onClick={() => handleSort(\'expiryDate\')}>\n                  <div className=\"flex items-center gap-1 cursor-pointer hover:text-white transition-colors\">\n                    Expires {sort.key === \'expiryDate\' && (sort.direction === \'asc\' ? <ChevronUp size={12}/> : <ChevronDown size={12}/>)}\n                  </div>\n                </th>\n                <th className=\"px-5 py-4 font-medium\">Amount</th>\n                <th className=\"px-5 py-4 font-medium text-center\">Status</th>\n                <th className=\"px-5 py-4 font-medium text-right\">Actions</th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-border-color\">\n               {filteredMembers.map(m => (\n                 <tr key={m.id} className=\"hover:bg-[#0D0D0D]/50 transition-colors group\">\n                    <td className=\"px-5 py-3\">\n                      <div className=\"flex items-center gap-3\">\n                        <div className=\"w-8 h-8 rounded-full bg-[#0D0D0D] border border-border-color text-primary flex items-center justify-center font-heading font-bold text-xs uppercase\">\n                          {m.name.split(\' \').map((n: string) => n[0]).join(\'\')}\n                        </div>\n                        <span className=\"font-medium text-white\">{m.name}</span>\n                      </div>\n                    </td>\n                    <td className=\"px-5 py-3 text-text-secondary\">{m.phone}</td>\n                    <td className=\"px-5 py-3 text-text-secondary\">{m.plan}</td>\n                    <td className=\"px-5 py-3 text-text-secondary\">{m.startDate}</td>\n                    <td className=\"px-5 py-3 text-text-secondary\">{m.expiryDate}</td>\n                    <td className=\"px-5 py-3 text-text-secondary\">{m.amount}</td>\n                    <td className=\"px-5 py-3 text-center\">\n                      <span className={`inline-flex items-center px-2 py-1 rounded-[4px] text-[10px] font-bold uppercase tracking-wider ${\n                        m.status === \'Active\' ? \'bg-green-500/10 text-green-500\' :\n                        m.status === \'Expired\' ? \'bg-red-500/10 text-primary\' :\n                        \'bg-orange-500/10 text-orange-500\'\n                      }`}>\n                        {m.status}\n                      </span>\n                    </td>\n                    <td className=\"px-5 py-3 text-right\">\n                      <div className=\"flex items-center justify-end gap-2 text-text-secondary\">\n                        <button onClick={() => setSelectedMember(m)} className=\"p-1.5 hover:text-white hover:bg-border-color rounded transition-colors\" title=\"View Profile\">\n                          <Eye size={16} />\n                        </button>\n                        <button className=\"p-1.5 hover:text-white hover:bg-border-color rounded transition-colors\" title=\"Edit\">\n                          <Edit size={16} />\n                        </button>\n                        <a href={`https://wa.me/${m.phone}?text=Hello ${m.name}`} target=\"_blank\" rel=\"noopener noreferrer\" className=\"p-1.5 hover:text-green-500 hover:bg-border-color rounded transition-colors\" title=\"WhatsApp\">\n                          <MessageCircle size={16} />\n                        </a>\n                        <button className=\"p-1.5 hover:text-primary hover:bg-border-color rounded transition-colors\" title=\"Delete\">\n                          <Trash2 size={16} />\n                        </button>\n                      </div>\n                    </td>\n                 </tr>\n               ))}\n               {filteredMembers.length === 0 && (\n                 <tr>\n                   <td colSpan={8} className=\"px-5 py-8 text-center text-text-secondary\">No members found.</td>\n                 </tr>\n               )}\n            </tbody>\n          </table>\n        </div>\n      </div>\n\n      <AddMemberModal isOpen={isAddOpen} onClose={() => setIsAddOpen(false)} />\n    </div>\n  );\n}\n\nfunction AddMemberModal({ isOpen, onClose }: any) {\n  if (!isOpen) return null;\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm\">\n      <div className=\"bg-surface border border-border-color rounded-xl w-full max-w-3xl flex flex-col max-h-[90vh] overflow-hidden shadow-2xl\">\n        <div className=\"px-6 py-4 border-b border-border-color flex justify-between items-center bg-[#0D0D0D]/30\">\n          <h2 className=\"font-heading text-lg font-bold text-white flex items-center gap-2\">\n            <UserPlus size={20} className=\"text-primary\"/> Add New Member\n          </h2>\n          <button onClick={onClose} className=\"text-text-secondary hover:text-white transition-colors\">\n            <X size={20} />\n          </button>\n        </div>\n\n        <div className=\"p-6 overflow-y-auto no-scrollbar flex-1\">\n          <form className=\"space-y-6\">\n             <div className=\"grid grid-cols-1 md:grid-cols-12 gap-6\">\n                {/* Photo & Fingerprint */}\n                <div className=\"md:col-span-3 flex flex-col items-center gap-4\">\n                  <div className=\"w-24 h-24 rounded-full bg-[#0D0D0D] border-2 border-dashed border-border-color flex flex-col items-center justify-center text-text-secondary hover:border-primary/50 hover:text-primary transition-colors cursor-pointer\">\n                    <Camera size={24} className=\"mb-1\" />\n                    <span className=\"text-[10px] uppercase font-semibold\">Upload</span>\n                  </div>\n                  <button type=\"button\" className=\"w-full flex items-center justify-center gap-2 py-2 bg-primary/10 text-primary border border-primary/20 rounded-md text-xs font-semibold hover:bg-primary/20 transition-colors\">\n                    <Fingerprint size={16} /> Add Biometric\n                  </button>\n                  <p className=\"text-[9px] text-center text-text-secondary\">Fingerprint device integration - coming soon</p>\n                </div>\n\n                {/* Main Fields */}\n                <div className=\"md:col-span-9 grid grid-cols-1 sm:grid-cols-2 gap-4\">\n                  <div className=\"space-y-1.5\">\n                    <label className=\"text-xs font-semibold text-text-secondary uppercase\">Full Name</label>\n                    <input type=\"text\" className=\"w-full bg-[#0D0D0D] border border-border-color rounded-md px-3 py-2 text-sm text-white focus:border-primary/50 focus:outline-none\" placeholder=\"Enter full name\" />\n                  </div>\n                  <div className=\"space-y-1.5\">\n                     <label className=\"text-xs font-semibold text-text-secondary uppercase\">Phone Number</label>\n                     <input type=\"tel\" className=\"w-full bg-[#0D0D0D] border border-border-color rounded-md px-3 py-2 text-sm text-white focus:border-primary/50 focus:outline-none\" placeholder=\"Enter phone\" />\n                  </div>\n                  <div className=\"space-y-1.5\">\n                     <label className=\"text-xs font-semibold text-text-secondary uppercase\">Email (Optional)</label>\n                     <input type=\"email\" className=\"w-full bg-[#0D0D0D] border border-border-color rounded-md px-3 py-2 text-sm text-white focus:border-primary/50 focus:outline-none\" placeholder=\"Enter email\" />\n                  </div>\n                  <div className=\"grid grid-cols-2 gap-4\">\n                    <div className=\"space-y-1.5\">\n                       <label className=\"text-xs font-semibold text-text-secondary uppercase\">Date of Birth</label>\n                       <input type=\"date\" className=\"w-full bg-[#0D0D0D] border border-border-color rounded-md px-3 py-2 text-sm text-white focus:border-primary/50 focus:outline-none [color-scheme:dark]\" />\n                    </div>\n                    <div className=\"space-y-1.5\">\n                       <label className=\"text-xs font-semibold text-text-secondary uppercase\">Gender</label>\n                       <select className=\"w-full bg-[#0D0D0D] border border-border-color rounded-md px-3 py-2 text-sm text-text-secondary focus:border-primary/50 focus:outline-none\">\n                         <option>Male</option><option>Female</option><option>Other</option>\n                       </select>\n                    </div>\n                  </div>\n                </div>\n             </div>\n\n             <hr className=\"border-border-color\" />\n\n             {/* Membership Details */}\n             <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4\">\n               <div className=\"space-y-1.5\">\n                 <label className=\"text-xs font-semibold text-text-secondary uppercase\">Membership Plan</label>\n                 <select className=\"w-full bg-[#0D0D0D] border border-border-color rounded-md px-3 py-2 text-sm text-text-secondary focus:border-primary/50 focus:outline-none\">\n                   <option>Monthly - \342\202\271999</option>\n                   <option>Quarterly - \342\202\2712499</option>\n                   <option>Half-Yearly - \342\202\2714499</option>\n                   <option>Annual - \342\202\2717999</option>\n                 </select>\n               </div>\n               <div className=\"space-y-1.5\">\n                 <label className=\"text-xs font-semibold text-text-secondary uppercase\">Start Date</label>\n                 <input type=\"date\" className=\"w-full bg-[#0D0D0D] border border-border-color rounded-md px-3 py-2 text-sm text-white focus:border-primary/50 focus:outline-none [color-scheme:dark]\" />\n               </div>\n               <div className=\"space-y-1.5\">\n                 <label className=\"text-xs font-semibold text-text-secondary uppercase\">Trainer Assigned</label>\n                 <select className=\"w-full bg-[#0D0D0D] border border-border-color rounded-md px-3 py-2 text-sm text-text-secondary focus:border-primary/50 focus:outline-none\">\n                   <option>None</option>\n                   <option>Rajat Kumar (General)</option>\n                   <option>Divya Singh (Cardio)</option>\n                 </select>\n               </div>\n               <div className=\"space-y-1.5\">\n                 <label className=\"text-xs font-semibold text-text-secondary uppercase\">Payment Mode</label>\n                 <select className=\"w-full bg-[#0D0D0D] border border-border-color rounded-md px-3 py-2 text-sm text-text-secondary focus:border-primary/50 focus:outline-none\">\n                   <option>Cash</option>\n                   <option>UPI</option>\n                   <option>Card</option>\n                 </select>\n               </div>\n               <div className=\"space-y-1.5\">\n                 <label className=\"text-xs font-semibold text-text-secondary uppercase\">Amount Paid</label>\n                 <div className=\"relative\">\n                   <span className=\"absolute left-3 top-1/2 -translate-y-1/2 text-text-secondary text-sm\">\342\202\271</span>\n                   <input type=\"number\" className=\"w-full bg-[#0D0D0D] border border-border-color rounded-md pl-7 pr-3 py-2 text-sm text-white focus:border-primary/50 focus:outline-none\" placeholder=\"0\" />\n                 </div>\n               </div>\n             </div>\n          </form>\n        </div>\n\n        <div className=\"px-6 py-4 border-t border-border-color bg-[#0D0D0D]/50 flex justify-end gap-3\">\n          <button onClick={onClose} className=\"px-4 py-2 rounded-md text-sm font-semibold text-text-secondary hover:text-white hover:bg-surface transition-colors\">Cancel</button>\n          <button className=\"px-6 py-2 rounded-md text-sm font-semibold text-white bg-primary hover:bg-primary/90 transition-colors\">Save Member</button>\n        </div>\n      </div>\n    </div>\n  );\n}\n\nfunction MemberProfile({ member, onBack }: any) {\n  return (\n    <div className=\"w-full pb-8\">\n      <button onClick={onBack} className=\"flex items-center gap-2 text-text-secondary hover:text-white transition-colors text-sm mb-6 font-semibold\">\n        <ArrowLeft size={16} /> Back to Members\n      </button>\n\n      {/* Header Profile Card */}\n      <div className=\"bg-surface border border-border-color rounded-xl p-6 flex flex-col md:flex-row items-start md:items-center justify-between gap-6 mb-6\">\n        <div className=\"flex items-center gap-5\">\n           <div className=\"w-20 h-20 rounded-full bg-[#0D0D0D] border border-border-color flex items-center justify-center font-heading text-3xl font-bold text-primary shrink-0\">\n             {member.name.split(\' \').map((n: string) => n[0]).join(\'\')}\n           </div>\n           <div>\n             <h1 className=\"font-heading text-2xl font-bold text-white\">{member.name}</h1>\n             <div className=\"text-sm text-text-secondary mt-1 flex flex-wrap items-center gap-x-4 gap-y-2\">\n               <span className=\"flex items-center gap-1.5\"><Contact size={14}/> {member.phone}</span>\n               <span className=\"flex items-center gap-1.5\"><Calendar size={14}/> Joined {member.startDate}</span>\n             </div>\n             <div className=\"mt-3 flex items-center gap-2\">\n                <span className={`px-2 py-0.5 rounded-[4px] text-[11px] font-bold uppercase tracking-wider ${\n                    member.status === \'Active\' ? \'bg-green-500/10 text-green-500\' : \n                    member.status === \'Expired\' ? \'bg-red-500/10 text-primary\' : \n                    \'bg-orange-500/10 text-orange-500\'\n                  }`}>\n                    {member.status}\n                </span>\n                <span className=\"text-xs bg-[#0D0D0D] border border-border-color px-2 py-1 rounded text-white font-medium\">\n                  {member.plan} Plan\n                </span>\n             </div>\n           </div>\n        </div>\n\n        <div className=\"flex flex-wrap items-center gap-3 w-full md:w-auto\">\n          <button className=\"flex-1 md:flex-none flex items-center justify-center gap-2 bg-[#0D0D0D] hover:bg-[#1a1a1a] border border-border-color text-white px-4 py-2 rounded-md text-sm font-semibold transition-colors\">\n            <Edit size={16} /> Edit Profile\n          </button>\n          <button className=\"flex-1 md:flex-none flex items-center justify-center gap-2 bg-[#0D0D0D] hover:bg-[#1a1a1a] border border-border-color text-white px-4 py-2 rounded-md text-sm font-semibold transition-colors\">\n            <FileText size={16} /> Receipt\n          </button>\n          <button className=\"flex-1 md:flex-none flex items-center justify-center gap-2 bg-primary hover:bg-primary/90 text-white px-4 py-2 rounded-md text-sm font-semibold transition-colors\">\n            <RefreshCw size={16} /> Renew\n          </button>\n        </div>\n      </div>\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n        <div className=\"space-y-6\">\n           <div className=\"bg-surface border border-border-color rounded-xl p-5\">\n             <h3 className=\"font-heading font-semibold text-[14px] text-text-secondary uppercase tracking-tight mb-4\">Personal Details</h3>\n             <div className=\"space-y-3 text-sm\">\n               <div className=\"flex justify-between border-b border-border-color/50 pb-2\">\n                 <span className=\"text-text-secondary\">Email</span>\n                 <span className=\"text-white\">user@example.com</span>\n               </div>\n               <div className=\"flex justify-between border-b border-border-color/50 pb-2\">\n                 <span className=\"text-text-secondary\">Date of Birth</span>\n                 <span className=\"text-white\">12 Aug 1995</span>\n               </div>\n               <div className=\"flex justify-between border-b border-border-color/50 pb-2\">\n                 <span className=\"text-text-secondary\">Gender</span>\n                 <span className=\"text-white\">Male</span>\n               </div>\n               <div className=\"flex justify-between pb-2\">\n                 <span className=\"text-text-secondary\">Trainer</span>\n                 <span className=\"text-white\">None</span>\n               </div>\n             </div>\n           </div>\n        </div>\n\n        <div className=\"lg:col-span-2 space-y-6\">\n           {/* Payment History */}\n           <div className=\"bg-surface border border-border-color rounded-xl overflow-hidden\">\n             <div className=\"px-5 py-4 border-b border-border-color flex justify-between items-center bg-[#0D0D0D]/30\">\n                <h3 className=\"font-heading font-semibold text-[14px] text-text-secondary uppercase tracking-tight\">Payment History</h3>\n             </div>\n             <table className=\"w-full text-left text-sm whitespace-nowrap\">\n                <thead className=\"bg-[#0D0D0D] border-b border-border-color text-text-secondary text-[11px] uppercase tracking-wider\">\n                  <tr>\n                    <th className=\"px-5 py-3 font-medium\">Date</th>\n                    <th className=\"px-5 py-3 font-medium\">Plan</th>\n                    <th className=\"px-5 py-3 font-medium\">Amount</th>\n                    <th className=\"px-5 py-3 font-medium\">Mode</th>\n                  </tr>\n                </thead>\n                <tbody className=\"divide-y divide-border-color\">\n                  <tr className=\"hover:bg-[#0D0D0D]/50 transition-colors\">\n                    <td className=\"px-5 py-3 text-white\">{member.startDate}</td>\n                    <td className=\"px-5 py-3 text-text-secondary\">{member.plan} Plan</td>\n                    <td className=\"px-5 py-3 text-green-500\">{member.amount}</td>\n                    <td className=\"px-5 py-3 text-text-secondary\">UPI</td>\n                  </tr>\n                </tbody>\n              </table>\n           </div>\n\n           {/* Visit History */}\n           <div className=\"bg-surface border border-border-color rounded-xl overflow-hidden\">\n             <div className=\"px-5 py-4 border-b border-border-color flex justify-between items-center bg-[#0D0D0D]/30\">\n                <h3 className=\"font-heading font-semibold text-[14px] text-text-secondary uppercase tracking-tight\">Recent Visits</h3>\n             </div>\n             <div className=\"p-4 flex gap-4 overflow-x-auto no-scrollbar\">\n                {[1,2,3,4,5].map(i => (\n                  <div key={i} className=\"flex-shrink-0 w-[100px] border border-border-color rounded-lg p-3 text-center bg-[#0D0D0D]\">\n                    <div className=\"text-[10px] text-text-secondary uppercase mb-1\">May {24 - i}</div>\n                    <div className=\"font-semibold text-white\">06:45 PM</div>\n                    <div className=\"text-[10px] text-green-500 mt-1\">Checked In</div>\n                  </div>\n                ))}\n             </div>\n           </div>\n        </div>\n      </div>\n    </div>\n  );\n}"
    }
