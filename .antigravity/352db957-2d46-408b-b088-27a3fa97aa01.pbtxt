  file_change {
    absolute_path_uri: "file:///modify_page.js"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "const fs = require(\'fs\');\n\nlet pageCode = fs.readFileSync(\'app/page.tsx\', \'utf8\');\n\n// 1. Add imports\nconst importsToAdd = `\nimport { collection, getDocs, addDoc, updateDoc, deleteDoc, doc, serverTimestamp, query, orderBy, where, writeBatch, limit, getDoc } from \'firebase/firestore\';\nimport { ref, uploadBytes, getDownloadURL } from \'firebase/storage\';\nimport { db, storage } from \'../lib/firebase\';\n`;\n\nif (!pageCode.includes(\'import { db, storage }\')) {\n  pageCode = pageCode.replace(\n    \"import { motion } from \'motion/react\';\",\n    `import { motion } from \'motion/react\';\\n${importsToAdd}`\n  );\n}\n\n// 2. Exact components replacement string\nconst startIndex = pageCode.indexOf(\'function MembersView() {\');\nconst endIndex = pageCode.indexOf(\'const TODAY_VISITS = [\');\n\nif (startIndex === -1 || endIndex === -1) {\n  console.error(\"Could not find start or end index\");\n  process.exit(1);\n}\n\nconst NEW_COMPONENTS = `\nfunction MembersView() {\n  const [search, setSearch] = useState(\'\');\n  const [filter, setFilter] = useState(\'All\');\n  const [sort, setSort] = useState({ key: \'name\', direction: \'asc\' });\n  const [isAddOpen, setIsAddOpen] = useState(false);\n  const [editMemberData, setEditMemberData] = useState<any>(null);\n  const [selectedMember, setSelectedMember] = useState<any>(null);\n  const [receiptMember, setReceiptMember] = useState<any>(null);\n  \n  const [members, setMembers] = useState<any[]>([]);\n  const [isLoading, setIsLoading] = useState(false);\n  const [toastMsg, setToastMsg] = useState(\'\');\n\n  const loadMembers = async () => {\n    setIsLoading(true);\n    try {\n      const todayStr = new Date().toISOString().split(\'T\')[0];\n      \n      // Auto-update expired\n      const batch = writeBatch(db);\n      let batchCount = 0;\n      \n      const expQuery = query(collection(db, \'members\'), where(\'expiryDate\', \'<\', todayStr), where(\'status\', \'!=\', \'Expired\'));\n      const expSnap = await getDocs(expQuery);\n      expSnap.forEach(d => {\n        batch.update(d.ref, { status: \'Expired\', updatedAt: serverTimestamp() });\n        batchCount++;\n      });\n      \n      // Auto-update expiring soon (within 7 days)\n      const nextWeek = new Date();\n      nextWeek.setDate(nextWeek.getDate() + 7);\n      const nextWeekStr = nextWeek.toISOString().split(\'T\')[0];\n      \n      const soonQuery = query(collection(db, \'members\'), where(\'expiryDate\', \'>=\', todayStr), where(\'expiryDate\', \'<=\', nextWeekStr), where(\'status\', \'!=\', \'Expiring Soon\'));\n      const soonSnap = await getDocs(soonQuery);\n      soonSnap.forEach(d => {\n        batch.update(d.ref, { status: \'Expiring Soon\', updatedAt: serverTimestamp() });\n        batchCount++;\n      });\n\n      if (batchCount > 0) {\n        await batch.commit();\n      }\n\n      // Now fetch members\n      let membersQuery;\n      if (filter !== \'All\') {\n        membersQuery = query(collection(db, \'members\'), where(\'status\', \'==\', filter));\n      } else {\n        membersQuery = query(collection(db, \'members\'), orderBy(\'createdAt\', \'desc\'));\n      }\n      \n      const snapshot = await getDocs(membersQuery);\n      let fetchedMembers = snapshot.docs.map(doc => ({ id: doc.id, ...doc.data() }));\n\n      setMembers(fetchedMembers);\n    } catch (error) {\n      console.error(\"Error loading members:\", error);\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  useEffect(() => {\n    loadMembers();\n  }, [filter]);\n\n  const handleSort = (key: string) => {\n    let direction = \'asc\';\n    if (sort.key === key && sort.direction === \'asc\') direction = \'desc\';\n    setSort({ key, direction });\n  };\n\n  const handleDelete = async (m: any) => {\n    if (window.confirm(\\`Are you sure? This will delete all records for \\${m.name}.\\`)) {\n      try {\n        const batch = writeBatch(db);\n        batch.delete(doc(db, \'members\', m.id));\n        \n        const attQ = query(collection(db, \'attendance\'), where(\'memberId\', \'==\', m.id));\n        const attDocs = await getDocs(attQ);\n        attDocs.forEach(d => batch.delete(d.ref));\n        \n        const setQ = query(collection(db, \'measurements\'), where(\'memberId\', \'==\', m.id));\n        const setDocs = await getDocs(setQ);\n        setDocs.forEach(d => batch.delete(d.ref));\n        \n        await batch.commit();\n        setToastMsg(\\`Member \\${m.name} deleted successfully!\\`);\n        setTimeout(() => setToastMsg(\'\'), 3000);\n        loadMembers();\n      } catch (e) {\n        console.error(e);\n      }\n    }\n  };\n\n  if (selectedMember) {\n    return <MemberProfile memberId={selectedMember.id} onBack={() => { setSelectedMember(null); loadMembers(); }} />;\n  }\n\n  const filteredMembers = members.filter(m => {\n    if (!search) return true;\n    return (m.name || \'\').toLowerCase().includes(search.toLowerCase()) || (m.phone || \'\').includes(search);\n  }).sort((a: any, b: any) => {\n    let aVal = a[sort.key];\n    let bVal = b[sort.key];\n    if (sort.key === \'expiryDate\') {\n      aVal = new Date(aVal || 0).getTime();\n      bVal = new Date(bVal || 0).getTime();\n    }\n    if (aVal < bVal) return sort.direction === \'asc\' ? -1 : 1;\n    if (aVal > bVal) return sort.direction === \'asc\' ? 1 : -1;\n    return 0;\n  });\n\n  return (\n    <div className=\"w-full flex flex-col min-h-full pb-8\">\n      {toastMsg && (\n        <div className=\"fixed top-4 left-1/2 -translate-x-1/2 bg-green-500 text-white px-6 py-3 rounded shadow-lg z-50\">\n          {toastMsg}\n        </div>\n      )}\n      <header className=\"mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n        <h1 className=\"font-heading text-2xl font-bold text-white\">\n          Members <span className=\"text-[12px] text-text-secondary ml-2 font-normal font-sans\">(\340\244\270\340\244\246\340\244\270\340\245\215\340\244\257)</span>\n        </h1>\n        <div className=\"flex flex-wrap items-center gap-3\">\n          <div className=\"relative\">\n            <Search className=\"absolute left-3 top-1/2 -translate-y-1/2 text-text-secondary\" size={16} />\n            <input \n              type=\"text\" \n              placeholder=\"Search name or phone...\" \n              value={search}\n              onChange={e => setSearch(e.target.value)}\n              className=\"bg-surface border border-border-color rounded-md py-2 pl-9 pr-4 text-sm text-white focus:outline-none w-[200px] lg:w-[250px]\"\n            />\n          </div>\n          <select \n            value={filter} \n            onChange={e => setFilter(e.target.value)}\n            className=\"bg-surface border border-border-color rounded-md py-2 px-3 text-sm text-text-secondary focus:outline-none\"\n          >\n            <option value=\"All\">All Status</option>\n            <option value=\"active\">Active</option>\n            <option value=\"Expiring Soon\">Expiring Soon</option>\n            <option value=\"Expired\">Expired</option>\n          </select>\n          <button \n            onClick={() => { setEditMemberData(null); setIsAddOpen(true); }}\n            className=\"bg-primary hover:bg-primary/90 text-white px-4 py-2 rounded-md text-sm font-semibold flex items-center justify-center gap-2 shrink-0\"\n          >\n            <Plus size={16} /> Add Member\n          </button>\n        </div>\n      </header>\n\n      <div className=\"flex-1 bg-surface border border-border-color rounded-xl overflow-hidden flex flex-col\">\n        {isLoading ? (\n          <div className=\"p-10 flex justify-center text-text-secondary\">Loading members...</div>\n        ) : (\n          <div className=\"overflow-x-auto\">\n            <table className=\"w-full text-left text-sm whitespace-nowrap\">\n              <thead className=\"bg-[#0D0D0D]/50 border-b border-border-color text-text-secondary text-[11px] uppercase tracking-wider\">\n                <tr>\n                  <th className=\"px-5 py-4 font-medium\" onClick={() => handleSort(\'name\')}>\n                    <div className=\"flex items-center gap-1 cursor-pointer\">\n                      Member {sort.key === \'name\' && (sort.direction === \'asc\' ? <ChevronUp size={12}/> : <ChevronDown size={12}/>)}\n                    </div>\n                  </th>\n                  <th className=\"px-5 py-4 font-medium\">Contact</th>\n                  <th className=\"px-5 py-4 font-medium\">Plan</th>\n                  <th className=\"px-5 py-4 font-medium\">Joined</th>\n                  <th className=\"px-5 py-4 font-medium\" onClick={() => handleSort(\'expiryDate\')}>\n                    <div className=\"flex items-center gap-1 cursor-pointer\">\n                      Expires {sort.key === \'expiryDate\' && (sort.direction === \'asc\' ? <ChevronUp size={12}/> : <ChevronDown size={12}/>)}\n                    </div>\n                  </th>\n                  <th className=\"px-5 py-4 font-medium\">Amount</th>\n                  <th className=\"px-5 py-4 font-medium text-center\">Status</th>\n                  <th className=\"px-5 py-4 font-medium text-right\">Actions</th>\n                </tr>\n              </thead>\n              <tbody className=\"divide-y divide-border-color\">\n                {filteredMembers.map((m: any) => (\n                  <tr key={m.id} className=\"hover:bg-[#0D0D0D]/50 group\">\n                    <td className=\"px-5 py-3\">\n                      <div className=\"flex items-center gap-3\">\n                        {m.photoURL ? (\n                          <img src={m.photoURL} alt=\"photo\" className=\"w-8 h-8 rounded-full object-cover border border-border-color\" />\n                        ) : (\n                          <div className=\"w-8 h-8 rounded-full bg-[#0D0D0D] border border-border-color text-primary flex items-center justify-center font-heading font-bold text-xs uppercase\">\n                            {(m.name || \'U\').split(\' \').map((n: string) => n[0]).join(\'\').substring(0, 2)}\n                          </div>\n                        )}\n                        <span className=\"font-medium text-white\">{m.name}</span>\n                      </div>\n                    </td>\n                    <td className=\"px-5 py-3 text-text-secondary\">{m.phone}</td>\n                    <td className=\"px-5 py-3 text-text-secondary\">{m.membershipPlan || m.plan}</td>\n                    <td className=\"px-5 py-3 text-text-secondary\">{m.startDate}</td>\n                    <td className=\"px-5 py-3 text-text-secondary\">{m.expiryDate}</td>\n                    <td className=\"px-5 py-3 text-text-secondary\">\342\202\271{m.amountPaid || m.amount || \'0\'}</td>\n                    <td className=\"px-5 py-3 text-center\">\n                      <span className={\\`inline-flex items-center px-2 py-1 rounded-[4px] text-[10px] font-bold uppercase tracking-wider \\${\n                        m.status?.toLowerCase() === \'active\' ? \'bg-green-500/10 text-green-500\' :\n                        m.status === \'Expired\' ? \'bg-red-500/10 text-primary\' :\n                        \'bg-orange-500/10 text-orange-500\'\n                      }\\`}>\n                        {m.status || \'active\'}\n                      </span>\n                    </td>\n                    <td className=\"px-5 py-3 text-right\">\n                      <div className=\"flex items-center justify-end gap-2 text-text-secondary\">\n                        <button onClick={() => setSelectedMember(m)} className=\"p-1.5 hover:text-white rounded\" title=\"View Profile\"><Eye size={16} /></button>\n                        <button onClick={() => { setEditMemberData(m); setIsAddOpen(true); }} className=\"p-1.5 hover:text-white rounded\" title=\"Edit\"><Edit size={16} /></button>\n                        <button onClick={() => setReceiptMember(m)} className=\"p-1.5 hover:text-white rounded\" title=\"Generate Receipt\"><Printer size={16} /></button>\n                        <button onClick={() => handleDelete(m)} className=\"p-1.5 hover:text-primary rounded\" title=\"Delete\"><Trash2 size={16} /></button>\n                      </div>\n                    </td>\n                  </tr>\n                ))}\n                {filteredMembers.length === 0 && (\n                  <tr><td colSpan={8} className=\"px-5 py-8 text-center text-text-secondary\">No members found.</td></tr>\n                )}\n              </tbody>\n            </table>\n          </div>\n        )}\n      </div>\n\n      <AddMemberModal \n        isOpen={isAddOpen} \n        onClose={() => setIsAddOpen(false)} \n        onSuccess={(msg: string) => { setIsAddOpen(false); setToastMsg(msg); setTimeout(() => setToastMsg(\'\'), 3000); loadMembers(); }} \n        memberData={editMemberData}\n      />\n      {receiptMember && <ReceiptModal receiptMember={receiptMember} onClose={() => setReceiptMember(null)} />}\n    </div>\n  );\n}\n\nfunction ReceiptModal({ receiptMember, onClose }: any) {\n  return (\n    <div className=\"fixed inset-0 bg-black/80 z-50 flex items-center justify-center p-4 backdrop-blur-sm\">\n      <div className=\"bg-white text-black w-full max-w-md rounded-lg shadow-2xl overflow-hidden print:w-full print:max-w-none print:shadow-none print:bg-white print:m-0\">\n        <div className=\"p-6\">\n           <div className=\"text-center mb-6\">\n             <h2 className=\"font-heading font-black text-2xl uppercase text-[#0D0D0D]\">Corenix Club</h2>\n             <p className=\"text-sm text-gray-500\">123 Fitness Avenue, Body-building District, NY</p>\n             <p className=\"text-sm text-gray-500\">+1 987 654 3210 \342\200\242 contact@corenix.com</p>\n           </div>\n           \n           <div className=\"border-b-2 border-dashed border-gray-300 pb-4 mb-4\">\n             <div className=\"flex justify-between text-sm mb-1\">\n               <span className=\"font-semibold\">Receipt No:</span>\n               <span>#CRX-{receiptMember.id ? receiptMember.id.substring(receiptMember.id.length - 6) : \'8492\'}</span>\n             </div>\n             <div className=\"flex justify-between text-sm mb-1\">\n               <span className=\"font-semibold\">Date:</span>\n               <span>{new Date().toLocaleDateString(\'en-US\')}</span>\n             </div>\n           </div>\n\n           <div className=\"mb-6 space-y-2\">\n             <div className=\"flex justify-between\">\n               <span className=\"font-semibold\">Name:</span>\n               <span>{receiptMember.name}</span>\n             </div>\n             <div className=\"flex justify-between\">\n               <span className=\"font-semibold\">Phone:</span>\n               <span>+{receiptMember.phone}</span>\n             </div>\n             <div className=\"flex justify-between\">\n               <span className=\"font-semibold\">Plan Details:</span>\n               <span>{receiptMember.membershipPlan || receiptMember.plan}</span>\n             </div>\n             <div className=\"flex justify-between\">\n               <span className=\"font-semibold\">Validity:</span>\n               <span>{receiptMember.startDate} to {receiptMember.expiryDate}</span>\n             </div>\n           </div>\n\n           <div className=\"border-t-2 border-black pt-2 mb-6\">\n             <div className=\"flex justify-between items-center\">\n               <span className=\"font-bold text-lg uppercase\">Total Paid</span>\n               <span className=\"font-bold text-xl\">\342\202\271{receiptMember.amountPaid || receiptMember.amount || 0}</span>\n             </div>\n           </div>\n        </div>\n        \n        <div className=\"bg-gray-100 p-4 flex justify-end gap-3 print:hidden\">\n          <button onClick={onClose} className=\"px-4 py-2 text-sm font-bold text-gray-600\">Cancel</button>\n          <button \n            onClick={() => { window.print(); setTimeout(onClose, 1000); }} \n            className=\"px-4 py-2 text-sm bg-[#0D0D0D] text-white font-bold rounded flex items-center gap-2\">\n            <Printer size={16} /> Print\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n}\n\nfunction AddMemberModal({ isOpen, onClose, onSuccess, memberData }: any) {\n  const [formData, setFormData] = useState({\n    name: \'\', phone: \'\', email: \'\', dob: \'\', gender: \'Male\',\n    membershipPlan: \'Monthly\', startDate: \'\', paymentMode: \'Cash\',\n    amountPaid: \'\', trainerAssigned: \'None\'\n  });\n  const [photoFile, setPhotoFile] = useState<File | null>(null);\n  const [isSubmitting, setIsSubmitting] = useState(false);\n\n  useEffect(() => {\n    if (memberData) {\n      setFormData({\n        name: memberData.name || \'\',\n        phone: memberData.phone || \'\',\n        email: memberData.email || \'\',\n        dob: memberData.dob || \'\',\n        gender: memberData.gender || \'Male\',\n        membershipPlan: memberData.membershipPlan || memberData.plan || \'Monthly\',\n        startDate: memberData.startDate || \'\',\n        paymentMode: memberData.paymentMode || \'Cash\',\n        amountPaid: memberData.amountPaid || memberData.amount || \'\',\n        trainerAssigned: memberData.trainerAssigned || \'None\'\n      });\n    } else {\n      setFormData({\n        name: \'\', phone: \'\', email: \'\', dob: \'\', gender: \'Male\',\n        membershipPlan: \'Monthly\', startDate: new Date().toISOString().split(\'T\')[0], paymentMode: \'Cash\',\n        amountPaid: \'\', trainerAssigned: \'None\'\n      });\n    }\n  }, [memberData, isOpen]);\n\n  if (!isOpen) return null;\n\n  const handleSubmit = async (e: any) => {\n    e.preventDefault();\n    setIsSubmitting(true);\n    try {\n      const sDate = new Date(formData.startDate);\n      const eDate = new Date(formData.startDate);\n      if (formData.membershipPlan === \'Monthly\') eDate.setDate(sDate.getDate() + 30);\n      else if (formData.membershipPlan === \'Quarterly\') eDate.setDate(sDate.getDate() + 90);\n      else if (formData.membershipPlan === \'Half-Yearly\') eDate.setDate(sDate.getDate() + 180);\n      else eDate.setDate(sDate.getDate() + 365);\n      \n      const expiryStr = eDate.toISOString().split(\'T\')[0];\n      const todayStr = new Date().toISOString().split(\'T\')[0];\n      let status = \'active\';\n      if (todayStr > expiryStr) status = \'Expired\';\n      \n      let finalPhotoUrl = memberData?.photoURL || \'\';\n      \n      const memberId = memberData ? memberData.id : \"CNX\" + Date.now().toString().slice(-6);\n\n      if (photoFile) {\n        const storageRef = ref(storage, \\`members/\\${memberId}/photo\\`);\n        await uploadBytes(storageRef, photoFile);\n        finalPhotoUrl = await getDownloadURL(storageRef);\n      }\n\n      const mData = {\n        ...formData,\n        expiryDate: expiryStr,\n        status,\n        photoURL: finalPhotoUrl\n      };\n\n      if (memberData) {\n        await updateDoc(doc(db, \'members\', memberData.id), {\n          ...mData,\n          updatedAt: serverTimestamp()\n        });\n        onSuccess(\"Member updated successfully!\");\n      } else {\n        const docRef = await addDoc(collection(db, \'members\'), {\n          ...mData,\n          memberId,\n          createdAt: serverTimestamp()\n        });\n        \n        await addDoc(collection(db, \'payments\'), {\n          memberId: docRef.id,\n          memberName: formData.name,\n          amount: formData.amountPaid,\n          paymentMode: formData.paymentMode,\n          planName: formData.membershipPlan,\n          date: new Date().toISOString().split(\'T\')[0],\n          createdAt: serverTimestamp()\n        });\n        onSuccess(\"Member added successfully!\");\n      }\n    } catch (error) {\n      console.error(error);\n      alert(\"Error saving member\");\n    } finally {\n      setIsSubmitting(false);\n    }\n  };\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm\">\n      <div className=\"bg-surface border border-border-color rounded-xl w-full max-w-3xl flex flex-col max-h-[90vh] shadow-2xl\">\n        <div className=\"px-6 py-4 border-b border-border-color flex justify-between items-center bg-[#0D0D0D]/30\">\n          <h2 className=\"font-heading text-lg font-bold text-white\">\n            {memberData ? \'Edit Member\' : \'Add New Member\'}\n          </h2>\n          <button onClick={onClose} className=\"text-text-secondary\"><X size={20} /></button>\n        </div>\n\n        <div className=\"p-6 overflow-y-auto no-scrollbar flex-1\">\n          <form className=\"space-y-6\" id=\"memberForm\" onSubmit={handleSubmit}>\n             <div className=\"grid grid-cols-1 md:grid-cols-12 gap-6\">\n                <div className=\"md:col-span-3 flex flex-col items-center gap-4\">\n                  <label className=\"w-24 h-24 rounded-full bg-[#0D0D0D] border-2 border-dashed border-border-color flex flex-col items-center justify-center text-text-secondary hover:text-primary cursor-pointer overflow-hidden\">\n                    {photoFile ? <span className=\"text-[10px]\">Selected</span> : memberData?.photoURL ? <img src={memberData.photoURL} alt=\"p\" className=\"w-full h-full object-cover\"/> : <><Camera size={24} /><span className=\"text-[10px] uppercase font-semibold\">Upload</span></>}\n                    <input type=\"file\" className=\"hidden\" accept=\"image/*\" onChange={e => setPhotoFile(e.target.files?.[0] || null)} />\n                  </label>\n                </div>\n\n                <div className=\"md:col-span-9 grid grid-cols-1 sm:grid-cols-2 gap-4\">\n                  <div className=\"space-y-1.5\">\n                    <label className=\"text-xs text-text-secondary uppercase\">Full Name</label>\n                    <input required type=\"text\" value={formData.name} onChange={e => setFormData({...formData, name: e.target.value})} className=\"w-full bg-[#0D0D0D] border border-border-color rounded-md px-3 py-2 text-sm text-white\" />\n                  </div>\n                  <div className=\"space-y-1.5\">\n                     <label className=\"text-xs text-text-secondary uppercase\">Phone Number</label>\n                     <input required type=\"tel\" value={formData.phone} onChange={e => setFormData({...formData, phone: e.target.value})} className=\"w-full bg-[#0D0D0D] border border-border-color rounded-md px-3 py-2 text-sm text-white\" />\n                  </div>\n                  <div className=\"space-y-1.5\">\n                     <label className=\"text-xs text-text-secondary uppercase\">Email</label>\n                     <input type=\"email\" value={formData.email} onChange={e => setFormData({...formData, email: e.target.value})} className=\"w-full bg-[#0D0D0D] border border-border-color rounded-md px-3 py-2 text-sm text-white\" />\n                  </div>\n                  <div className=\"grid grid-cols-2 gap-4\">\n                    <div className=\"space-y-1.5\">\n                       <label className=\"text-xs text-text-secondary uppercase\">DOB</label>\n                       <input type=\"date\" value={formData.dob} onChange={e => setFormData({...formData, dob: e.target.value})} className=\"w-full bg-[#0D0D0D] border border-border-color rounded-md px-3 py-2 text-sm text-white [color-scheme:dark]\" />\n                    </div>\n                    <div className=\"space-y-1.5\">\n                       <label className=\"text-xs text-text-secondary uppercase\">Gender</label>\n                       <select value={formData.gender} onChange={e => setFormData({...formData, gender: e.target.value})} className=\"w-full bg-[#0D0D0D] border border-border-color rounded-md px-3 py-2 text-sm text-text-secondary\">\n                         <option>Male</option><option>Female</option><option>Other</option>\n                       </select>\n                    </div>\n                  </div>\n                </div>\n             </div>\n\n             <hr className=\"border-border-color\" />\n\n             <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4\">\n               <div className=\"space-y-1.5\">\n                 <label className=\"text-xs text-text-secondary uppercase\">Plan</label>\n                 <select required value={formData.membershipPlan} onChange={e => setFormData({...formData, membershipPlan: e.target.value})} className=\"w-full bg-[#0D0D0D] border border-border-color rounded-md px-3 py-2 text-sm text-text-secondary\">\n                   <option>Monthly - \342\202\271999</option>\n                   <option value=\"Monthly\">Monthly</option>\n                   <option value=\"Quarterly\">Quarterly</option>\n                   <option value=\"Half-Yearly\">Half-Yearly</option>\n                   <option value=\"Annual\">Annual</option>\n                 </select>\n               </div>\n               <div className=\"space-y-1.5\">\n                 <label className=\"text-xs text-text-secondary uppercase\">Start Date</label>\n                 <input required type=\"date\" value={formData.startDate} onChange={e => setFormData({...formData, startDate: e.target.value})} className=\"w-full bg-[#0D0D0D] border border-border-color rounded-md px-3 py-2 text-sm text-white [color-scheme:dark]\" />\n               </div>\n               <div className=\"space-y-1.5\">\n                 <label className=\"text-xs text-text-secondary uppercase\">Trainer Assigned</label>\n                 <select value={formData.trainerAssigned} onChange={e => setFormData({...formData, trainerAssigned: e.target.value})} className=\"w-full bg-[#0D0D0D] border border-border-color rounded-md px-3 py-2 text-sm text-text-secondary\">\n                   <option>None</option>\n                   <option>Rajat Kumar (General)</option>\n                   <option>Divya Singh (Cardio)</option>\n                 </select>\n               </div>\n               <div className=\"space-y-1.5\">\n                 <label className=\"text-xs text-text-secondary uppercase\">Payment Mode</label>\n                 <select required value={formData.paymentMode} onChange={e => setFormData({...formData, paymentMode: e.target.value})} className=\"w-full bg-[#0D0D0D] border border-border-color rounded-md px-3 py-2 text-sm text-text-secondary\">\n                   <option>Cash</option>\n                   <option>UPI</option>\n                   <option>Card</option>\n                 </select>\n               </div>\n               <div className=\"space-y-1.5\">\n                 <label className=\"text-xs text-text-secondary uppercase\">Amount Paid</label>\n                 <div className=\"relative\">\n                   <span className=\"absolute left-3 top-1/2 -translate-y-1/2 text-text-secondary text-sm\">\342\202\271</span>\n                   <input required type=\"number\" value={formData.amountPaid} onChange={e => setFormData({...formData, amountPaid: e.target.value})} className=\"w-full bg-[#0D0D0D] border border-border-color rounded-md pl-7 pr-3 py-2 text-sm text-white\" placeholder=\"0\" />\n                 </div>\n               </div>\n             </div>\n          </form>\n        </div>\n\n        <div className=\"px-6 py-4 border-t border-border-color bg-[#0D0D0D]/50 flex justify-end gap-3\">\n          <button onClick={onClose} className=\"px-4 py-2 rounded-md text-sm text-text-secondary hover:text-white\">Cancel</button>\n          <button form=\"memberForm\" type=\"submit\" disabled={isSubmitting} className=\"px-6 py-2 rounded-md text-sm text-white bg-primary disabled:opacity-50\">\n            {isSubmitting ? \'Saving...\' : \'Save Member\'}\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n}\n\nfunction MemberProfile({ memberId, onBack }: any) {\n  const [member, setMember] = useState<any>(null);\n  const [payments, setPayments] = useState<any[]>([]);\n  const [attendance, setAttendance] = useState<any[]>([]);\n  const [loading, setLoading] = useState(true);\n\n  useEffect(() => {\n    async function loadData() {\n      try {\n        const docSnap = await getDoc(doc(db, \'members\', memberId));\n        if (docSnap.exists()) {\n          setMember({ id: docSnap.id, ...docSnap.data() });\n        }\n        \n        const payQ = query(collection(db, \'payments\'), where(\'memberId\', \'==\', memberId), orderBy(\'date\', \'desc\'));\n        const payDocs = await getDocs(payQ);\n        setPayments(payDocs.docs.map(d => ({ id: d.id, ...d.data() })));\n        \n        const attQ = query(collection(db, \'attendance\'), where(\'memberId\', \'==\', memberId), orderBy(\'checkInDate\', \'desc\'), limit(20));\n        const attDocs = await getDocs(attQ);\n        setAttendance(attDocs.docs.map(d => ({ id: d.id, ...d.data() })));\n      } catch (e) {\n        console.error(e);\n      } finally {\n        setLoading(false);\n      }\n    }\n    loadData();\n  }, [memberId]);\n\n  if (loading) return <div className=\"p-10 text-white\">Loading...</div>;\n  if (!member) return <div className=\"p-10 text-red-500\">Member not found</div>;\n\n  return (\n    <div className=\"w-full pb-8\">\n      <button onClick={onBack} className=\"flex items-center gap-2 text-text-secondary hover:text-white mb-6 font-semibold text-sm\">\n        <ArrowLeft size={16} /> Back\n      </button>\n\n      <div className=\"bg-surface border border-border-color rounded-xl p-6 flex flex-col md:flex-row items-start md:items-center justify-between gap-6 mb-6\">\n        <div className=\"flex items-center gap-5\">\n           {member.photoURL ? (\n             <img src={member.photoURL} alt=\"photo\" className=\"w-20 h-20 rounded-full object-cover border border-border-color\" />\n           ) : (\n             <div className=\"w-20 h-20 rounded-full bg-[#0D0D0D] border border-border-color flex items-center justify-center font-heading text-3xl font-bold text-primary shrink-0\">\n               {member.name.split(\' \').map((n: string) => n[0]).join(\'\').substring(0, 2)}\n             </div>\n           )}\n           <div>\n             <h1 className=\"font-heading text-2xl font-bold text-white\">{member.name}</h1>\n             <div className=\"text-sm text-text-secondary flex gap-x-4\">\n               <span><Contact size={14} className=\"inline mr-1\"/> {member.phone}</span>\n               <span><Calendar size={14} className=\"inline mr-1\"/> Joined {member.startDate}</span>\n             </div>\n             <div className=\"mt-3 flex items-center gap-2\">\n                <span className={\\`px-2 py-0.5 rounded text-[11px] font-bold uppercase \\${\n                    member.status?.toLowerCase() === \'active\' ? \'bg-green-500/10 text-green-500\' : \'bg-orange-500/10 text-orange-500\'\n                  }\\`}>\n                    {member.status || \'Active\'}\n                </span>\n                <span className=\"text-xs bg-[#0D0D0D] border border-border-color px-2 py-1 rounded text-white\">{member.membershipPlan} Plan</span>\n             </div>\n           </div>\n        </div>\n      </div>\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n        <div className=\"space-y-6\">\n           <div className=\"bg-surface border border-border-color rounded-xl p-5\">\n             <h3 className=\"font-heading font-semibold text-[14px] text-text-secondary uppercase mb-4\">Personal Details</h3>\n             <div className=\"space-y-3 text-sm\">\n               <div className=\"flex justify-between border-b border-border-color/50 pb-2\"><span className=\"text-text-secondary\">Email</span><span className=\"text-white\">{member.email || \'-\'}</span></div>\n               <div className=\"flex justify-between border-b border-border-color/50 pb-2\"><span className=\"text-text-secondary\">Date of Birth</span><span className=\"text-white\">{member.dob || \'-\'}</span></div>\n               <div className=\"flex justify-between border-b border-border-color/50 pb-2\"><span className=\"text-text-secondary\">Gender</span><span className=\"text-white\">{member.gender}</span></div>\n               <div className=\"flex justify-between pb-2\"><span className=\"text-text-secondary\">Trainer</span><span className=\"text-white\">{member.trainerAssigned || \'None\'}</span></div>\n             </div>\n           </div>\n        </div>\n\n        <div className=\"lg:col-span-2 space-y-6\">\n           <div className=\"bg-surface border border-border-color rounded-xl overflow-hidden\">\n             <div className=\"px-5 py-4 border-b border-border-color bg-[#0D0D0D]/30\"><h3 className=\"font-heading font-semibold text-[14px] text-text-secondary uppercase\">Payment History</h3></div>\n             <table className=\"w-full text-left text-sm whitespace-nowrap\">\n                <thead className=\"bg-[#0D0D0D] border-b border-border-color text-text-secondary text-[11px] uppercase tracking-wider\">\n                  <tr><th className=\"px-5 py-3\">Date</th><th className=\"px-5 py-3\">Plan</th><th className=\"px-5 py-3\">Amount</th><th className=\"px-5 py-3\">Mode</th></tr>\n                </thead>\n                <tbody className=\"divide-y divide-border-color\">\n                  {payments.map(p => (\n                    <tr key={p.id} className=\"hover:bg-[#0D0D0D]/50 text-white\">\n                      <td className=\"px-5 py-3\">{p.date}</td><td className=\"px-5 py-3 text-text-secondary\">{p.planName}</td><td className=\"px-5 py-3 text-green-500\">\342\202\271{p.amount}</td><td className=\"px-5 py-3 text-text-secondary\">{p.paymentMode}</td>\n                    </tr>\n                  ))}\n                  {payments.length === 0 && <tr><td colSpan={4} className=\"p-5 text-center text-text-secondary\">No payments found.</td></tr>}\n                </tbody>\n              </table>\n           </div>\n\n           <div className=\"bg-surface border border-border-color rounded-xl overflow-hidden\">\n             <div className=\"px-5 py-4 border-b border-border-color bg-[#0D0D0D]/30\"><h3 className=\"font-heading font-semibold text-[14px] text-text-secondary uppercase\">Recent Visits</h3></div>\n             <div className=\"p-4 flex gap-4 overflow-x-auto no-scrollbar\">\n                {attendance.map(a => (\n                  <div key={a.id} className=\"flex-shrink-0 w-[100px] border border-border-color rounded-lg p-3 text-center bg-[#0D0D0D]\">\n                    <div className=\"text-[10px] text-text-secondary uppercase mb-1\">{a.checkInDate}</div>\n                    <div className=\"font-semibold text-white\">{a.checkInTime}</div>\n                  </div>\n                ))}\n                {attendance.length === 0 && <div className=\"text-text-secondary text-sm\">No check-ins found.</div>}\n             </div>\n           </div>\n        </div>\n      </div>\n    </div>\n  );\n}\n`;\n\npageCode = pageCode.slice(0, startIndex) + NEW_COMPONENTS + pageCode.slice(endIndex);\n\nfs.writeFileSync(\'app/page.tsx\', pageCode);\nconsole.log(\"Successfully updated page.tsx\");\n"
    }
    diff {
      unified_diff {
